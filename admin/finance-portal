// ── Transactions ──
let TRANSACTIONS = [];
function defaultDateRange() {
  const end = new Date();
  const start = new Date(); start.setMonth(start.getMonth() - 1);
  return { start: start.toISOString().slice(0, 10), end: end.toISOString().slice(0, 10) };
}
(function initDateFields() {
  const range = computePresetRange('last3months');
  ['tx-start-date', 'stmt-start-date', 'cf-start-date', 'dash-start-date'].forEach(function (id) { document.getElementById(id).value = range.start; });
  ['tx-end-date', 'stmt-end-date', 'cf-end-date', 'dash-end-date'].forEach(function (id) { document.getElementById(id).value = range.end; });
  const invRange = computePresetRange('alltime');
  document.getElementById('inv-start-date').value = invRange.start;
  document.getElementById('inv-end-date').value = invRange.end;
})();

// ── Dashboard ──
function computePresetRange(preset) {
  const now = new Date();
  const fmt = d => d.toISOString().slice(0, 10);
  const y = now.getFullYear(), m = now.getMonth();
  if (preset === 'alltime') return { start: '2000-01-01', end: fmt(new Date(y + 1, 11, 31)) };
  if (preset === 'thismonth') return { start: fmt(new Date(y, m, 1)), end: fmt(new Date(y, m + 1, 0)) };
  if (preset === 'lastmonth') return { start: fmt(new Date(y, m - 1, 1)), end: fmt(new Date(y, m, 0)) };
  if (preset === 'thisquarter') { const qStart = Math.floor(m / 3) * 3; return { start: fmt(new Date(y, qStart, 1)), end: fmt(new Date(y, qStart + 3, 0)) }; }
  if (preset === 'lastquarter') { const qStart = Math.floor(m / 3) * 3 - 3; return { start: fmt(new Date(y, qStart, 1)), end: fmt(new Date(y, qStart + 3, 0)) }; }
  if (preset === 'thisyear') return { start: fmt(new Date(y, 0, 1)), end: fmt(new Date(y, 11, 31)) };
  // last3months (default) and fallback
  return { start: fmt(new Date(y, m - 2, 1)), end: fmt(new Date(y, m + 1, 0)) };
}
document.getElementById('dash-range-preset').addEventListener('change', function () {
  const preset = this.value;
  const customInputs = [document.getElementById('dash-start-date'), document.getElementById('dash-end-date')];
  if (preset === 'custom') {
    customInputs.forEach(function (el) { el.style.display = 'inline-block'; });
    return; // wait for the user to actually pick dates before reloading
  }
  customInputs.forEach(function (el) { el.style.display = 'none'; });
  const range = computePresetRange(preset);
  document.getElementById('dash-start-date').value = range.start;
  document.getElementById('dash-end-date').value = range.end;
  loadDashboard();
});

// Same preset pattern as the dashboard, reused for any other date-range
// toolbar — wires the dropdown, shows/hides the raw date inputs for
// Custom, and calls onApply() with nothing (it just reads the now-updated
// start/end fields) whenever a non-custom preset is chosen.
function setupRangePreset(presetId, startId, endId, onApply) {
  document.getElementById(presetId).addEventListener('change', function () {
    const preset = this.value;
    const customInputs = [document.getElementById(startId), document.getElementById(endId)];
    if (preset === 'custom') {
      customInputs.forEach(function (el) { el.style.display = 'inline-block'; });
      return;
    }
    customInputs.forEach(function (el) { el.style.display = 'none'; });
    const range = computePresetRange(preset);
    document.getElementById(startId).value = range.start;
    document.getElementById(endId).value = range.end;
    onApply();
  });
}

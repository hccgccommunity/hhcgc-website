async function loadSocialStatus() {
  var el = document.getElementById('social-status');
  try {
    var res = await authedFetch(API_BASE + '/social/status');
    var d = await res.json();
    if (!d.tokenConfigured) {
      el.innerHTML = '<span style="color:var(--red);font-weight:700;">Not connected</span> — add a Page access token in God of God \u2192 System Settings.';
      return;
    }
    if (!d.ready) {
      // Tokens expire roughly every 60 days; say so plainly rather than
      // letting the first failed post be the discovery.
      // The reason from the server is already specific; appending a generic
      // "it may have expired" contradicted it and read as two messages.
      el.innerHTML = '<span style="color:var(--red);font-weight:700;">Token problem</span> — ' + escHtml(d.reason || 'Unknown problem with the saved token.');
      return;
    }
    el.innerHTML = '<span style="color:var(--green);font-weight:700;">Connected</span> \u00b7 ' + escHtml(d.pageName || 'Page') +
      (d.instagramConnected ? ' \u00b7 Instagram linked' : ' \u00b7 <span style="color:var(--amber,#b5750a);">no Instagram linked</span>');

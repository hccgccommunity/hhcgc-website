<script>
function loadPartial(id, url) {
  var target = document.getElementById(id);
  if (!target) return;
  fetch(url).then(function(r){return r.text();}).then(function(html){
    target.innerHTML = html;
    if (id === 'site-header') fixHeaderLinksForSubfolder(target);
  }).catch(function () {});
}
function fixHeaderLinksForSubfolder(headerEl) {
  var logo = headerEl.querySelector('.brand-logo');
  if (logo && logo.getAttribute('src') && !logo.getAttribute('src').startsWith('/') && !logo.getAttribute('src').startsWith('http')) {
    logo.setAttribute('src', '/' + logo.getAttribute('src'));
  }
  headerEl.querySelectorAll('a[href]').forEach(function (link) {
    var href = link.getAttribute('href');
    if (!href || href.startsWith('http') || href.startsWith('/') || href.startsWith('#')) return;
    link.setAttribute('href', '/' + href);
  });
}
loadPartial('site-header', '/header.html');
loadPartial('site-footer', '/footer.html');
if ('serviceWorker' in navigator) navigator.serviceWorker.register('/service-worker.js').catch(function () {});
</script>

<script>
const API_BASE = 'https://facility-rental-api-217911937447.us-central1.run.app';

let __glPendingCount = 0;
let __glShowTimer = null;
function __glRequestStart() {
  __glPendingCount++;
  if (__glPendingCount === 1) {
    __glShowTimer = setTimeout(function () {
      var el = document.getElementById('global-loading-overlay');
      if (el) el.classList.add('visible');
    }, 150);
  }
}
function __glRequestEnd() {
  __glPendingCount = Math.max(0, __glPendingCount - 1);
  if (__glPendingCount === 0) {
    clearTimeout(__glShowTimer);
    var el = document.getElementById('global-loading-overlay');
    if (el) el.classList.remove('visible');
  }
}
async function authedFetch(url, options) {
  options = options || {};
  options.headers = Object.assign({}, options.headers, { 'Authorization': 'Bearer ' + await window.__hccgcFirebaseUser.getIdToken() });
  __glRequestStart();
  try {
    return await fetch(url, options);
  } finally {
    __glRequestEnd();
  }
}
function escHtml(s) {
  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function moneyRound(n) { return '$' + Math.round(Number(n)).toLocaleString('en-US'); }

// ── Dashboard ──
async function loadCommunicationsDashboard() {
  try {
    const res = await authedFetch(API_BASE + '/communications/dashboard');
    const data = await res.json();
    if (!res.ok) throw new Error((data.errors || ['Server returned ' + res.status]).join(' '));

    document.getElementById('stat-total-patrons').textContent = data.contactCounts.totalPatrons.toLocaleString();
    document.getElementById('stat-unique-emails').textContent = data.contactCounts.uniqueEmails.toLocaleString();
    document.getElementById('stat-unique-phones').textContent = data.contactCounts.uniquePhones.toLocaleString();
    document.getElementById('stat-unique-addresses').textContent = data.contactCounts.uniqueAddresses.toLocaleString();
    document.getElementById('stat-repeat-patrons').textContent = data.repeatPatrons.toLocaleString();

    renderMomChart(data.monthOverMonth);
    renderBarChart('dash-campaign-chart', data.campaignVolume.map(function (c) { return { name: c.campaign, total: c.uniquePatrons }; }), 'No campaign activity yet.');
    renderDonorList('dash-top-value', data.topByValue, function (d) { return moneyRound(d.total); }, 'No donors yet.');
    renderDonorList('dash-top-frequency', data.topByFrequency, function (d) { return d.giftCount + ' gift' + (d.giftCount === 1 ? '' : 's'); }, 'No donors yet.');
  } catch (err) {
    document.getElementById('dash-mom-chart').innerHTML = '<div class="empty-state" style="padding:20px;">Could not load: ' + escHtml(err.message) + '</div>';
  }
}
function renderMomChart(monthOverMonth) {
  const container = document.getElementById('dash-mom-chart');
  if (!monthOverMonth.length) { container.innerHTML = '<div class="empty-state" style="padding:20px;">No donation activity in the last 7 months.</div>'; return; }
  const max = Math.max.apply(null, monthOverMonth.map(function (m) { return m.uniquePatrons; })) || 1;
  const bars = monthOverMonth.map(function (m) {
    const h = Math.max(2, (m.uniquePatrons / max) * 150);
    const label = new Date(m.month + '-02').toLocaleDateString('en-US', { month: 'short', year: '2-digit' });
    return '<div class="trend-month"><div class="trend-bars"><div class="trend-bar income-bar" style="height:' + h + 'px;width:32px;" title="' + m.uniquePatrons + ' unique donors"></div></div>' +
      '<div class="trend-month-label">' + label + '</div><div style="font-size:0.78rem;font-weight:700;color:var(--maroon);">' + m.uniquePatrons + '</div></div>';
  }).join('');
  container.innerHTML = '<div class="trend-chart">' + bars + '</div>';
}
function renderBarChart(containerId, items, emptyMessage) {
  const container = document.getElementById(containerId);
  if (!items.length) { container.innerHTML = '<div class="empty-state" style="padding:20px;">' + emptyMessage + '</div>'; return; }
  const max = Math.max.apply(null, items.map(function (i) { return i.total; })) || 1;
  container.innerHTML = items.map(function (i) {
    const pct = max > 0 ? Math.max(2, (i.total / max) * 100) : 0;
    return '<div class="bar-chart-row"><div class="bar-chart-label" title="' + escHtml(i.name) + '">' + escHtml(i.name) + '</div>' +
      '<div class="bar-chart-track"><div class="bar-chart-fill" style="width:' + pct + '%;"></div></div>' +
      '<div class="bar-chart-value">' + i.total.toLocaleString() + '</div></div>';
  }).join('');
}
function renderDonorList(containerId, items, valueFormatter, emptyMessage) {
  const container = document.getElementById(containerId);
  if (!items.length) { container.innerHTML = '<div class="empty-state" style="padding:14px;">' + emptyMessage + '</div>'; return; }
  container.innerHTML = items.map(function (item, i) {
    return '<div class="contributor-row"><span class="rank">' + (i + 1) + '</span>' +
      '<span class="name">' + escHtml(item.name) + '</span>' +
      '<span class="meta">' + valueFormatter(item) + '</span></div>';
  }).join('');
}

// ── Mass Email ──
let EMAIL_TEMPLATES_CACHE = [];
let selectedTemplateId = null;
let recipientPreview = [];

async function loadEmailTemplates() {
  const res = await authedFetch(API_BASE + '/communications/templates');
  EMAIL_TEMPLATES_CACHE = await res.json();
  document.getElementById('template-grid').innerHTML = EMAIL_TEMPLATES_CACHE.map(function (t) {
    return '<div class="template-card" data-template-id="' + t.id + '"><h3>' + escHtml(t.name) + '</h3><p>' + escHtml(t.description) + '</p></div>';
  }).join('');
  document.querySelectorAll('.template-card').forEach(function (card) {
    card.addEventListener('click', function () { selectTemplate(card.dataset.templateId); });
  });
}
const FIELD_LABELS = {
  headline: 'Headline', bodyText: 'Message', imageUrl: 'Image URL', ctaText: 'Button text',
  ctaUrl: 'Button link', eventDetails: 'Date / location line'
};
const FIELD_TYPES = { bodyText: 'textarea' };
function selectTemplate(id) {
  selectedTemplateId = id;
  document.querySelectorAll('.template-card').forEach(function (c) { c.classList.toggle('selected', c.dataset.templateId === id); });
  const template = EMAIL_TEMPLATES_CACHE.find(function (t) { return t.id === id; });
  document.getElementById('email-content-card').style.display = 'block';
  document.getElementById('email-recipients-card').style.display = 'block';
  document.getElementById('email-send-card').style.display = 'block';
  document.getElementById('email-dynamic-fields').innerHTML = template.fields.map(function (f) {
    const type = FIELD_TYPES[f] || 'text';
    return '<div class="field"><label>' + (FIELD_LABELS[f] || f) + '</label>' +
      (type === 'textarea' ? '<textarea data-field="' + f + '"></textarea>' : '<input type="text" data-field="' + f + '">') +
      '</div>';
  }).join('');
  document.querySelectorAll('#email-dynamic-fields [data-field]').forEach(function (el) {
    el.addEventListener('input', updateEmailPreview);
  });
  updateEmailPreview();
}
function updateEmailPreview() {
  if (!selectedTemplateId) return;
  const template = EMAIL_TEMPLATES_CACHE.find(function (t) { return t.id === selectedTemplateId; });
  const data = { subject: document.getElementById('em-subject').value };
  document.querySelectorAll('#email-dynamic-fields [data-field]').forEach(function (el) { data[el.dataset.field] = el.value; });
  // Client-side preview mirrors the server's render() logic closely enough
  // for a visual check — the actual sent HTML is always built server-side
  // at send time, this is preview only.
  const esc = function (s) { return escHtml(s || ''); };
  let html = '<div style="font-family:Arial,Helvetica,sans-serif;">';
  if (data.imageUrl) html += '<img src="' + esc(data.imageUrl) + '" style="width:100%;border-radius:12px;" alt="">';
  html += '<h1 style="color:#7f2e16;font-size:22px;margin-top:12px;">' + esc(data.headline || data.subject) + '</h1>';
  if (data.eventDetails) html += '<p style="font-size:14px;color:#8d3e0d;font-weight:bold;">' + esc(data.eventDetails) + '</p>';
  html += '<p style="font-size:15px;line-height:1.6;color:#2c1b10;white-space:pre-wrap;">' + esc(data.bodyText) + '</p>';
  if (data.ctaUrl) html += '<p><a href="#" style="display:inline-block;background:#b55a18;color:#fff;padding:10px 20px;border-radius:8px;text-decoration:none;">' + esc(data.ctaText || 'Learn more') + '</a></p>';
  html += '<p style="font-size:11px;color:#999;margin-top:24px;">You are receiving this because you have supported or attended an HCCGC program. <a href="#">Unsubscribe</a>.</p></div>';
  document.getElementById('email-preview').innerHTML = html;
}
document.getElementById('em-subject').addEventListener('input', updateEmailPreview);

async function refreshRecipientPreview() {
  const search = document.getElementById('em-patron-search').value;
  const res = await authedFetch(API_BASE + '/communications/patrons?search=' + encodeURIComponent(search));
  const patrons = await res.json();
  recipientPreview = patrons.filter(function (p) { return !p.unsubscribed; });
  const excluded = patrons.length - recipientPreview.length;
  document.getElementById('em-recipient-summary').textContent = recipientPreview.length + ' will receive this' +
    (excluded ? ' (' + excluded + ' excluded — unsubscribed)' : '');
}
document.getElementById('em-patron-search').addEventListener('input', debounce(refreshRecipientPreview, 300));
function debounce(fn, ms) { let t; return function () { clearTimeout(t); const args = arguments; t = setTimeout(function () { fn.apply(null, args); }, ms); }; }

document.getElementById('btn-send-campaign').addEventListener('click', async function () {
  const subject = document.getElementById('em-subject').value.trim();
  if (!selectedTemplateId) { alert('Choose a template first.'); return; }
  if (!subject) { alert('Enter a subject line.'); return; }
  if (!recipientPreview.length) { alert('No eligible recipients match — check your search filter.'); return; }
  if (!confirm('Send this to ' + recipientPreview.length + ' patron' + (recipientPreview.length === 1 ? '' : 's') + '? This cannot be undone.')) return;

  const btn = this;
  btn.disabled = true;
  const resultEl = document.getElementById('em-send-result');
  resultEl.textContent = '';
  try {
    const startRes = await authedFetch(API_BASE + '/communications/start-campaign', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ templateId: selectedTemplateId, subject: subject, patronIds: recipientPreview.map(function (p) { return p.patronId; }) })
    });
    const startData = await startRes.json();
    if (!startRes.ok) throw new Error((startData.errors || ['Could not start campaign']).join(' '));

    const progressWrap = document.getElementById('em-send-progress');
    const fill = document.getElementById('em-progress-fill');
    const label = document.getElementById('em-progress-label');
    progressWrap.style.display = 'block';
    const total = startData.recipientCount;
    let sentSoFar = 0, failedSoFar = 0, remaining = total;
    while (remaining > 0) {
      const batchRes = await authedFetch(API_BASE + '/communications/send-campaign-batch?campaignId=' + startData.campaignId + '&limit=20', { method: 'POST' });
      const batchData = await batchRes.json();
      if (!batchRes.ok) throw new Error((batchData.errors || ['Send batch failed']).join(' '));
      sentSoFar += batchData.sent;
      failedSoFar += batchData.failed;
      remaining = batchData.remaining;
      const pct = Math.round(((total - remaining) / total) * 100);
      fill.style.width = pct + '%';
      label.textContent = (total - remaining) + ' of ' + total + ' processed' + (failedSoFar ? ' (' + failedSoFar + ' failed)' : '');
    }
    resultEl.innerHTML = '<div style="color:var(--green);font-weight:700;">Done — ' + sentSoFar + ' sent' + (failedSoFar ? ', ' + failedSoFar + ' failed' : '') + '.</div>';
  } catch (err) {
    resultEl.innerHTML = '<div style="color:var(--red);font-weight:700;">' + escHtml(err.message) + '</div>';
  } finally {
    btn.disabled = false;
  }
});


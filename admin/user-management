<script>
var APP_REGISTRY = [
  { key: 'website-management', name: 'Website Management' },
  { key: 'marketing-assistant', name: 'Hey HCCGC' },
  { key: 'bookings-finance', name: 'Facility Booking' },
  { key: 'org-finance', name: 'Finance' },
  { key: 'org-communications', name: 'Communications' },
  { key: 'issue-reporting', name: 'Issue Reporting' },
  { key: 'logs-app', name: 'Logs' }
];

var allUsers = [];
var currentUserEmail = null;

const API_BASE = 'https://facility-rental-api-217911937447.us-central1.run.app';
async function authedFetch(url, options) {
  options = options || {};
  var user = window.__hccgcUM.auth.currentUser;
  if (!user) throw new Error('Not signed in.');
  var token = await user.getIdToken();
  options.headers = Object.assign({}, options.headers, { 'Authorization': 'Bearer ' + token });
  return fetch(url, options);
}

window.addEventListener('hccgc-um-ready', function (e) {
  currentUserEmail = e.detail.currentUserEmail;
  loadUsers();
  loadSettings();
});

async function loadSettings() {
  try {
    var res = await authedFetch(API_BASE + '/admin/settings');
    var settings = await res.json();
    var byKey = {};
    settings.forEach(function (s) { byKey[s.key] = s.value; });
    document.getElementById('setting-test-mode').checked = byKey.test_mode === 'true';
    document.getElementById('setting-test-email').value = byKey.test_mode_email || '';
    try { savedUserTestModeEmails = JSON.parse(byKey.user_test_mode_emails || '[]'); } catch (e) { savedUserTestModeEmails = []; }
    // Seeded default, same as the backend - active immediately even
    // before anyone explicitly saves this setting once.
    var defaultPublicTestEmails = '["tonilaj@gmail.com","nilajr@yahoo.com","nilaj.rukadikar@gmail.com"]';
    try { publicTestEmails = JSON.parse(byKey.public_test_emails || defaultPublicTestEmails); } catch (e) { publicTestEmails = []; }
    if (!Array.isArray(publicTestEmails)) publicTestEmails = [];
    renderPublicTestEmailsList();
    settingsLoaded = true;
    renderUserTestModeList();
  } catch (err) {
    document.getElementById('settings-save-result').textContent = 'Could not load settings: ' + err.message;
  }
}
var publicTestEmails = [];
function renderPublicTestEmailsList() {
  var container = document.getElementById('public-test-emails-list');
  if (!publicTestEmails.length) { container.innerHTML = '<div class="field-hint">None yet.</div>'; return; }
  container.innerHTML = publicTestEmails.map(function (email, idx) {
    return '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:4px 0;">' +
      '<span>' + email.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</span>' +
      '<button type="button" class="btn-small" data-remove-test-email-idx="' + idx + '">Remove</button>' +
    '</div>';
  }).join('');
}
document.getElementById('public-test-emails-list').addEventListener('click', function (e) {
  var btn = e.target.closest('[data-remove-test-email-idx]');
  if (!btn) return;
  publicTestEmails.splice(Number(btn.dataset.removeTestEmailIdx), 1);
  renderPublicTestEmailsList();
});
document.getElementById('btn-add-public-test-email').addEventListener('click', function () {
  var input = document.getElementById('public-test-email-input');
  var email = input.value.trim().toLowerCase();
  if (!email) return;
  if (publicTestEmails.map(function (e) { return e.toLowerCase(); }).indexOf(email) !== -1) { input.value = ''; return; }
  publicTestEmails.push(email);
  input.value = '';
  renderPublicTestEmailsList();
});
// Needs both the full user roster (from loadUsers) and the saved setting
// (from loadSettings) before it can render - both load independently and
// in no guaranteed order, so each one calls this and it's a no-op until
// both have actually completed.
var savedUserTestModeEmails = [];
var settingsLoaded = false;
function renderUserTestModeList() {
  var container = document.getElementById('user-test-mode-list');
  if (!settingsLoaded || !allUsers || !allUsers.length) return;
  var savedLower = savedUserTestModeEmails.map(function (e) { return String(e).toLowerCase(); });
  var sorted = allUsers.slice().sort(function (a, b) { return (a.email || '').localeCompare(b.email || ''); });
  container.innerHTML = sorted.map(function (u) {
    var checked = savedLower.indexOf((u.email || '').toLowerCase()) !== -1 ? 'checked' : '';
    var id = 'utm-' + btoa(unescape(encodeURIComponent(u.email || ''))).replace(/[^a-zA-Z0-9]/g, '');
    return '<div style="display:flex;align-items:center;gap:8px;padding:4px 0;">' +
      '<input type="checkbox" id="' + id + '" data-user-email="' + (u.email || '').replace(/"/g, '&quot;') + '" ' + checked + '>' +
      '<label for="' + id + '">' + (u.name || u.email || '') + (u.name ? ' <span class="field-hint" style="margin:0;">(' + u.email + ')</span>' : '') + '</label>' +
    '</div>';
  }).join('') || '<div class="field-hint">No users yet.</div>';
}
document.getElementById('btn-save-settings').addEventListener('click', async function () {
  var btn = this;
  var resultEl = document.getElementById('settings-save-result');
  btn.disabled = true; btn.textContent = 'Saving…';
  var checkedEmails = Array.prototype.slice.call(document.querySelectorAll('#user-test-mode-list input[type="checkbox"]:checked'))
    .map(function (cb) { return cb.dataset.userEmail; });
  var toSave = [
    { key: 'test_mode', value: document.getElementById('setting-test-mode').checked ? 'true' : 'false' },
    { key: 'test_mode_email', value: document.getElementById('setting-test-email').value },
    { key: 'user_test_mode_emails', value: JSON.stringify(checkedEmails) },
    { key: 'public_test_emails', value: JSON.stringify(publicTestEmails) }
  ];
  try {
    for (var i = 0; i < toSave.length; i++) {
      var res = await authedFetch(API_BASE + '/admin/settings', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(toSave[i])
      });
      if (!res.ok) { var data = await res.json().catch(function () { return {}; }); throw new Error((data.errors || [data.error]).join(' ') || 'unknown error'); }
    }
    savedUserTestModeEmails = checkedEmails;
    resultEl.style.color = 'var(--green)';
    resultEl.textContent = 'Saved.';
  } catch (err) {
    resultEl.style.color = 'var(--red)';
    resultEl.textContent = 'Could not save: ' + err.message;
  } finally {
    btn.disabled = false; btn.textContent = 'Save settings';
  }
});

function showStatus(message, type) {
  var bar = document.getElementById('status-bar');
  bar.textContent = message;
  bar.className = 'status-bar show ' + type;
  if (type !== 'error') {
    setTimeout(function () { bar.classList.remove('show'); }, 3500);
  }
}

function escHtml(str) {
  return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function loadUsers() {
  var fb = window.__hccgcUM;
  fb.getDocs(fb.collection(fb.db, fb.USERS_COLLECTION))
    .then(function (snapshot) {
      allUsers = [];
      snapshot.forEach(function (docSnap) {
        var data = docSnap.data();
        data.id = docSnap.id;
        allUsers.push(data);
      });
      renderUsers();
      renderUserTestModeList();
    })
    .catch(function (err) {
      console.error(err);
      document.getElementById('user-table').innerHTML = '<div class="empty-state">Could not load users.</div>';
    });
}

function renderUsers() {
  var container = document.getElementById('user-table');

  if (allUsers.length === 0) {
    container.innerHTML = '<div class="empty-state">No users yet.</div>';
    return;
  }

  var sorted = allUsers.slice().sort(function (a, b) {
    return (a.email || '').localeCompare(b.email || '');
  });

  var html = '';
  sorted.forEach(function (u) {
    var allowedApps = Array.isArray(u.allowedApps) ? u.allowedApps : [];
    var initials = (u.name || u.email || '?').charAt(0).toUpperCase();

    var checkboxes = APP_REGISTRY.map(function (app) {
      var checked = allowedApps.indexOf(app.key) !== -1 ? 'checked' : '';
      return (
        '<label class="app-check">' +
          '<input type="checkbox" data-user-id="' + escHtml(u.id) + '" data-app-key="' + escHtml(app.key) + '" ' + checked + '>' +
          escHtml(app.name) +
        '</label>'
      );
    }).join('');

    html +=
      '<div class="user-row">' +
        '<div class="user-avatar-sm">' + initials + '</div>' +
        '<div class="user-info">' +
          '<div class="name">' + escHtml(u.name || u.email) + (u.isAdmin ? '<span class="admin-pill">Admin</span>' : '') + '</div>' +
          '<div class="email">' + escHtml(u.email) + '</div>' +
        '</div>' +
        '<div class="app-checkboxes">' + checkboxes + '</div>' +
        '<div class="row-actions">' +
          '<label class="admin-toggle">' +
            '<input type="checkbox" class="admin-checkbox" data-user-id="' + escHtml(u.id) + '" ' + (u.isAdmin ? 'checked' : '') + (u.id === currentUserEmail ? ' disabled title="You cannot remove your own admin access"' : '') + '>' +
            'Admin' +
          '</label>' +
          '<button class="btn-icon danger btn-remove-user" data-user-id="' + escHtml(u.id) + '"' + (u.id === currentUserEmail ? ' disabled title="You cannot remove yourself"' : '') + '>Remove</button>' +
        '</div>' +
      '</div>';
  });

  container.innerHTML = html;
}

document.getElementById('user-table').addEventListener('change', function (evt) {
  if (evt.target.matches('input[data-app-key]')) {
    var userId = evt.target.getAttribute('data-user-id');
    var appKey = evt.target.getAttribute('data-app-key');
    toggleAppAccess(userId, appKey, evt.target.checked);
  } else if (evt.target.matches('.admin-checkbox')) {
    var userId = evt.target.getAttribute('data-user-id');
    toggleAdmin(userId, evt.target.checked);
  }
});

document.getElementById('user-table').addEventListener('click', function (evt) {
  var btn = evt.target.closest('.btn-remove-user');
  if (btn && !btn.disabled) {
    removeUser(btn.getAttribute('data-user-id'));
  }
});

function toggleAppAccess(userId, appKey, granted) {
  var fb = window.__hccgcUM;
  var user = allUsers.find(function (u) { return u.id === userId; });
  if (!user) return;

  var allowedApps = Array.isArray(user.allowedApps) ? user.allowedApps.slice() : [];
  if (granted && allowedApps.indexOf(appKey) === -1) {
    allowedApps.push(appKey);
  } else if (!granted) {
    allowedApps = allowedApps.filter(function (k) { return k !== appKey; });
  }

  fb.setDoc(fb.doc(fb.db, fb.USERS_COLLECTION, userId), { allowedApps: allowedApps }, { merge: true })
    .then(function () {
      user.allowedApps = allowedApps;
      showStatus('Access updated for ' + user.email + '.', 'success');
    })
    .catch(function (err) {
      console.error(err);
      showStatus('Error updating access: ' + (err.message || 'unknown error'), 'error');
      renderUsers();
    });
}

function toggleAdmin(userId, isAdmin) {
  var fb = window.__hccgcUM;
  var user = allUsers.find(function (u) { return u.id === userId; });
  if (!user) return;

  fb.setDoc(fb.doc(fb.db, fb.USERS_COLLECTION, userId), { isAdmin: isAdmin }, { merge: true })
    .then(function () {
      user.isAdmin = isAdmin;
      showStatus((isAdmin ? 'Granted' : 'Removed') + ' admin access for ' + user.email + '.', 'success');
      renderUsers();
    })
    .catch(function (err) {
      console.error(err);
      showStatus('Error updating admin status: ' + (err.message || 'unknown error'), 'error');
      renderUsers();
    });
}

function removeUser(userId) {
  if (!confirm('Remove ' + userId + ' from the portal? They will lose all app access.')) return;

  var fb = window.__hccgcUM;
  fb.deleteDoc(fb.doc(fb.db, fb.USERS_COLLECTION, userId))
    .then(function () {
      showStatus('User removed.', 'success');
      loadUsers();
    })
    .catch(function (err) {
      console.error(err);
      showStatus('Error removing user: ' + (err.message || 'unknown error'), 'error');
    });
}


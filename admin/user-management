});
document.getElementById('btn-delete-selected-bookings').addEventListener('click', async function () {
  if (!drSelectedRenterId) return;
  var checkedBoxes = Array.from(document.querySelectorAll('.dr-booking-checkbox:checked'));
  var bookingIds = checkedBoxes.map(function (cb) { return cb.value; });
  var confirmName = document.getElementById('dr-confirm-name').value.trim();
  var resultEl = document.getElementById('dr-delete-result');
  if (!bookingIds.length) { resultEl.style.color = 'var(--red, #b3382c)'; resultEl.textContent = 'Check at least one booking to delete.'; return; }
  if (!confirmName) { resultEl.style.color = 'var(--red, #b3382c)'; resultEl.textContent = 'Type the renter\'s name to confirm first.'; return; }
  if (!confirm('This is permanent and cannot be undone. Delete ' + bookingIds.length + ' selected booking(s) now? The renter record itself will stay.')) return;
  var btn = this;
  btn.disabled = true; btn.textContent = 'Deleting…';
  try {
    var res = await authedFetch(API_BASE + '/renters/' + encodeURIComponent(drSelectedRenterId) + '/delete-bookings', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ bookingIds: bookingIds, confirmName: confirmName })
    });
    var data = await res.json();
    if (!res.ok) {
      resultEl.style.color = 'var(--red, #b3382c)';
      resultEl.textContent = (data.errors || [data.error]).join(' ') || 'Could not delete.';
      return;
    }
    resultEl.style.color = 'var(--green, #2e7d4f)';
    resultEl.textContent = 'Deleted ' + data.bookingsDeleted + ' booking(s) — the renter record was kept.';
    document.getElementById('dr-renter-select').dispatchEvent(new Event('change'));
  } catch (err) {
    resultEl.style.color = 'var(--red, #b3382c)';
    resultEl.textContent = 'Could not reach the server: ' + err.message;
  } finally {
    btn.disabled = false; btn.textContent = 'Delete selected booking(s) only';
  }
});

// ── Delete Internal Event ──
async function loadInternalEventsForDelete() {
  var select = document.getElementById('di-event-select');
  try {
    var res = await authedFetch(API_BASE + '/bookings/internal-list');
    var events = await res.json();
    select.innerHTML = '<option value="">Select an internal event&hellip;</option>' + events.map(function (e) {
      return '<option value="' + e.key + '">' + (e.eventName || 'Untitled event') + ' — ' + e.eventDate + (e.isSeries ? ' (recurring series)' : '') + '</option>';
    }).join('');
  } catch (err) {
    select.innerHTML = '<option value="">Could not load internal events</option>';
  }
}
var diSelectedKey = null;
document.getElementById('di-event-select').addEventListener('change', async function () {
  var key = this.value;
  var preview = document.getElementById('di-preview');
  diSelectedKey = null;
  document.getElementById('di-delete-result').textContent = '';
  document.getElementById('di-confirm-name').value = '';
  if (!key) { preview.style.display = 'none'; return; }
  try {
    var res = await authedFetch(API_BASE + '/bookings/internal-delete-preview?key=' + encodeURIComponent(key));
    var data = await res.json();
    if (!res.ok) {
      preview.style.display = 'block';
      document.getElementById('di-preview-summary').textContent = (data.errors || [data.error]).join(' ') || 'Could not load this event.';
      document.getElementById('di-bookings-list').innerHTML = '';
      return;
    }
    diSelectedKey = key;
    document.getElementById('di-confirm-target').textContent = data.eventName;
    document.getElementById('di-preview-summary').textContent = 'This will permanently delete ' + data.eventName + ' — ' + data.bookingCount + ' occurrence' + (data.bookingCount === 1 ? '' : 's') + '.';
    document.getElementById('di-bookings-list').innerHTML = data.bookings.map(function (b) {
      return '<div style="padding:4px 0;border-bottom:1px solid var(--border);">' + (b.eventDate || '') + ' <span style="color:var(--muted);">(' + b.paymentStatus + ')</span></div>';
    }).join('');
    preview.style.display = 'block';
  } catch (err) {
    preview.style.display = 'block';
    document.getElementById('di-preview-summary').textContent = 'Could not reach the server: ' + err.message;
  }
});
document.getElementById('btn-delete-internal').addEventListener('click', async function () {
  if (!diSelectedKey) return;
  var confirmName = document.getElementById('di-confirm-name').value.trim();
  var resultEl = document.getElementById('di-delete-result');
  if (!confirmName) { resultEl.style.color = 'var(--red, #b3382c)'; resultEl.textContent = 'Type the event\'s name to confirm first.'; return; }
  if (!confirm('This is permanent and cannot be undone. Delete this internal event and all its occurrences now?')) return;
  var btn = this;
  btn.disabled = true; btn.textContent = 'Deleting…';
  try {
    var res = await authedFetch(API_BASE + '/bookings/internal-delete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ key: diSelectedKey, confirmName: confirmName })
    });
    var data = await res.json();
    if (!res.ok) {
      resultEl.style.color = 'var(--red, #b3382c)';
      resultEl.textContent = (data.errors || [data.error]).join(' ') || 'Could not delete.';
      return;
    }
    resultEl.style.color = 'var(--green, #2e7d4f)';
    resultEl.textContent = 'Deleted — ' + data.bookingsDeleted + ' occurrence(s) removed.';
    document.getElementById('di-preview').style.display = 'none';
    document.getElementById('di-event-select').value = '';
    loadInternalEventsForDelete();
  } catch (err) {
    resultEl.style.color = 'var(--red, #b3382c)';
    resultEl.textContent = 'Could not reach the server: ' + err.message;
  } finally {
    btn.disabled = false; btn.textContent = 'Permanently delete this internal event';
  }
});

// ── Delete All Data ──
async function loadDeleteAllCounts() {
  var el = document.getElementById('da-counts');
  try {
    var res = await authedFetch(API_BASE + '/admin/delete-all-preview');
    var data = await res.json();
    if (!res.ok) { el.textContent = (data.errors || [data.error]).join(' ') || 'Could not load counts.'; return; }
    el.innerHTML = 'Currently in the system: <strong>' + data.renterCount + ' renter(s)</strong>, <strong>' + data.bookingCount + ' booking(s)</strong>.';
  } catch (err) {
    el.textContent = 'Could not reach the server: ' + err.message;
  }
}
document.getElementById('btn-delete-all-data').addEventListener('click', async function () {
  var phrase = document.getElementById('da-confirm-phrase').value.trim();
  var resultEl = document.getElementById('da-result');
  if (phrase !== 'DELETE ALL DATA') {
    resultEl.style.color = 'var(--red, #b3382c)';
    resultEl.textContent = 'Type the exact phrase "DELETE ALL DATA" to confirm.';
    return;
  }
  if (!confirm('This deletes every renter and every booking in the entire system, permanently, with no way back. Are you completely sure?')) return;
  if (!confirm('Really sure? This cannot be undone.')) return;
  var btn = this;
  btn.disabled = true; btn.textContent = 'Deleting everything…';
  try {
    var res = await authedFetch(API_BASE + '/admin/delete-all-data', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ confirmPhrase: phrase })
    });
    var data = await res.json();
    if (!res.ok) {
      resultEl.style.color = 'var(--red, #b3382c)';
      resultEl.textContent = (data.errors || [data.error]).join(' ') || 'Could not delete.';
      return;
    }
    resultEl.style.color = 'var(--green, #2e7d4f)';
    resultEl.textContent = 'Deleted ' + data.rentersDeleted + ' renter(s) and ' + data.bookingsDeleted + ' booking(s).';
    document.getElementById('da-confirm-phrase').value = '';
    loadDeleteAllCounts();
  } catch (err) {
    resultEl.style.color = 'var(--red, #b3382c)';
    resultEl.textContent = 'Could not reach the server: ' + err.message;
  } finally {
    btn.disabled = false; btn.textContent = 'Permanently delete all renters & bookings';
  }
});

// ── Picktime Import ──
var piParsedRows = [];
document.getElementById('btn-parse-picktime').addEventListener('click', async function () {
  var fileInput = document.getElementById('pi-file-input');
  var resultEl = document.getElementById('pi-parse-result');
  var preview = document.getElementById('pi-preview');
  preview.style.display = 'none';
  if (!fileInput.files || !fileInput.files[0]) {
    resultEl.style.color = 'var(--red, #b3382c)';
    resultEl.textContent = 'Choose a CSV file first.';
    return;
  }
  var btn = this;
  btn.disabled = true; btn.textContent = 'Parsing…';
  resultEl.style.color = ''; resultEl.textContent = '';
  try {
    var text = await fileInput.files[0].text();
    var res = await authedFetch(API_BASE + '/admin/parse-picktime-csv', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ csvText: text })
    });
    var data = await res.json();
    if (!res.ok) {
      resultEl.style.color = 'var(--red, #b3382c)';
      resultEl.textContent = (data.errors || [data.error]).join(' ') || 'Could not parse this file.';
      return;
    }
    piParsedRows = data.preview;
    document.getElementById('pi-preview-summary').textContent =
      data.parsedCount + ' of ' + data.totalRows + ' rows parsed \u2014 ' + data.duplicateCount + ' already imported, ' + data.newRenterCount + ' new renter(s) would be created.';
    document.getElementById('pi-warnings').innerHTML = data.warnings.length
      ? '<div style="color:var(--red, #b3382c);font-size:0.82rem;">' + data.warnings.map(function (w) { return escHtml(w); }).join('<br>') + '</div>'
      : '';
    document.getElementById('pi-rows-table').innerHTML = piParsedRows.map(function (r) {
      return '<div style="padding:4px 0;border-bottom:1px solid var(--border);' + (r.isDuplicate ? 'color:var(--muted);' : '') + '">' +
        escHtml(r.customerName) + ' \u2014 ' + escHtml(r.date) + (r.room ? ' \u2014 ' + escHtml(r.room) : '') +
        (r.amount ? ' \u2014 ' + escHtml(r.amount) : '') +
        (r.isDuplicate ? ' <span style="color:var(--red, #b3382c);">(already imported)</span>' : '') +
        (r.isNewRenter ? ' <span style="color:var(--saffron-dark);">(new renter)</span>' : '') +
        '</div>';
    }).join('') || '<div style="color:var(--muted);">No rows parsed.</div>';
    preview.style.display = 'block';
  } catch (err) {
    resultEl.style.color = 'var(--red, #b3382c)';
    resultEl.textContent = 'Could not reach the server: ' + err.message;
  } finally {
    btn.disabled = false; btn.textContent = 'Parse & preview';
  }
});
document.getElementById('btn-commit-picktime').addEventListener('click', async function () {
  var resultEl = document.getElementById('pi-commit-result');
  var skipDuplicates = document.getElementById('pi-skip-duplicates').checked;
  if (!piParsedRows.length) return;
  if (!confirm('Import ' + piParsedRows.length + ' row(s) now' + (skipDuplicates ? ' (already-imported rows will be skipped)' : ' (including anything marked already imported \u2014 this can create duplicates)') + '?')) return;
  var btn = this;
  btn.disabled = true; btn.textContent = 'Importing…';
  try {
    var res = await authedFetch(API_BASE + '/admin/commit-picktime-import', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ rows: piParsedRows, skipDuplicates: skipDuplicates })
    });
    var data = await res.json();
    if (!res.ok) {
      resultEl.style.color = 'var(--red, #b3382c)';
      resultEl.textContent = (data.errors || [data.error]).join(' ') || 'Could not import.';
      return;
    }
    resultEl.style.color = 'var(--green, #2e7d4f)';
    resultEl.textContent = 'Imported ' + data.bookingsInserted + ' booking(s), created ' + data.rentersCreated + ' new renter(s)' + (data.bookingsSkipped ? ', skipped ' + data.bookingsSkipped + ' already-imported row(s)' : '') + '.';
    document.getElementById('pi-preview').style.display = 'none';
    document.getElementById('pi-file-input').value = '';
    piParsedRows = [];
    loadDeleteAllCounts();
  } catch (err) {
    resultEl.style.color = 'var(--red, #b3382c)';
    resultEl.textContent = 'Could not reach the server: ' + err.message;
  } finally {
    btn.disabled = false; btn.textContent = 'Import these bookings';
  }
});
// ── Test Payments ──
async function loadTestPayments() {
  var listEl = document.getElementById('tp-list');
  listEl.innerHTML = '<div class="field-hint">Loading&hellip;</div>';
  try {
    var res = await authedFetch(API_BASE + '/admin/test-payments');
    var data = await res.json();
    if (!res.ok) { listEl.innerHTML = '<div class="field-hint">' + ((data.errors || [data.error]).join(' ') || 'Could not load.') + '</div>'; return; }
    if (!data.length) { listEl.innerHTML = '<div class="field-hint" style="color:var(--muted);">No test payments yet.</div>'; return; }
    listEl.innerHTML = data.map(function (p) {
      var actions = p.key
        ? '<button type="button" class="tp-edit-btn" data-key="' + p.key + '" data-date="' + p.date + '" data-amount="' + p.amount + '" data-email="' + escHtml(p.email) + '" data-note="' + escHtml(p.note) + '" style="margin-right:8px;">Edit</button>' +
          '<button type="button" class="tp-delete-btn" data-key="' + p.key + '" style="color:var(--red, #b3382c);">Delete</button>'
        : '<span style="color:var(--muted);" title="This test payment was created before edit/delete existed and needs a one-time database update to enable it — see backfill-test-payment-keys.sql">Not editable yet</span>';
      return '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);font-size:0.86rem;">' +
        '<span>' + p.date + ' — $' + Number(p.amount).toFixed(2) + ' — ' + escHtml(p.description) + '</span>' +
        '<span style="white-space:nowrap;">' + actions + '</span></div>';
    }).join('');
  } catch (err) {
    listEl.innerHTML = '<div class="field-hint">Could not reach the server: ' + err.message + '</div>';
  }
}
document.getElementById('tp-list').addEventListener('click', async function (e) {
  var editBtn = e.target.closest('.tp-edit-btn');
  var deleteBtn = e.target.closest('.tp-delete-btn');
  if (editBtn) {
    document.getElementById('tp-date').value = editBtn.dataset.date;
    document.getElementById('tp-amount').value = editBtn.dataset.amount;
    document.getElementById('tp-email').value = editBtn.dataset.email;
    document.getElementById('tp-note').value = editBtn.dataset.note;
    document.getElementById('tp-editing-key').value = editBtn.dataset.key;
    document.getElementById('btn-save-test-payment').textContent = 'Update test payment';
    document.getElementById('btn-cancel-edit-test-payment').style.display = 'inline-block';
    document.getElementById('tp-save-result').textContent = '';
  }
  if (deleteBtn) {
    if (!confirm('Delete this test payment? This cannot be undone.')) return;
    var resultEl = document.getElementById('tp-save-result');
    try {
      var delRes = await authedFetch(API_BASE + '/admin/test-payments/delete', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ key: deleteBtn.dataset.key })
      });
      var delData = await delRes.json();
      if (!delRes.ok) { resultEl.style.color = 'var(--red, #b3382c)'; resultEl.textContent = (delData.errors || [delData.error]).join(' ') || 'Could not delete.'; return; }
      loadTestPayments();
    } catch (err) {
      resultEl.style.color = 'var(--red, #b3382c)';
      resultEl.textContent = 'Could not reach the server: ' + err.message;
    }
  }
});
function resetTestPaymentForm() {
  document.getElementById('tp-date').value = '';
  document.getElementById('tp-amount').value = '';
  document.getElementById('tp-email').value = '';
  document.getElementById('tp-note').value = '';
  document.getElementById('tp-editing-key').value = '';
  document.getElementById('btn-save-test-payment').textContent = 'Add test payment';
  document.getElementById('btn-cancel-edit-test-payment').style.display = 'none';
}
document.getElementById('btn-cancel-edit-test-payment').addEventListener('click', function () {
  resetTestPaymentForm();
  document.getElementById('tp-save-result').textContent = '';
});
document.getElementById('btn-save-test-payment').addEventListener('click', async function () {
  var resultEl = document.getElementById('tp-save-result');
  var date = document.getElementById('tp-date').value;
  var amount = document.getElementById('tp-amount').value;
  var email = document.getElementById('tp-email').value.trim();
  var note = document.getElementById('tp-note').value.trim();
  var editingKey = document.getElementById('tp-editing-key').value;
  if (!date || !amount || !email) {
    resultEl.style.color = 'var(--red, #b3382c)';
    resultEl.textContent = 'Date, amount, and email are all required.';
    return;
  }
  var btn = this;
  btn.disabled = true;
  var isEditing = !!editingKey;
  var url = API_BASE + '/admin/test-payments/' + (isEditing ? 'update' : 'create');
  var payload = { date: date, amount: amount, email: email, note: note };
  if (isEditing) payload.key = editingKey;
  try {
    var res = await authedFetch(url, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
    });
    var data = await res.json();
    if (!res.ok) {
      resultEl.style.color = 'var(--red, #b3382c)';
      resultEl.textContent = (data.errors || [data.error]).join(' ') || 'Could not save.';
      return;
    }
    resultEl.style.color = 'var(--green, #2e7d4f)';
    resultEl.textContent = isEditing ? 'Test payment updated.' : 'Test payment added.';
    resetTestPaymentForm();
    loadTestPayments();
  } catch (err) {
    resultEl.style.color = 'var(--red, #b3382c)';
    resultEl.textContent = 'Could not reach the server: ' + err.message;
  } finally {
    btn.disabled = false;
  }
});

loadPartial('site-header', '/header.html');
loadPartial('site-footer', '/footer.html');
if ('serviceWorker' in navigator) navigator.serviceWorker.register('/service-worker.js').catch(function () {});
</script>

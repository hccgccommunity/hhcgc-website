<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TPBF5VKB" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<div id="site-header"></div>

<div class="page-hero">
  <div class="container">
    <span class="hero-badge">Internal Tool</span>
    <h2>Website Management</h2>
    <p>Analytics, homepage content, events, and pages — all in one place.</p>
  </div>
</div>

<div id="gate">
  <div class="gate-card">
    <img src="/hccgc-logo.jpeg" alt="HCCGC Logo" style="width:100px;height:100px;object-fit:contain;border-radius:50%;margin:0 auto 1.25rem;display:block;border:3px solid var(--border);">
    <h3 id="gate-title">Checking access&hellip;</h3>
    <p id="gate-message">One moment while we verify your access to this tool.</p>
    <a class="btn-google" id="btn-go-portal" href="/admin/admin-portal" style="display:none; text-decoration:none;">Go to Admin Portal</a>
  </div>
</div>

<div id="app-shell" style="display:none;">
  <div class="container" style="padding-top:1.25rem;">
    <p style="font-size:0.82rem;"><a href="/admin/admin-portal" style="color:var(--saffron-dark); text-decoration:none;">&larr; Back to apps</a></p>
    <div style="display:flex; justify-content:flex-end; margin-bottom:10px;">
      <div class="user-chip">
        <div class="user-avatar" id="user-avatar">?</div>
        <span class="user-name" id="user-name">&mdash;</span>
        <button id="btn-signout" title="Sign out" style="background:none;border:none;cursor:pointer;color:var(--muted);font-size:0.8rem;margin-left:8px;">Sign out</button>

['tx-rental-tbody', 'tx-fundraising-tbody', 'tx-donations-tbody', 'tx-zeffy-refunds-tbody', 'tx-zelle-tbody', 'tx-other-tbody'].forEach(function (id) {
  document.getElementById(id).addEventListener('click', async function (e) {
    const unsplitBtn = e.target.closest('[data-unsplit-key]');
    if (unsplitBtn) {
      if (!confirm('Restore this to a single transaction? Any category/note/review set on the split parts will be cleared.')) return;
      unsplitBtn.disabled = true;
      try {
        const res = await authedFetch(API_BASE + '/finance/unsplit-transaction', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sourceKey: unsplitBtn.dataset.unsplitKey, source: unsplitBtn.dataset.unsplitSource })
        });
        const data = await res.json();
        if (!res.ok) { alert('Could not unsplit: ' + ((data.errors || [data.error]).join(' ') || 'unknown error')); unsplitBtn.disabled = false; return; }
        await loadTransactions();
      } catch (err) {
        alert('Could not reach the server: ' + err.message);
        unsplitBtn.disabled = false;
      }
      return;
    }
    const unmergeBtn = e.target.closest('[data-unmerge-id]');
    if (unmergeBtn) {
      if (!confirm('Restore the original individual transactions? The category/note/review set on the merged line will be cleared.')) return;
      unmergeBtn.disabled = true;
      try {
        const res = await authedFetch(API_BASE + '/finance/unmerge-transactions', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mergeId: unmergeBtn.dataset.unmergeId, source: unmergeBtn.dataset.unmergeSource })
        });
        const data = await res.json();
        if (!res.ok) { alert('Could not unmerge: ' + ((data.errors || [data.error]).join(' ') || 'unknown error')); unmergeBtn.disabled = false; return; }
        await loadTransactions();
      } catch (err) {
        alert('Could not reach the server: ' + err.message);
        unmergeBtn.disabled = false;
      }
      return;
    }
    const circle = e.target.closest('[data-reviewed-toggle]');
    if (!circle) return;
    const rowId = circle.dataset.reviewedToggle;
    const row = circle.closest('tr');
    const sel = row.querySelector('[data-assign-category-source]');
    const tx = TRANSACTIONS.find(function (t) { return (t.source + '|' + t.sourceKey) === rowId; });
    if (!tx) return;

    const nowReviewing = !tx.reviewed;
    if (nowReviewing && !sel.value) {
      alert('This transaction is uncategorized — choose a category before marking it reviewed.');
      return;
    }
    circle.disabled = true;
    const originalContent = circle.innerHTML;
    circle.innerHTML = '<span class="tx-spinner" style="margin:0;width:12px;height:12px;border-width:2px;"></span>';
    try {
      const res = await authedFetch(API_BASE + '/finance/categorize', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ source: tx.source, sourceKey: tx.sourceKey, categoryId: sel.value || tx.categoryId, description: sel.dataset.assignCategoryDesc, notes: tx.notes, reviewed: nowReviewing })
      });
      const data = await res.json();
      if (!res.ok) { alert('Could not update: ' + ((data.errors || [data.error]).join(' ') || 'unknown error')); circle.innerHTML = originalContent; return; }
      tx.categoryId = sel.value || tx.categoryId;
      tx.reviewed = nowReviewing;
      sel.disabled = nowReviewing;
      sel.classList.toggle('uncategorized', !tx.categoryId);
      circle.classList.toggle('is-reviewed', nowReviewing);
      circle.title = nowReviewing ? 'Reviewed — click to unmark and edit category' : 'Mark as reviewed';
      circle.innerHTML = nowReviewing ? '\u2713' : '';
      populateCategorySelects();
    } catch (err) {
      alert('Could not reach the server: ' + err.message);
      circle.innerHTML = originalContent;
    } finally {
      circle.disabled = false;
    }
  });
});


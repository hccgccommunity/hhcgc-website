  <main>

    <!-- ── HERO ── -->
    <section class="hero">
      <div class="container">
        <div class="hero-card">

          <div>
            <span class="hero-kicker">An HCCGC Initiative</span>
            <h1 class="hero-title">
              Sahyog Milan
              <span class="hero-title-deva">सहयोग मिलन</span>
            </h1>
            <p class="hero-tagline">Connection, care, and community &mdash; a monthly gathering for our seniors.</p>
            <p class="hero-copy">
              Sahyog Milan brings seniors together through meaningful connections, engaging activities,
              learning, and fellowship. Every month offers a welcoming space to meet new friends, share
              experiences, stay active, and enjoy a real sense of belonging.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#signup">Sign Up</a>
              <a class="btn btn-secondary" href="#about">What Happens</a>
            </div>
          </div>

          <div class="hero-panel">
            <div class="quick-card">
              <div class="quick-card-icon">📅</div>
              <div class="quick-card-body">
                <h3>When</h3>
                <p>Monthly<small>Date announced each month</small></p>
              </div>
            </div>
            <div class="quick-card">
              <div class="quick-card-icon">📍</div>
              <div class="quick-card-body">
                <h3>Where</h3>
                <p>HCCGC<small>Mason, Ohio</small></p>
              </div>
            </div>
            <div class="quick-card">
              <div class="quick-card-icon">🍽️</div>
              <div class="quick-card-body">
                <h3>Includes</h3>
                <p>A shared meal<small>Together, after the program</small></p>
              </div>
            </div>

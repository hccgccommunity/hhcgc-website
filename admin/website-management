<style>

:root {
  --bg: #fff9f1;
  --surface: #ffffff;
  --surface-soft: #fff6ea;
  --border: rgba(121,62,17,0.14);
  --text: #2c1b10;
  --muted: #6a5141;
  --saffron: #b55a18;
  --saffron-dark: #8d3e0d;
  --maroon: #7f2e16;
  --radius: 22px;
  --shadow: 0 18px 45px rgba(93,43,14,0.10);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at top left, rgba(217,138,30,0.12), transparent 22%),
    radial-gradient(circle at top right, rgba(127,46,22,0.05), transparent 20%),
    var(--bg);
  color: var(--text);
  min-height: 100vh;
}

.container { width: min(calc(100% - 32px), 1220px); margin: 0 auto; }

.page-hero {
  background: linear-gradient(135deg, var(--maroon) 0%, #4e1a09 100%);
  color: #fff;
  padding: 48px 0 42px;
  text-align: center;
}
.page-hero h2 {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 2rem;
  margin-bottom: 10px;
  font-weight: 700;
}
.page-hero p {
  font-size: 0.95rem;
  opacity: 0.85;
  max-width: 520px;
  margin: 0 auto;
  line-height: 1.65;
}
.hero-badge {
  display: inline-block;
  background: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.28);
  border-radius: 20px;
  padding: 4px 14px;
  font-size: 0.72rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  margin-bottom: 14px;
  font-weight: 700;
}

#gate { padding: 60px 16px; display: flex; justify-content: center; }
.gate-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 2.5rem 2rem;
  max-width: 420px;
  width: 100%;
  text-align: center;
  box-shadow: var(--shadow);
}
.gate-card h3 {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.4rem;
  color: var(--maroon);
  margin-bottom: 0.5rem;
}
.gate-card > p { color: var(--muted); font-size: 0.88rem; line-height: 1.65; margin-bottom: 1.75rem; }

.btn-google {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  width: 100%; padding: 0.72rem 1rem; background: #fff;
  border: 1.5px solid var(--border); border-radius: 10px;
  font-size: 0.95rem; font-weight: 600; color: #3c4043;
  cursor: pointer; transition: background 0.15s, box-shadow 0.15s;
  font-family: Arial, Helvetica, sans-serif;
}
.btn-google:hover { background: #f8f9fa; box-shadow: 0 1px 8px rgba(0,0,0,0.13); }
.btn-google:disabled { opacity: 0.6; cursor: not-allowed; }

.gate-note { margin-top: 1.2rem; font-size: 0.78rem; color: var(--muted); line-height: 1.5; }
.gate-note a { color: var(--saffron-dark); text-decoration: none; }
.gate-note a:hover { text-decoration: underline; }

#signin-error {
  display: none;
  color: #c0392b;
  background: #fdecea;
  border: 1px solid #f5c6cb;
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 0.82rem;
  margin-top: 1rem;
  text-align: left;
}

#app { display: none; }

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  margin: 2rem 0 1.5rem;
}
.toolbar-left h3 {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.5rem;
  color: var(--maroon);
}
.toolbar-left p { font-size: 0.86rem; color: var(--muted); margin-top: 4px; }

/* VIEW TOGGLE */
.view-toggle {
  display: flex; gap: 0; border: 1.5px solid var(--border); border-radius: 10px; overflow: hidden;
}
.view-btn {
  padding: 0.45rem 0.9rem; border: none; background: #fff; color: var(--muted);
  font-size: 0.82rem; font-weight: 700; cursor: pointer; font-family: Arial, Helvetica, sans-serif;
  display: inline-flex; align-items: center; gap: 6px; transition: all 0.12s;
}
.view-btn:first-child { border-right: 1.5px solid var(--border); }
.view-btn.active { background: var(--maroon); color: #fff; }
.view-btn:not(.active):hover { background: var(--surface-soft); color: var(--saffron-dark); }

/* CALENDAR */
.calendar-wrap { background: #fff; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; margin-bottom: 2rem; }
.cal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1rem 1.4rem; border-bottom: 1px solid var(--border); background: var(--surface-soft);
}
.cal-header h3 { font-family: Georgia, serif; font-size: 1.1rem; color: var(--maroon); }
.cal-nav { display: flex; gap: 6px; }
.cal-nav-btn {
  width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border);
  background: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;
  font-size: 1rem; color: var(--muted);
}
.cal-nav-btn:hover { border-color: var(--saffron); color: var(--saffron-dark); }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
.cal-day-label {
  text-align: center; padding: 8px 4px; font-size: 0.72rem; font-weight: 700;
  color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;
  border-bottom: 1px solid var(--border);
}
.cal-cell {
  min-height: 80px; padding: 6px; border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border); vertical-align: top; position: relative;
  cursor: default;
}
.cal-cell:nth-child(7n) { border-right: none; }
.cal-cell.other-month { background: #fafafa; }
.cal-cell.today { background: rgba(181,90,24,0.05); }
.cal-date {
  font-size: 0.78rem; font-weight: 700; color: var(--muted); margin-bottom: 4px;
  width: 22px; height: 22px; display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
}
.cal-cell.today .cal-date { background: var(--maroon); color: #fff; }
.cal-event-dot {
  font-size: 0.68rem; line-height: 1.3; padding: 2px 5px; border-radius: 4px;
  margin-bottom: 2px; cursor: pointer; white-space: nowrap; overflow: hidden;
  text-overflow: ellipsis; font-weight: 600;
}
.cal-event-dot.type-event { background: rgba(127,46,22,0.12); color: var(--maroon); }
.cal-event-dot.type-initiative { background: rgba(181,90,24,0.12); color: var(--saffron-dark); }
.cal-more { font-size: 0.68rem; color: var(--muted); padding: 1px 4px; cursor: pointer; }
.cal-more:hover { color: var(--saffron-dark); }

/* DAY DETAIL PANEL */
.day-detail {
  display: none; padding: 1rem 1.4rem; border-top: 1px solid var(--border); background: var(--surface-soft);
}
.day-detail.show { display: block; }
.day-detail h4 { font-family: Georgia, serif; font-size: 1rem; color: var(--maroon); margin-bottom: 10px; }
.day-event-row {
  display: flex; align-items: center; gap: 12px; padding: 8px 0;
  border-bottom: 1px dashed var(--border);
}
.day-event-row:last-child { border-bottom: none; }
.day-event-name { font-size: 0.86rem; font-weight: 700; color: var(--text); flex: 1; }
.day-event-time { font-size: 0.78rem; color: var(--muted); }
.day-event-actions { display: flex; gap: 6px; }


.user-chip {
  display: flex; align-items: center; gap: 10px;
  background: #fff; border: 1px solid var(--border);
  border-radius: 999px; padding: 6px 14px 6px 6px;
}
.user-avatar {
  width: 30px; height: 30px; border-radius: 50%;
  background: var(--maroon); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 0.72rem; font-weight: 700; flex-shrink: 0;
  overflow: hidden;
}
.user-avatar img { width: 100%; height: 100%; object-fit: cover; }
.user-name { font-size: 0.82rem; font-weight: 700; }
.btn-signout {
  background: none; border: none; font-size: 0.72rem; color: var(--muted);
  cursor: pointer; padding: 2px 4px; font-family: Arial, Helvetica, sans-serif;
}
.btn-signout:hover { color: var(--maroon); }

.btn-add {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 0.7rem 1.4rem; background: var(--maroon); color: #fff;
  border: none; border-radius: 999px; font-size: 0.9rem; font-weight: 700;
  cursor: pointer; font-family: Arial, Helvetica, sans-serif;
  transition: background 0.15s, transform 0.1s;
}
.btn-add:hover { background: #5a1e0a; }
.btn-add:active { transform: scale(0.98); }

.status-bar {
  display: none; align-items: center; gap: 10px;
  padding: 0.75rem 1.1rem; border-radius: 12px;
  font-size: 0.86rem; font-weight: 600; margin-bottom: 1.25rem;
}
.status-bar.show { display: flex; }
.status-bar.success { background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; }
.status-bar.error { background: #fdecea; color: #c0392b; border: 1px solid #f5c6cb; }
.status-bar.info { background: var(--surface-soft); color: var(--saffron-dark); border: 1px solid var(--border); }

.events-list { display: flex; flex-direction: column; gap: 14px; margin-bottom: 1.5rem; }

.event-row {
  background: #fff; border: 1px solid var(--border); border-radius: 16px;
  padding: 1.25rem 1.5rem; display: grid; grid-template-columns: 1fr auto;
  gap: 16px; align-items: start; box-shadow: 0 4px 16px rgba(93,43,14,0.05);
}
.event-row.is-past { opacity: 0.6; background: var(--surface-soft); }

.past-badge {
  display: inline-block; background: rgba(108,108,108,0.12); color: #6a5141;
  border: 1px solid var(--border); padding: 3px 10px; border-radius: 999px;
  font-size: 0.7rem; font-weight: 800; text-transform: uppercase;
  letter-spacing: 0.04em; margin-left: 8px;
}

.event-row-main h4 {
  font-family: Georgia, "Times New Roman", serif;
  color: var(--maroon); font-size: 1.15rem; margin-bottom: 6px;
}
.event-row-meta {
  display: flex; flex-wrap: wrap; gap: 12px; font-size: 0.82rem;
  color: var(--saffron-dark); font-weight: 700; margin-bottom: 8px;
}
.event-row-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.55; margin-bottom: 6px; }
.event-row-link { font-size: 0.8rem; color: var(--muted); word-break: break-all; }
.event-row-link a { color: var(--saffron-dark); }
.event-row-created {
  font-size: 0.74rem; color: var(--muted); opacity: 0.8; margin-top: 6px;
  border-top: 1px dashed var(--border); padding-top: 6px;
}

.event-row-actions { display: flex; flex-direction: column; gap: 8px; flex-shrink: 0; }

.btn-icon {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 0.45rem 0.8rem; border: 1px solid var(--border); border-radius: 8px;
  background: #fff; font-size: 0.78rem; font-weight: 600; color: var(--muted);
  cursor: pointer; font-family: Arial, Helvetica, sans-serif;
  transition: all 0.12s; white-space: nowrap;
}
.btn-icon:hover { border-color: var(--saffron); color: var(--saffron-dark); }
.btn-icon.danger:hover { border-color: #c0392b; color: #c0392b; }

.empty-state {
  text-align: center; padding: 50px 20px; color: var(--muted);
  background: #fff; border: 1px dashed var(--border); border-radius: 16px;
}

.section-divider {
  display: flex; align-items: center; gap: 10px; margin: 2rem 0 1rem;
  cursor: pointer; user-select: none;
}
.section-divider .line { flex: 1; height: 1px; background: var(--border); }
.section-divider span.label {
  font-size: 0.8rem; font-weight: 700; color: var(--muted);
  text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap;
}
.section-divider .chevron { transition: transform 0.15s; color: var(--muted); }
.section-divider.collapsed .chevron { transform: rotate(-90deg); }
.past-events-list { display: flex; flex-direction: column; gap: 14px; }
.past-events-list.collapsed { display: none; }

.modal-overlay {
  display: none; position: fixed; inset: 0; background: rgba(44,27,16,0.45);
  z-index: 200; align-items: center; justify-content: center; padding: 20px;
}
.modal-overlay.show { display: flex; }
.modal-card {
  background: #fff; border-radius: 18px; max-width: 540px; width: 100%;
  max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow);
}
.modal-header {
  padding: 1.4rem 1.6rem; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
}
.modal-header h3 {
  font-family: Georgia, "Times New Roman", serif;
  color: var(--maroon); font-size: 1.2rem;
}
.modal-close {
  background: none; border: none; cursor: pointer;
  color: var(--muted); font-size: 1.3rem; line-height: 1; padding: 4px;
}
.modal-close:hover { color: var(--maroon); }
.modal-tab {
  padding: 0.75rem 1.1rem; font-size: 0.86rem; font-weight: 700;
  color: var(--muted); cursor: pointer; border: none; background: none;
  border-bottom: 2.5px solid transparent; margin-bottom: -1px;
  font-family: Arial, Helvetica, sans-serif; transition: color 0.12s;
}
.modal-tab.active { color: var(--maroon); border-bottom-color: var(--maroon); }
.modal-tab:hover { color: var(--saffron-dark); }
.modal-panel { display: none; }
.modal-panel.active { display: block; }

.modal-body { padding: 1.5rem 1.6rem; }

.form-group { margin-bottom: 1.1rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

label { display: block; font-size: 0.82rem; font-weight: 700; color: var(--text); margin-bottom: 0.4rem; }

input[type="text"], input[type="date"], input[type="time"], select, textarea {
  width: 100%; padding: 0.6rem 0.85rem;
  border: 1.5px solid var(--border); border-radius: 10px;
  font-size: 0.9rem; font-family: Arial, Helvetica, sans-serif;
  background: #fff; color: var(--text);
  transition: border-color 0.15s, box-shadow 0.15s;
}
input:focus, textarea:focus, select:focus {
  outline: none; border-color: var(--saffron);
  box-shadow: 0 0 0 3px rgba(181,90,24,0.14);
}
textarea { resize: vertical; }

.type-toggle {
  display: flex;
  gap: 8px;
  margin-top: 4px;
}
.type-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 0.65rem 0.8rem;
  border: 1.5px solid var(--border);
  border-radius: 10px;
  background: #fff;
  color: var(--muted);
  font-size: 0.86rem;
  font-weight: 700;
  cursor: pointer;
  font-family: Arial, Helvetica, sans-serif;
  transition: all 0.12s;
  text-align: center;
}
.type-btn:hover { border-color: var(--saffron); color: var(--saffron-dark); }
.type-btn.active { background: var(--maroon); border-color: var(--maroon); color: #fff; }
.type-btn.active svg { filter: brightness(10); }

.initiative-badge {
  display: inline-block;
  background: rgba(127,46,22,0.1);
  color: var(--maroon);
  border: 1px solid rgba(127,46,22,0.2);
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-left: 8px;
}

.field-error { font-size: 0.76rem; color: #c0392b; margin-top: 4px; display: none; }
.field-error.show { display: block; }

.modal-footer {
  padding: 1.2rem 1.6rem 1.5rem; display: flex; justify-content: flex-end;
  gap: 10px; border-top: 1px solid var(--border);
}

.btn-secondary {
  padding: 0.65rem 1.3rem; border-radius: 10px; border: 1.5px solid var(--border);
  background: #fff; color: var(--muted); font-weight: 700; font-size: 0.88rem;
  cursor: pointer; font-family: Arial, Helvetica, sans-serif;
}
.btn-secondary:hover { border-color: var(--saffron); color: var(--saffron-dark); }

.btn-save {
  padding: 0.65rem 1.5rem; border-radius: 10px; border: none;
  background: var(--maroon); color: #fff; font-weight: 700; font-size: 0.88rem;
  cursor: pointer; font-family: Arial, Helvetica, sans-serif;
  display: inline-flex; align-items: center; gap: 8px;
}
.btn-save:hover { background: #5a1e0a; }
.btn-save:disabled { background: #b8907e; cursor: not-allowed; }

.spinner {
  width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.4);
  border-top-color: #fff; border-radius: 50%; animation: spin 0.7s linear infinite;
  display: inline-block; flex-shrink: 0;
}
@keyframes spin { to { transform: rotate(360deg); } }

@media (max-width: 640px) {
  .event-row { grid-template-columns: 1fr; }
  .event-row-actions { flex-direction: row; }
  .form-row { grid-template-columns: 1fr; }
  .toolbar { flex-direction: column; align-items: stretch; }
}
/* Header partial styling — required by header.html's markup.
   Copied to match the rest of the site so header.html renders
   identically here as it does everywhere else. */
.site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 249, 241, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
}

.nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 92px;
    padding: 12px 0;
}

.site-header a.brand,
.site-header a.brand:link,
.site-header a.brand:visited {
    text-decoration: none;
    color: inherit;
}
.brand {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
}

.brand-logo-wrap {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 8px;
    box-shadow: var(--shadow);
    flex-shrink: 0;
}

.brand-logo {
    width: 88px;
    height: auto;
    border-radius: 12px;
    object-fit: contain;
}

.brand-text h1 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.15;
    color: var(--maroon);
}

.site-header nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: flex-end;
}

.site-header nav a,
.site-header nav a:link,
.site-header nav a:visited {
    font-weight: 700;
    color: var(--text);
    font-size: 0.96rem;
    text-decoration: none;
}

.site-header nav a:hover {
    color: var(--saffron-dark);
}

.menu-toggle {
    display: none;
    border: 0;
    background: transparent;
    padding: 6px 0;
    cursor: pointer;
    color: #2c1b10;
    align-self: flex-end;
}

.menu-toggle .bar {
    display: block;
    width: 26px;
    height: 2px;
    margin: 5px 0;
    background: currentColor;
}

@media (max-width: 768px) {
    .nav {
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
    }

    .menu-toggle {
        display: inline-block;
    }

    .site-header nav {
        display: none;
        width: 100%;
        background: rgba(255, 249, 241, 0.95);
        padding: 10px 0;
    }

    .site-header nav.is-open {
        display: block;
    }

    .site-header nav ul {
        flex-direction: column;
        gap: 14px;
    }
}

/* ===== manage-pages styles ===== */

:root {
  --bg:#fff9f1;--surface:#fff;--surface-soft:#fff6ea;--border:rgba(121,62,17,0.14);
  --text:#2c1b10;--muted:#6a5141;--saffron:#b55a18;--saffron-dark:#8d3e0d;
  --maroon:#7f2e16;--radius:22px;--shadow:0 18px 45px rgba(93,43,14,0.10);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{font-family:Arial,Helvetica,sans-serif;background:radial-gradient(circle at top left,rgba(217,138,30,0.12),transparent 22%),radial-gradient(circle at top right,rgba(127,46,22,0.05),transparent 20%),var(--bg);color:var(--text);min-height:100vh;}
.container{width:min(calc(100% - 32px),1100px);margin:0 auto;}
.site-header{position:sticky;top:0;z-index:50;background:rgba(255,249,241,0.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);}
.nav{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:92px;padding:12px 0;}
.brand{display:flex;align-items:center;gap:16px;min-width:0;}
.brand-logo-wrap{background:#7f2e16;border-radius:18px;padding:8px;flex-shrink:0;}
.brand-logo{width:88px;height:auto;border-radius:12px;object-fit:contain;}
.brand-text h1{margin:0;font-size:1.2rem;line-height:1.15;color:var(--maroon);font-family:Georgia,serif;}
.site-header a.brand,.site-header a.brand:link,.site-header a.brand:visited{text-decoration:none;color:inherit;}
.site-header nav ul{list-style:none;display:flex;flex-wrap:wrap;gap:18px;margin:0;padding:0;align-items:center;justify-content:flex-end;}
.site-header nav a,.site-header nav a:link,.site-header nav a:visited{font-weight:700;color:var(--text);font-size:0.96rem;text-decoration:none;}
.site-header nav a:hover{color:var(--saffron-dark);}
.menu-toggle{display:none;border:0;background:transparent;padding:6px 0;cursor:pointer;color:#2c1b10;align-self:flex-end;}
.menu-toggle .bar{display:block;width:26px;height:2px;margin:5px 0;background:currentColor;}
@media(max-width:768px){.nav{flex-direction:column;align-items:stretch;gap:8px;}.menu-toggle{display:inline-block;}.site-header nav{display:none;width:100%;background:rgba(255,249,241,0.95);padding:10px 0;}.site-header nav.is-open{display:block;}.site-header nav ul{flex-direction:column;gap:14px;}}
#gate{padding:60px 16px;display:flex;justify-content:center;}
.gate-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:2.5rem 2rem;max-width:420px;width:100%;text-align:center;box-shadow:var(--shadow);}
.gate-card h3{font-family:Georgia,serif;font-size:1.3rem;color:var(--maroon);margin-bottom:.5rem;}
.gate-card p{color:var(--muted);font-size:.88rem;line-height:1.6;}
.gate-card a{color:var(--saffron-dark);}
#app{display:none;}
.page-header{padding:36px 0 20px;}
.page-header h1{font-family:Georgia,serif;font-size:1.8rem;color:var(--maroon);margin-bottom:6px;}
.page-header p{color:var(--muted);font-size:.9rem;}
.back-link{font-size:.82rem;color:var(--saffron-dark);text-decoration:none;display:inline-block;margin-bottom:10px;}
.back-link:hover{text-decoration:underline;}
.status-bar{display:none;align-items:center;gap:10px;padding:.75rem 1.1rem;border-radius:12px;font-size:.86rem;font-weight:600;margin:0 0 1.25rem;}
.status-bar.show{display:flex;}
.status-bar.success{background:#e8f5e9;color:#2e7d32;border:1px solid #c8e6c9;}
.status-bar.error{background:#fdecea;color:#c0392b;border:1px solid #f5c6cb;}
.toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:1.5rem;flex-wrap:wrap;}
.btn-new{display:inline-flex;align-items:center;gap:8px;padding:.7rem 1.4rem;background:var(--maroon);color:#fff;border:none;border-radius:999px;font-size:.9rem;font-weight:700;cursor:pointer;font-family:Arial,Helvetica,sans-serif;}
.btn-new:hover{background:#5a1e0a;}
.pages-list{display:flex;flex-direction:column;gap:14px;padding-bottom:60px;}
.page-row{background:#fff;border:1px solid var(--border);border-radius:16px;padding:1.2rem 1.5rem;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
.page-row-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;background:#e0e0e0;}
.page-row-dot.live{background:#4caf50;}
.page-row-info{flex:1;min-width:200px;}
.page-row-info h4{font-family:Georgia,serif;font-size:1rem;color:var(--maroon);margin-bottom:3px;}
.page-row-info .meta{font-size:.78rem;color:var(--muted);}
.page-row-info .meta a{color:var(--saffron-dark);text-decoration:none;}
.page-row-info .meta a:hover{text-decoration:underline;}
.type-pill{font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em;padding:2px 9px;border-radius:999px;}
.type-pill.event{background:rgba(127,46,22,.1);color:var(--maroon);}
.type-pill.initiative{background:rgba(181,90,24,.12);color:var(--saffron-dark);}
.page-row-actions{display:flex;gap:8px;}
.btn-row{display:inline-flex;align-items:center;gap:6px;padding:.45rem .9rem;border:1px solid var(--border);border-radius:8px;background:#fff;font-size:.8rem;font-weight:600;color:var(--muted);cursor:pointer;font-family:Arial,Helvetica,sans-serif;white-space:nowrap;}
.btn-row:hover{border-color:var(--saffron);color:var(--saffron-dark);}
.btn-row.danger:hover{border-color:#c0392b;color:#c0392b;}
.empty-state{text-align:center;padding:50px 20px;color:var(--muted);background:#fff;border:1px dashed var(--border);border-radius:16px;}
/* MODAL */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(44,27,16,.45);z-index:200;align-items:flex-start;justify-content:center;padding:16px;overflow-y:auto;}
.modal-overlay.show{display:flex;}
.modal-card{background:#fff;border-radius:18px;max-width:640px;width:100%;box-shadow:var(--shadow);margin:auto;}
.wizard-header{padding:1.4rem 1.6rem 0;}
.wizard-header-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.wizard-header-top h3{font-family:Georgia,serif;color:var(--maroon);font-size:1.1rem;}
.modal-close{background:none;border:none;cursor:pointer;color:var(--muted);font-size:1.3rem;}
.modal-close:hover{color:var(--maroon);}
.wizard-tabs{display:flex;border-bottom:1px solid var(--border);padding:0 1.6rem;overflow-x:auto;gap:0;}
.wizard-tab{padding:.7rem .9rem;font-size:.8rem;font-weight:700;color:var(--muted);cursor:pointer;border:none;background:none;border-bottom:2.5px solid transparent;margin-bottom:-1px;font-family:Arial,Helvetica,sans-serif;white-space:nowrap;transition:color .12s;}
.wizard-tab.active{color:var(--maroon);border-bottom-color:var(--maroon);}
.wizard-tab.done{color:var(--saffron-dark);}
.wizard-tab:hover:not(.active){color:var(--saffron-dark);}
.wizard-step{display:none;padding:0 1.6rem 1.2rem;}
.wizard-step.active{display:block;}
.form-group{margin-bottom:1.1rem;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
label{display:block;font-size:.82rem;font-weight:700;color:var(--text);margin-bottom:.4rem;}
label .hint{font-weight:400;color:var(--muted);}
input[type=text],input[type=date],input[type=time],input[type=url],textarea,select{width:100%;padding:.6rem .85rem;border:1.5px solid var(--border);border-radius:10px;font-size:.9rem;font-family:Arial,Helvetica,sans-serif;background:#fff;color:var(--text);}
input:focus,textarea:focus,select:focus{outline:none;border-color:var(--saffron);box-shadow:0 0 0 3px rgba(181,90,24,.14);}
textarea{resize:vertical;}
.field-hint{font-size:.76rem;color:var(--muted);margin-top:4px;line-height:1.5;}
.field-error{font-size:.76rem;color:#c0392b;margin-top:4px;display:none;}
.field-error.show{display:block;}
.slug-preview{font-size:.78rem;color:var(--muted);margin-top:4px;}
.slug-preview span{font-weight:700;color:var(--saffron-dark);}
.toggle-row{display:flex;align-items:center;gap:10px;padding:12px 14px;background:var(--surface-soft);border:1px solid var(--border);border-radius:10px;margin-bottom:1.1rem;cursor:pointer;}
.toggle-row label{margin:0;cursor:pointer;font-size:.88rem;font-weight:600;}
.toggle-row input[type=checkbox]{width:auto;cursor:pointer;}
.type-toggle{display:flex;gap:8px;margin-top:4px;}
.type-btn{flex:1;display:flex;align-items:center;justify-content:center;gap:7px;padding:.65rem .8rem;border:1.5px solid var(--border);border-radius:10px;background:#fff;color:var(--muted);font-size:.86rem;font-weight:700;cursor:pointer;font-family:Arial,Helvetica,sans-serif;transition:all .12s;}
.type-btn.active{background:var(--maroon);border-color:var(--maroon);color:#fff;}
.type-btn:hover:not(.active){border-color:var(--saffron);color:var(--saffron-dark);}
.sec-label{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--saffron-dark);margin:1.2rem 0 .6rem;padding-bottom:6px;border-bottom:1px dashed var(--border);display:block;}
.drive-help{background:#e8f5e9;border:1px solid #c8e6c9;border-radius:10px;padding:10px 14px;font-size:.77rem;color:#2e7d32;margin-top:6px;line-height:1.6;}
.drive-help strong{display:block;margin-bottom:3px;}
.img-preview{margin-top:8px;display:none;}
.img-preview img{max-width:100%;border-radius:8px;border:1px solid var(--border);max-height:140px;object-fit:contain;}
.event-sync-box{background:var(--surface-soft);border:1px solid var(--border);border-radius:12px;padding:1rem 1.2rem;margin-top:.8rem;}
.event-sync-box h4{font-size:.82rem;font-weight:700;margin-bottom:.6rem;color:var(--text);}
.event-sync-fields{display:none;}
.event-sync-fields.show{display:block;}
.wizard-footer{padding:1.2rem 1.6rem 1.5rem;display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border);gap:10px;flex-wrap:wrap;}
.wizard-footer-left{display:flex;gap:8px;}
.wizard-footer-right{display:flex;align-items:center;gap:10px;}
.live-link{font-size:.78rem;color:var(--saffron-dark);text-decoration:none;}
.live-link:hover{text-decoration:underline;}
.btn-secondary{padding:.6rem 1.2rem;border-radius:10px;border:1.5px solid var(--border);background:#fff;color:var(--muted);font-weight:700;font-size:.86rem;cursor:pointer;font-family:Arial,Helvetica,sans-serif;}
.btn-secondary:hover{border-color:var(--saffron);color:var(--saffron-dark);}
.btn-next{padding:.6rem 1.4rem;border-radius:10px;border:none;background:var(--saffron-dark);color:#fff;font-weight:700;font-size:.86rem;cursor:pointer;font-family:Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;gap:6px;}
.btn-next:hover{background:#6a2e09;}
.btn-save{padding:.6rem 1.4rem;border-radius:10px;border:none;background:var(--maroon);color:#fff;font-weight:700;font-size:.86rem;cursor:pointer;font-family:Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;gap:8px;}
.btn-save:hover{background:#5a1e0a;}
.btn-save:disabled,.btn-next:disabled{opacity:.6;cursor:not-allowed;}
.spinner{width:14px;height:14px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:inline-block;}
@keyframes spin{to{transform:rotate(360deg);}}
@media(max-width:600px){.form-row{grid-template-columns:1fr;}.page-row{flex-direction:column;align-items:stretch;}.wizard-footer{flex-direction:column;}.wizard-footer-left,.wizard-footer-right{width:100%;justify-content:flex-end;}}

/* Website Management - merged app tab structure */
.wm-tab-btn { font-family: inherit; font-size: 0.92rem; font-weight: 700; padding: 12px 18px; border: none; background: none; cursor: pointer; color: var(--muted); border-bottom: 3px solid transparent; }
.wm-tab-btn.active { color: var(--saffron-dark); border-bottom-color: var(--saffron-dark); }
.wm-tab-panel { display: none; padding: 24px 0 60px; }
.wm-tab-panel.active { display: block; }
</style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TPBF5VKB" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<div id="site-header"></div>

<div class="page-hero">
  <div class="container">
    <span class="hero-badge">Internal Tool</span>
    <h2>Website Management</h2>
    <p>Analytics, homepage content, events, and pages — all in one place.</p>
  </div>
</div>

<div id="gate">
  <div class="gate-card">
    <img src="/hccgc-logo.jpeg" alt="HCCGC Logo" style="width:100px;height:100px;object-fit:contain;border-radius:50%;margin:0 auto 1.25rem;display:block;border:3px solid var(--border);">
    <h3 id="gate-title">Checking access&hellip;</h3>
    <p id="gate-message">One moment while we verify your access to this tool.</p>
    <a class="btn-google" id="btn-go-portal" href="/admin/admin-portal" style="display:none; text-decoration:none;">Go to Admin Portal</a>
  </div>
</div>

<div id="app-shell" style="display:none;">
  <div class="container" style="padding-top:1.25rem;">
    <p style="font-size:0.82rem;"><a href="/admin/admin-portal" style="color:var(--saffron-dark); text-decoration:none;">&larr; Back to apps</a></p>
    <div style="display:flex; justify-content:flex-end; margin-bottom:10px;">
      <div class="user-chip">
        <div class="user-avatar" id="user-avatar">?</div>
        <span class="user-name" id="user-name">&mdash;</span>
        <button id="btn-signout" title="Sign out" style="background:none;border:none;cursor:pointer;color:var(--muted);font-size:0.8rem;margin-left:8px;">Sign out</button>
      </div>
    </div>
  </div>

  <div class="tab-nav">
    <div class="container">
      <ul>
        <li><button class="wm-tab-btn active" data-wm-tab="analytics">Analytics</button></li>
        <li><button class="wm-tab-btn" data-wm-tab="homepage">Homepage</button></li>
        <li><button class="wm-tab-btn" data-wm-tab="events">Manage Events</button></li>
        <li><button class="wm-tab-btn" data-wm-tab="pages">Manage Pages</button></li>
      </ul>
    </div>
  </div>

  <div class="container">
    <div class="wm-tab-panel active" id="wm-tab-analytics">
      <div class="card" style="padding:40px;text-align:center;">
        <h2 style="margin-bottom:8px;">Google Analytics</h2>
        <p style="color:var(--muted);max-width:480px;margin:0 auto;">Not built yet — embedding a live dashboard needs a Google Analytics property and embed/API access set up on your end first. Once that's in place, this tab is ready to be built out.</p>
      </div>
    </div>

    <div class="wm-tab-panel" id="wm-tab-homepage">
      <div class="card" style="padding:40px;text-align:center;">
        <h2 style="margin-bottom:8px;">Homepage Management</h2>
        <p style="color:var(--muted);max-width:480px;margin:0 auto;">Not built yet — carousel images, logo, and menu editing will go here. Note: adding programs and initiatives already works today, in the Manage Pages tab.</p>
      </div>
    </div>

    <div class="wm-tab-panel" id="wm-tab-events">
<div id="app-events">
  <div class="container">

    <div class="toolbar">
      <div class="toolbar-left">
        <h3>Event List</h3>
        <p>Changes here update the public Upcoming Events page immediately.</p>
      </div>
      <div style="display:flex; align-items:center; gap:14px;">
        <div class="view-toggle">
          <button class="view-btn" id="btn-view-calendar">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Calendar
          </button>
          <button class="view-btn active" id="btn-view-list">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="3" cy="6" r="1"/><circle cx="3" cy="12" r="1"/><circle cx="3" cy="18" r="1"/></svg>
            List
          </button>
        </div>
        <button class="btn-add" id="btn-add-event">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Event
        </button>
      </div>
    </div>

    <div class="status-bar" id="status-bar"></div>

    <!-- CALENDAR VIEW -->
    <div id="calendar-view" style="display:none;">
      <div class="calendar-wrap">
        <div class="cal-header">
          <h3 id="cal-month-label">Month Year</h3>
          <div class="cal-nav">
            <button class="cal-nav-btn" id="cal-prev">&#8249;</button>
            <button class="cal-nav-btn" id="cal-today-btn" style="font-size:0.72rem;font-weight:700;width:auto;padding:0 8px;">Today</button>
            <button class="cal-nav-btn" id="cal-next">&#8250;</button>
          </div>
        </div>
        <div class="cal-grid" id="cal-grid"></div>
        <div class="day-detail" id="day-detail">
          <h4 id="day-detail-title"></h4>
          <div id="day-detail-events"></div>
        </div>
      </div>
    </div>

    <div class="events-list" id="events-list">
      <div class="empty-state">Loading events&hellip;</div>
    </div>

    <div id="past-events-section" style="display:none;">
      <div class="section-divider collapsed" id="past-events-toggle">
        <span class="line"></span>
        <span class="label" id="past-events-label">Past Events</span>
        <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        <span class="line"></span>
      </div>
      <div class="past-events-list collapsed" id="past-events-list"></div>
    </div>

  </div>
</div>
    </div>

    <div class="wm-tab-panel" id="wm-tab-pages">
<div id="app-pages">
  <div class="container">
    <div class="page-header">
      <a class="back-link" href="/admin/admin-portal">&larr; Back to apps</a>
      <h1>Manage Pages</h1>
      <p>Create and publish public event and initiative pages. Changes go live instantly — no deploy needed.</p>
    </div>
    <div class="status-bar" id="status-bar-mp"></div>
    <div class="toolbar">
      <div id="pages-count" style="font-size:.86rem;color:var(--muted);"></div>
      <button class="btn-new" id="btn-new-page">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Page
      </button>
    </div>
    <div class="pages-list" id="pages-list">
      <div class="empty-state">Loading&hellip;</div>
    </div>
  </div>
</div>

<!-- WIZARD MODAL -->
<div class="modal-overlay" id="modal-overlay-mp">
  <div class="modal-card">
    <div class="wizard-header">
      <div class="wizard-header-top">
        <h3 id="wizard-title">New Page</h3>
        <button class="modal-close" id="modal-close-btn-mp">&times;</button>
      </div>
      <div class="wizard-tabs" id="wizard-tabs"></div>
    </div>

    <input type="hidden" id="edit-page-id">

    <!-- STEP 1: Basics -->
    <div class="wizard-step active" id="step-1">
      <div class="form-group">
        <label>Page Type *</label>
        <div class="type-toggle">
          <button type="button" class="type-btn active" id="type-btn-event-mp" data-type="event">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Event <span style="font-weight:400;font-size:.75rem;">(one-time)</span>
          </button>
          <button type="button" class="type-btn" id="type-btn-initiative-mp" data-type="initiative">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
            Initiative <span style="font-weight:400;font-size:.75rem;">(recurring)</span>
          </button>
        </div>
        <input type="hidden" id="page-type" value="event">
      </div>
      <div class="form-group">
        <label for="page-title">Page Title *</label>
        <input type="text" id="page-title" placeholder="e.g. Parisa Sparsha – An Evening of Classical Music">
        <div class="field-error" id="err-title">Please enter a page title.</div>
      </div>
      <div class="form-group">
        <label for="page-slug">URL Slug *</label>
        <input type="text" id="page-slug" placeholder="e.g. parisa-sparsha">
        <div class="slug-preview">hccgc.org/<span id="slug-display">your-slug</span></div>
        <div class="field-error" id="err-slug">Please enter a valid slug (lowercase, hyphens, numbers only).</div>
      </div>
      <div class="form-group">
        <label for="page-tagline">Tagline</label>
        <input type="text" id="page-tagline" placeholder="e.g. A composer's insight into a composer's mind">
      </div>
      <div class="form-group">
        <label for="page-hero-desc">Hero Description</label>
        <textarea id="page-hero-desc" rows="2" placeholder="Short paragraph shown in the hero banner"></textarea>
      </div>
      <div class="toggle-row">
        <input type="checkbox" id="page-enabled">
        <label for="page-enabled">Page is live and publicly visible</label>
      </div>
    </div>

    <!-- STEP 2: Event Details -->
    <div class="wizard-step" id="step-2">
      <div class="form-row">
        <div class="form-group">
          <label for="page-venue">Venue</label>
          <input type="text" id="page-venue" placeholder="HCCGC (default if blank)">
        </div>
        <div class="form-group">
          <label for="page-cost-display">Cost</label>
          <input type="text" id="page-cost-display" placeholder="e.g. $15 early / $20 at door">
        </div>
      </div>
      <!-- Event-only date/time -->
      <div id="step2-event-fields">
        <div class="form-row">
          <div class="form-group">
            <label for="page-date">Date</label>
            <input type="date" id="page-date">
          </div>
          <div class="form-group">
            <label for="page-from-time">Start Time</label>
            <input type="text" id="page-from-time" placeholder="e.g. 6:30 PM">

async function loadCommunicationsDashboard() {
  try {
    const res = await authedFetch(API_BASE + '/communications/dashboard');
    const data = await res.json();
    if (!res.ok) throw new Error((data.errors || ['Server returned ' + res.status]).join(' '));

    document.getElementById('stat-total-patrons').textContent = data.contactCounts.totalPatrons.toLocaleString();
    document.getElementById('stat-unique-emails').textContent = data.contactCounts.uniqueEmails.toLocaleString();
    document.getElementById('stat-unique-phones').textContent = data.contactCounts.uniquePhones.toLocaleString();
    document.getElementById('stat-unique-addresses').textContent = data.contactCounts.uniqueAddresses.toLocaleString();
    document.getElementById('stat-repeat-patrons').textContent = data.repeatPatrons.toLocaleString();

    renderMomChart(data.monthOverMonth);
    renderBarChart('dash-campaign-chart', data.campaignVolume.map(function (c) { return { name: c.campaign, total: c.uniquePatrons }; }), 'No campaign activity yet.');
    renderDonorList('dash-top-value', data.topByValue, function (d) { return moneyRound(d.total); }, 'No donors yet.');
    renderDonorList('dash-top-frequency', data.topByFrequency, function (d) { return d.giftCount + ' gift' + (d.giftCount === 1 ? '' : 's'); }, 'No donors yet.');

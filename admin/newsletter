async function loadHistory() {
  var el = document.getElementById('hist-list');
  el.innerHTML = '<div class="empty-state">Loading…</div>';
  try {
    var r = await authedFetch(API_BASE + '/newsletter/history');
    if (r.status === 404) {
      el.innerHTML = '<div class="card"><div class="empty-state">Sent history switches on once <code>/newsletter/history</code> is deployed.</div></div>';
      return;
    }
    var rows = await r.json();
    if (!Array.isArray(rows) || !rows.length) { el.innerHTML = '<div class="card"><div class="empty-state">Nothing sent yet.</div></div>'; return; }
    el.innerHTML = '<div class="card">' + rows.map(function (n) {
      var pct = function (x) { return n.sentCount ? Math.round(x / n.sentCount * 100) : 0; };
      return '<div style="border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;margin-bottom:8px;">' +
        '<div style="font-weight:700;font-size:0.9rem;">' + escHtml(n.subject || n.newsletterTitle || '(no subject)') + '</div>' +
        '<div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:6px;font-size:0.8rem;">' +
          '<span>Sent <strong>' + (n.sentCount || 0) + '</strong></span>' +
          '<span style="color:var(--green);">Opened <strong>' + (n.opened || 0) + '</strong> (' + pct(n.opened || 0) + '%)</span>' +
          (n.unsubscribed ? '<span style="color:var(--red);">Unsubscribed <strong>' + n.unsubscribed + '</strong></span>' : '') +
        '</div>' +
        '<div style="font-size:0.76rem;color:var(--muted);margin-top:4px;">' + escHtml(n.sentBy || '') + ' · ' + escHtml(fmtDate(n.sentAt)) + '</div>' +
      '</div>';
    }).join('') + '</div>';
  } catch (err) {
    el.innerHTML = '<div class="card"><div class="empty-state">Could not load: ' + escHtml(err.message) + '</div></div>';
  }
}

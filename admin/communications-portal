var db = getFirestore(fbApp);

function showGate(title, msg) {
  document.getElementById('gate').querySelector('h3').textContent = title;
  document.getElementById('gate').querySelector('p').innerHTML = msg;
  document.getElementById('gate').style.display = 'flex';
  document.getElementById('app').style.display = 'none';
}

onAuthStateChanged(auth, function(user) {
  if (!user) { showGate('Sign in required', 'Please sign in from the <a href="'+PORTAL_URL+'">Admin Portal</a> first.'); return; }
  var email = (user.email||'').toLowerCase();
  window.__hccgcCurrentUser = { email: email };
  window.__hccgcFirebaseUser = user;
  if (!email.endsWith('@'+ALLOWED_DOMAIN)) { showGate('Access denied', 'Please use an @'+ALLOWED_DOMAIN+' account.'); return; }
  getDoc(doc(db, 'portalUsers', email)).then(function(snap) {
    var data = snap.exists() ? snap.data() : {};
    if (!data.isAdmin && !(Array.isArray(data.allowedApps) && data.allowedApps.includes(REQUIRED_APP_KEY))) {
      showGate('Access not granted', "You don't have access to Communications. Ask an admin to grant it.");
      return;
    }
    document.getElementById('gate').style.display = 'none';
    document.getElementById('app').style.display = 'block';
    loadCommunicationsDashboard();
  }).catch(function() { showGate('Error', 'Could not verify access. Please try again.'); });
});
/* ── Social Broadcast ───────────────────────────────────────────────── */
async function loadSocialStatus() {
  var el = document.getElementById('social-status');
  try {
    var res = await authedFetch(API_BASE + '/social/status');
    var d = await res.json();
    if (!d.tokenConfigured) {
      el.innerHTML = '<span style="color:var(--red);font-weight:700;">Not connected</span> — add a Page access token in Admin of Admin \u2192 System Settings.';
      return;
    }
    if (!d.ready) {
      // Tokens expire roughly every 60 days; say so plainly rather than
      // letting the first failed post be the discovery.
      // The reason from the server is already specific; appending a generic
      // "it may have expired" contradicted it and read as two messages.
      el.innerHTML = '<span style="color:var(--red);font-weight:700;">Token problem</span> — ' + escHtml(d.reason || 'Unknown problem with the saved token.');
      return;
    }
    el.innerHTML = '<span style="color:var(--green);font-weight:700;">Connected</span> \u00b7 ' + escHtml(d.pageName || 'Page') +
      (d.instagramConnected ? ' \u00b7 Instagram linked' : ' \u00b7 <span style="color:var(--amber,#b5750a);">no Instagram linked</span>');
    if (!d.instagramConnected) document.getElementById('social-ig').disabled = true;
  } catch (err) {
    el.textContent = 'Could not check connection: ' + err.message;
  }
}
document.querySelectorAll('[data-tab="broadcast"]').forEach(function (b) {
  b.addEventListener('click', function () { loadSocialStatus(); loadSocialHistory(); });
});
document.getElementById('social-message').addEventListener('input', function () {
  document.getElementById('social-char-count').textContent = this.value.length;
});
document.getElementById('social-image-file').addEventListener('change', async function (e) {
  var file = e.target.files[0];
  if (!file) return;
  var hint = document.getElementById('social-image-hint');
  var orig = hint.textContent;
  hint.textContent = 'Uploading\u2026';
  try {
    var base64 = await new Promise(function (resolve, reject) {
      var r = new FileReader();
      r.onload = function () { resolve(String(r.result).split(',')[1]); };
      r.onerror = reject;
      r.readAsDataURL(file);
    });
    var res = await authedFetch(API_BASE + '/pages/image-upload', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ base64: base64, filename: file.name, mimeType: file.type })
    });
    var data = await res.json();
    if (!res.ok) { hint.textContent = (data.errors || [data.error]).join(' ') || 'Upload failed.'; return; }
    document.getElementById('social-image-url').value = data.imageUrl;
    document.getElementById('social-image-img').src = data.imageUrl;
    document.getElementById('social-image-preview').style.display = 'block';
    hint.textContent = orig;
  } catch (err) { hint.textContent = 'Upload failed: ' + err.message; }
});
document.getElementById('social-remove-image').addEventListener('click', function () {
  document.getElementById('social-image-url').value = '';
  document.getElementById('social-image-file').value = '';
  document.getElementById('social-image-preview').style.display = 'none';
});
document.getElementById('btn-social-post').addEventListener('click', async function () {
  var btn = this;
  var box = document.getElementById('social-result');
  var platforms = [];
  if (document.getElementById('social-fb').checked) platforms.push('facebook');
  if (document.getElementById('social-ig').checked) platforms.push('instagram');
  var payload = {
    message: document.getElementById('social-message').value,
    imageUrl: document.getElementById('social-image-url').value,
    platforms: platforms
  };
  box.style.display = 'block'; box.className = 'result-box';
  box.textContent = 'Posting\u2026';
  btn.disabled = true;
  try {
    var res = await authedFetch(API_BASE + '/social/post', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    var data = await res.json();
    if (!res.ok) { box.className = 'result-box error'; box.textContent = (data.errors || [data.error]).join(' '); return; }
    // Each platform reports separately — one can succeed while the other
    // fails, and hiding that behind a single status would be misleading.
    var lines = Object.keys(data.results).map(function (k) {
      var r = data.results[k];
      return (r.status === 'sent' ? '\u2713 ' : '\u2717 ') + k + (r.status === 'sent' ? ' posted' : ': ' + r.error);
    });
    var anyFailed = Object.keys(data.results).some(function (k) { return data.results[k].status !== 'sent'; });
    box.className = 'result-box ' + (anyFailed ? 'error' : 'success');
    box.textContent = lines.join('  |  ');
    if (!anyFailed) {
      document.getElementById('social-message').value = '';
      document.getElementById('social-char-count').textContent = '0';
      document.getElementById('social-remove-image').click();
    }
    loadSocialHistory();
  } catch (err) {
    box.className = 'result-box error'; box.textContent = 'Could not reach the server: ' + err.message;
  } finally { btn.disabled = false; }
});
document.getElementById('btn-social-refresh').addEventListener('click', loadSocialHistory);
async function loadSocialHistory() {
  var el = document.getElementById('social-history');
  el.innerHTML = '<div class="empty-state">Loading\u2026</div>';
  try {
    var res = await authedFetch(API_BASE + '/social/history');
    var rows = await res.json();
    if (!rows.length) { el.innerHTML = '<div class="empty-state">Nothing posted yet.</div>'; return; }
    el.innerHTML = rows.map(function (r) {
      return '<div style="border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;margin-bottom:8px;">' +
        '<div style="display:flex;justify-content:space-between;gap:10px;">' +
          '<strong style="font-size:.86rem;">' + escHtml(r.platform) + '</strong>' +
          '<span style="font-size:.78rem;color:' + (r.status === 'sent' ? 'var(--green)' : 'var(--red)') + ';font-weight:700;">' + escHtml(r.status) + '</span>' +
        '</div>' +
        '<div style="font-size:.84rem;margin-top:4px;white-space:pre-wrap;">' + escHtml((r.message || '').slice(0, 160)) + '</div>' +
        (r.errorMessage ? '<div style="font-size:.78rem;color:var(--red);margin-top:4px;">' + escHtml(r.errorMessage) + '</div>' : '') +
        '<div style="font-size:.76rem;color:var(--muted);margin-top:4px;">' + escHtml(r.postedBy) + ' \u00b7 ' + formatTimestampDate(r.postedAt) + '</div>' +
      '</div>';
    }).join('');
  } catch (err) {
    el.innerHTML = '<div class="empty-state">Could not load: ' + escHtml(err.message) + '</div>';
  }
}

</script>

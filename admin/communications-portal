      if (d.instagramReason) el.innerHTML += '<div style="font-size:0.78rem;color:var(--muted);margin-top:4px;">' + escHtml(d.instagramReason) + '</div>';
    }
  } catch (err) {
    el.textContent = 'Could not check connection: ' + err.message;
  }
}

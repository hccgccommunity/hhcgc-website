async function submitCreateInvoice(alsoSend, btn) {
  const renterId = document.getElementById('create-inv-renter').value;
  const description = document.getElementById('create-inv-description').value.trim();
  const amount = parseFloat(document.getElementById('create-inv-amount').value);
  const dueDate = document.getElementById('create-inv-duedate').value;
  const resultBox = document.getElementById('create-invoice-result');
  if (!renterId || !description || !amount || amount <= 0) {
    resultBox.style.display = 'block'; resultBox.className = 'result-box error';
    resultBox.textContent = 'Choose a customer and fill in description and amount.'; return;
  }
  const originalText = btn.textContent;
  btn.disabled = true; btn.textContent = 'Creating…';
  try {
    const createRes = await authedFetch(API_BASE + '/finance/create-invoice', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ renterId, description, amount, dueDate })
    });
    const createData = await createRes.json();
    if (!createRes.ok) {
      resultBox.style.display = 'block'; resultBox.className = 'result-box error';
      resultBox.textContent = (createData.errors || [createData.error]).join(' ') || 'unknown error';
      return;
    }
    if (alsoSend) {
      btn.textContent = 'Sending…';
      const sendRes = await authedFetch(API_BASE + '/bookings/' + encodeURIComponent(createData.bookingId) + '/send-invoice', { method: 'POST' });
      const sendData = await sendRes.json();
      if (!sendRes.ok) {
        resultBox.style.display = 'block'; resultBox.className = 'result-box error';
        resultBox.textContent = 'Invoice created but could not be sent: ' + ((sendData.errors || [sendData.error]).join(' ') || 'unknown error') + '. Reference: ' + createData.bookingId;
        return;
      }
    }
    document.getElementById('create-invoice-overlay').style.display = 'none';
    await loadInvoices();
  } catch (err) {
    resultBox.style.display = 'block'; resultBox.className = 'result-box error';
    resultBox.textContent = 'Could not reach the server: ' + err.message;
  } finally {
    btn.disabled = false; btn.textContent = originalText;
  }
}

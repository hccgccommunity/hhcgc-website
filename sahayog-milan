          // asynchronously, so this runs a few times rather than once.
          function tidyEmbeddedFrames() {
            document.querySelectorAll('.embed-card iframe').forEach(function (frame) {
              frame.setAttribute('scrolling', 'no');
              frame.style.overflow = 'hidden';
              frame.style.display = 'block';
              frame.style.width = '100%';
              frame.style.border = '0';
            });
          }
          window.addEventListener('load', tidyEmbeddedFrames);

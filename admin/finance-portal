document.getElementById('exp-review-details').addEventListener('click', async function (e) {
  const markBtn = e.target.closest('[data-mark-expense-paid]');
  const findBtn = e.target.closest('[data-find-expense-match]');
  const btn = markBtn || findBtn;
  if (!btn) return;
  e.stopPropagation();
  const lineItemId = markBtn ? markBtn.dataset.markExpensePaid : findBtn.dataset.findExpenseMatch;
  const candidatesEl = document.getElementById('match-candidates-' + lineItemId);
  btn.disabled = true; btn.textContent = markBtn ? 'Marking paid…' : 'Searching…';
  try {
    const url = markBtn
      ? API_BASE + '/finance/expense-line-items/' + encodeURIComponent(lineItemId) + '/mark-paid'
      : API_BASE + '/finance/reimbursement-candidates?amount=' + encodeURIComponent(currentReviewSubmission.items.find(function (i) { return i.line_item_id === lineItemId; }).amount);
    const res = await authedFetch(url, { method: markBtn ? 'POST' : 'GET' });
    const data = await res.json();
    if (!res.ok) { candidatesEl.innerHTML = '<div style="color:var(--red);font-size:0.78rem;">' + ((data.errors || [data.error]).join(' ') || 'Could not complete this.') + '</div>'; return; }
    // markBtn's response shape is { candidates: [...] } from mark-paid;
    // findBtn's is a bare array from reimbursement-candidates - either
    // way, render whatever came back the same way.
    const candidates = markBtn ? (data.candidates || []) : data;
    if (markBtn) {
      const item = currentReviewSubmission.items.find(function (i) { return i.line_item_id === lineItemId; });
      if (item) item.status = 'paid';
    }
    if (!candidates.length) {
      candidatesEl.innerHTML = '<div style="font-size:0.78rem;color:var(--muted);">No matching bank transaction found yet — you can try again later once it clears.</div>';
      if (markBtn) renderExpenseReviewDetails();
      return;
    }
    candidatesEl.innerHTML = '<div style="font-size:0.78rem;color:var(--muted);margin:4px 0;">Possible matching transaction' + (candidates.length > 1 ? 's' : '') + ':</div>' +
      candidates.map(function (c, idx) {
        return '<div class="exp-line-item" style="padding:8px 10px;cursor:pointer;" data-confirm-match-line="' + lineItemId + '" data-confirm-match-idx="' + idx + '">' +
          '<div class="exp-top-row"><span>' + escHtml(c.description) + '</span><span>' + money(Math.abs(c.amount)) + '</span></div>' +
          '<div class="exp-date">' + formatDate(c.date) + '</div>' +
        '</div>';
      }).join('');
    candidatesEl.dataset.candidates = JSON.stringify(candidates);
    if (markBtn) renderExpenseReviewDetails();
  } catch (err) {
    candidatesEl.innerHTML = '<div style="color:var(--red);font-size:0.78rem;">Could not reach the server: ' + escHtml(err.message) + '</div>';
  } finally {
    if (btn.isConnected) { btn.disabled = false; btn.textContent = markBtn ? 'Mark paid' : 'Find matching transaction'; }
  }
});
document.getElementById('exp-review-details').addEventListener('click', async function (e) {

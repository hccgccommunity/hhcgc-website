/* ── Email Blast ────────────────────────────────────────────────────── */
var EB_SEG = { languages: [], events: [], campaigns: [] };
var EB_OPTS = { languages: [], events: [], campaigns: [] };
var EB_REACH_TIMER = null;

async function loadBlastOptions() {
  try {
    var res = await authedFetch(API_BASE + '/blast/segment-options');
    var d = await res.json();
    EB_OPTS.languages = (d.languages || []).map(function (v) { return { name: v }; });
    EB_OPTS.events = d.events || [];
    EB_OPTS.campaigns = d.campaigns || [];
    ['languages', 'events', 'campaigns'].forEach(renderMultiSelect);
    refreshReach();
  } catch (err) {
    document.getElementById('eb-reach').textContent = 'Could not load filters';
  }
}

// Multi-select with an explicit "All" row. A dropdown keeps long lists
// manageable — chips wrapped over several rows once there were more than
// a handful of events.
function renderMultiSelect(key) {
  var menu = document.getElementById('eb-ms-' + key);
  var opts = EB_OPTS[key] || [];
  if (!opts.length) { menu.innerHTML = '<div style="padding:8px;font-size:0.8rem;color:var(--muted);">None available</div>'; return; }
  var allOn = EB_SEG[key].length === 0;
  menu.innerHTML =
    '<label class="eb-ms-opt all"><input type="checkbox" data-ms-all="' + key + '"' + (allOn ? ' checked' : '') + '> All</label>' +
    opts.map(function (o) {
      var on = EB_SEG[key].indexOf(o.name) !== -1;
      return '<label class="eb-ms-opt"><input type="checkbox" data-ms-key="' + key + '" value="' + escHtml(o.name) + '"' + (on ? ' checked' : '') + '>' +
        escHtml(o.name) + (o.patrons ? '<span class="n">' + o.patrons + '</span>' : '') + '</label>';
    }).join('');
  updateMultiLabel(key);
}
function updateMultiLabel(key) {
  var btn = document.querySelector('[data-ms-toggle="' + key + '"] span');
  if (!btn) return;
  var sel = EB_SEG[key];
  var noun = key === 'languages' ? 'languages' : (key === 'events' ? 'events' : 'campaigns');
  btn.textContent = !sel.length ? ('All ' + noun)
    : (sel.length === 1 ? sel[0] : sel.length + ' ' + noun + ' selected');
}
document.addEventListener('click', function (e) {
  var toggle = e.target.closest('[data-ms-toggle]');
  document.querySelectorAll('.eb-ms-menu.open').forEach(function (m) {
    if (!toggle || m.id !== 'eb-ms-' + toggle.dataset.msToggle) m.classList.remove('open');
  });
  if (toggle) {
    document.getElementById('eb-ms-' + toggle.dataset.msToggle).classList.toggle('open');
    return;
  }
  if (e.target.closest('.eb-ms-menu')) return;
});
document.addEventListener('change', function (e) {
  var all = e.target.closest('[data-ms-all]');
  if (all) {
    var k = all.dataset.msAll;
    EB_SEG[k] = [];
    renderMultiSelect(k);
    document.getElementById('eb-ms-' + k).classList.add('open');
    refreshReach();
    return;
  }
  var opt = e.target.closest('[data-ms-key]');
  if (opt) {
    var key = opt.dataset.msKey, val = opt.value;
    var i = EB_SEG[key].indexOf(val);
    if (opt.checked && i === -1) EB_SEG[key].push(val);
    if (!opt.checked && i !== -1) EB_SEG[key].splice(i, 1);
    // Keep the "All" row honest without redrawing the open menu.
    var allBox = document.querySelector('[data-ms-all="' + key + '"]');
    if (allBox) allBox.checked = EB_SEG[key].length === 0;
    updateMultiLabel(key);
    refreshReach();
  }
});

function currentSegment() {
  var seg = {
    languages: EB_SEG.languages.slice(),
    events: EB_SEG.events.slice(),
    campaigns: EB_SEG.campaigns.slice()
  };
  if (document.getElementById('eb-has-given').checked) seg.hasGiven = true;
  var mn = document.getElementById('eb-min-age').value;
  var mx = document.getElementById('eb-max-age').value;
  if (mn) seg.minAge = Number(mn);
  if (mx) seg.maxAge = Number(mx);
  return seg;
}
function refreshReach() {
  clearTimeout(EB_REACH_TIMER);
  EB_REACH_TIMER = setTimeout(async function () {
    var el = document.getElementById('eb-reach');
    el.textContent = 'Counting\u2026';
    try {
      var res = await authedFetch(API_BASE + '/blast/reach', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ segment: currentSegment() })
      });
      var d = await res.json();
      el.textContent = res.ok ? ('Reaches ' + d.reach + ' ' + (d.reach === 1 ? 'person' : 'people')) : 'Could not count';
    } catch (e) { el.textContent = 'Could not count'; }
  }, 300);
}
['eb-has-given', 'eb-min-age', 'eb-max-age'].forEach(function (id) {
  document.getElementById(id).addEventListener('input', refreshReach);
});
document.getElementById('eb-clear-seg').addEventListener('click', function () {
  EB_SEG = { languages: [], events: [], campaigns: [] };
  ['languages', 'events', 'campaigns'].forEach(renderMultiSelect);
  document.getElementById('eb-has-given').checked = false;
  document.getElementById('eb-min-age').value = '';
  document.getElementById('eb-max-age').value = '';
  refreshReach();
});

/* Editor */
var ebBody = document.getElementById('eb-body');
function ebExec(cmd, val) { ebBody.focus(); document.execCommand(cmd, false, val || null); syncPreview(); }
document.querySelectorAll('[data-eb-cmd]').forEach(function (b) {
  b.addEventListener('click', function () { ebExec(this.dataset.ebCmd); });
});
document.querySelectorAll('[data-eb-block]').forEach(function (b) {
  b.addEventListener('click', function () { ebExec('formatBlock', '<' + this.dataset.ebBlock + '>'); });
});
document.getElementById('eb-color').addEventListener('input', function () { ebExec('foreColor', this.value); });
// hiliteColor is the standard; some engines only honour backColor.
document.getElementById('eb-highlight').addEventListener('input', function () {
  ebBody.focus();
  if (!document.execCommand('hiliteColor', false, this.value)) document.execCommand('backColor', false, this.value);
  syncPreview();
});
document.getElementById('eb-size').addEventListener('change', function () { if (this.value) ebExec('fontSize', this.value); this.value = ''; });
document.getElementById('eb-var').addEventListener('change', function () {
  if (!this.value) return;
  ebBody.focus(); document.execCommand('insertText', false, this.value); this.value = ''; syncPreview();
});
document.getElementById('eb-add-link').addEventListener('click', function () {
  var url = window.prompt('Link address:', 'https://hccgc.org/');
  if (url) ebExec('createLink', url);
});
document.getElementById('eb-add-image').addEventListener('click', function () {
  // Remember where the cursor was: opening the file picker moves focus out
  // of the editor, and without this the image lands at the start instead
  // of where the person was typing.
  var sel = window.getSelection();
  EB_SAVED_RANGE = (sel && sel.rangeCount && ebBody.contains(sel.anchorNode)) ? sel.getRangeAt(0).cloneRange() : null;
  document.getElementById('eb-image-file').click();
});
var EB_SAVED_RANGE = null;
document.getElementById('eb-image-file').addEventListener('change', async function (e) {
  var file = e.target.files[0];
  if (!file) return;
  var box = document.getElementById('eb-result');
  box.style.display = 'block'; box.className = 'result-box'; box.textContent = 'Uploading image\u2026';
  try {
    var base64 = await new Promise(function (resolve, reject) {
      var r = new FileReader();
      r.onload = function () { resolve(String(r.result).split(',')[1]); };
      r.onerror = reject;
      r.readAsDataURL(file);
    });
    var res = await authedFetch(API_BASE + '/pages/image-upload', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ base64: base64, filename: file.name, mimeType: file.type })
    });
    var data = await res.json();
    if (!res.ok) { box.className = 'result-box error'; box.textContent = (data.errors || [data.error]).join(' ') || 'Upload failed.'; return; }

    ebBody.focus();
    if (EB_SAVED_RANGE) {
      var s = window.getSelection();
      s.removeAllRanges(); s.addRange(EB_SAVED_RANGE);
    }
    // Width is set as an attribute as well as a style: Outlook ignores
    // max-width on images, and an unconstrained flyer blows the layout out.
    document.execCommand('insertHTML', false,
      '<img src="' + data.imageUrl.replace(/"/g, '&quot;') + '" width="560" ' +
      'style="max-width:100%;height:auto;border-radius:8px;display:block;margin:14px auto;">');
    syncPreview();
    box.style.display = 'none';
  } catch (err) {
    box.className = 'result-box error'; box.textContent = 'Upload failed: ' + err.message;
  } finally {
    this.value = '';
    EB_SAVED_RANGE = null;
  }
});
document.getElementById('eb-add-button').addEventListener('click', function () {
  var label = window.prompt('Button text:', 'RSVP now');
  if (!label) return;
  var url = window.prompt('Where should it link to?', 'https://hccgc.org/forms/');
  if (!url) return;
  // Inline styles: email clients strip <style> blocks and ignore classes.
  ebExec('insertHTML',
    '<div style="text-align:center;margin:22px 0;"><a href="' + url.replace(/"/g, '&quot;') +
    '" style="display:inline-block;background:#b55a18;color:#ffffff;padding:13px 30px;border-radius:999px;' +
    'font-weight:bold;text-decoration:none;font-family:Arial,Helvetica,sans-serif;">' + escHtml(label) + '</a></div><p><br></p>');
});

function syncPreview() {
  var subj = document.getElementById('eb-subject').value.trim();
  document.getElementById('eb-preview-subject').textContent = subj || '(no subject)';
  var html = ebBody.innerHTML
    .replace(/(^|[^\w@])@first_name\b/g, '$1Priya')
    .replace(/(^|[^\w@])@name\b/g, '$1Priya Deshpande')
    .split('{{first_name}}').join('Priya').split('{{name}}').join('Priya Deshpande');
  document.getElementById('eb-preview-body').innerHTML = html || '<span style="color:#a89684;">Your message will appear here\u2026</span>';
}
ebBody.addEventListener('input', syncPreview);
ebBody.addEventListener('keyup', syncPreview);
document.getElementById('eb-subject').addEventListener('input', syncPreview);

async function doBlastSend(testOnly) {
  var box = document.getElementById('eb-result');
  var subject = document.getElementById('eb-subject').value.trim();
  var bodyHtml = ebBody.innerHTML.trim();
  if (!subject) { box.style.display='block'; box.className='result-box error'; box.textContent='Add a subject.'; return; }
  if (!bodyHtml) { box.style.display='block'; box.className='result-box error'; box.textContent='The message is empty.'; return; }
  if (!testOnly && !window.confirm(
      'Send this to the FULL list?\n\n' + document.getElementById('eb-reach').textContent +
      '\n\nThis is not a test. It cannot be undone.')) return;
  box.style.display='block'; box.className='result-box'; box.textContent = testOnly ? 'Sending test\u2026' : 'Sending\u2026';
  try {
    var res = await authedFetch(API_BASE + '/blast/send', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ subject: subject, bodyHtml: bodyHtml, segment: currentSegment(), testOnly: !!testOnly })
    });
    var d = await res.json();
    if (!res.ok) { box.className='result-box error'; box.textContent=(d.errors||[d.error]).join(' '); return; }
    box.className='result-box success';
    box.textContent = d.test
      ? 'Test sent to you only (' + d.sent + ' of 1). Nobody else received it.'
      : 'Sent to ' + d.sent + ' of ' + d.recipientCount + (d.failed ? ' \u00b7 ' + d.failed + ' failed' : '') + '.';
    if (!d.test) loadBlastHistory();
  } catch (err) {
    box.className='result-box error'; box.textContent='Could not reach the server: ' + err.message;
  }
}
document.getElementById('btn-eb-send').addEventListener('click', function () { doBlastSend(false); });
document.getElementById('btn-eb-test').addEventListener('click', function () { doBlastSend(true); });
document.getElementById('btn-eb-draft').addEventListener('click', async function () {
  var box = document.getElementById('eb-result');
  box.style.display = 'block'; box.className = 'result-box'; box.textContent = 'Saving\u2026';
  try {
    var res = await authedFetch(API_BASE + '/blast/draft', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        subject: document.getElementById('eb-subject').value,
        bodyHtml: ebBody.innerHTML,
        segment: currentSegment()
      })
    });
    var d = await res.json();
    box.className = res.ok ? 'result-box success' : 'result-box error';
    box.textContent = res.ok ? 'Draft saved. It will be here when you come back.' : (d.errors || [d.error]).join(' ');
  } catch (err) {
    box.className = 'result-box error'; box.textContent = 'Could not save: ' + err.message;
  }
});
async function loadBlastDraft() {
  try {
    var res = await authedFetch(API_BASE + '/blast/draft');
    var d = await res.json();
    if (!res.ok || !d.draft) return;
    if (document.getElementById('eb-subject').value || ebBody.innerHTML.trim()) return; // don't clobber work in progress
    document.getElementById('eb-subject').value = d.draft.subject || '';
    ebBody.innerHTML = d.draft.bodyHtml || '';
    var s = d.draft.segment || {};
    EB_SEG.languages = s.languages || []; EB_SEG.events = s.events || []; EB_SEG.campaigns = s.campaigns || [];
    syncPreview();
  } catch (e) { /* a missing draft must never block the tab */ }
}
document.getElementById('btn-eb-refresh').addEventListener('click', loadBlastHistory);

async function loadBlastHistory() {
  var el = document.getElementById('eb-history');
  el.innerHTML = '<div class="empty-state">Loading\u2026</div>';
  try {
    var res = await authedFetch(API_BASE + '/blast/history');
    var rows = await res.json();
    if (!rows.length) { el.innerHTML = '<div class="empty-state">Nothing sent yet.</div>'; return; }
    el.innerHTML = rows.map(function (r) {
      var pct = function (n) { return r.sentCount ? Math.round(n / r.sentCount * 100) : 0; };
      return '<div style="border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;margin-bottom:8px;">' +
        '<div style="font-weight:700;font-size:0.9rem;">' + escHtml(r.subject) + '</div>' +
        '<div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:6px;font-size:0.8rem;">' +
          '<span>Sent <strong>' + r.sentCount + '</strong></span>' +
          '<span style="color:var(--green);">Opened <strong>' + r.opened + '</strong> (' + pct(r.opened) + '%)</span>' +
          '<span style="color:var(--saffron-dark);">Clicked <strong>' + r.clicked + '</strong> (' + pct(r.clicked) + '%)</span>' +
          (r.unsubscribed ? '<span style="color:var(--red);">Unsubscribed <strong>' + r.unsubscribed + '</strong></span>' : '') +
        '</div>' +
        '<div style="font-size:0.76rem;color:var(--muted);margin-top:4px;">' + escHtml(r.sentBy || '') + ' \u00b7 ' + formatTimestampDate(r.sentAt) + '</div>' +
      '</div>';
    }).join('');
  } catch (err) {
    el.innerHTML = '<div class="empty-state">Could not load: ' + escHtml(err.message) + '</div>';
  }
}

document.querySelectorAll('.tab-btn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.remove('active'); });
    document.querySelectorAll('.tab-panel').forEach(function (p) { p.classList.remove('active'); });
    btn.classList.add('active');
    var panel = document.getElementById('tab-' + btn.dataset.tab);
    if (panel) panel.classList.add('active');
    if (btn.dataset.tab === 'broadcast') { loadSocialStatus(); loadSocialHistory(); }
    if (btn.dataset.tab === 'mass-email') { loadBlastOptions(); loadBlastHistory(); loadBlastDraft(); }
  });
});

</script>


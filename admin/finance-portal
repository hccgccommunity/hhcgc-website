[['rental', 'tx-rental-tbody'], ['fundraising', 'tx-fundraising-tbody'], ['donations', 'tx-donations-tbody'],
 ['zeffy-refunds', 'tx-zeffy-refunds-tbody'], ['zelle', 'tx-zelle-tbody'], ['other', 'tx-other-tbody']].forEach(function (pair) {
  var prefix = pair[0], tbodyId = pair[1];
  function updateBulkBar() {
    var checked = document.querySelectorAll('#' + tbodyId + ' [data-row-checkbox]:checked');
    var bar = document.getElementById(prefix + '-bulk-bar');
    if (checked.length) {
      bar.style.display = 'flex';
      document.getElementById(prefix + '-selected-count').textContent = checked.length;
    } else {
      bar.style.display = 'none';
    }
  }
  var selectAll = document.getElementById('tx-' + prefix + '-select-all');
  if (selectAll) {
    selectAll.addEventListener('change', function () {
      document.querySelectorAll('#' + tbodyId + ' [data-row-checkbox]').forEach(function (cb) { cb.checked = selectAll.checked; });
      updateBulkBar();
    });
  }
  document.getElementById(tbodyId).addEventListener('change', function (e) {
    if (e.target.matches('[data-row-checkbox]')) updateBulkBar();
  });
  var bulkBtn = document.querySelector('[data-bulk-review-prefix="' + prefix + '"]');
  if (bulkBtn) {
    bulkBtn.addEventListener('click', async function () {
      var checked = Array.from(document.querySelectorAll('#' + tbodyId + ' [data-row-checkbox]:checked'));
      var items = checked.map(function (cb) {
        var parts = cb.dataset.rowCheckbox.split('|');
        return { source: parts[0], sourceKey: parts.slice(1).join('|') };
      });
      if (!items.length) return;
      bulkBtn.disabled = true; var originalText = bulkBtn.textContent; bulkBtn.textContent = 'Marking…';
      try {
        var res = await authedFetch(API_BASE + '/finance/bulk-mark-reviewed', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items })
        });
        var data = await res.json();
        if (!res.ok) { alert('Could not mark reviewed: ' + ((data.errors || [data.error]).join(' ') || 'unknown error')); return; }
        if (data.skipped && data.skipped.length) alert(data.markedCount + ' marked reviewed. ' + data.skipped.length + ' skipped (uncategorized).');
        await loadTransactions();
      } catch (err) {
        alert('Could not reach the server: ' + err.message);
      } finally {
        bulkBtn.disabled = false; bulkBtn.textContent = originalText;
      }
    });
  }

  var splitBtn = document.querySelector('[data-bulk-split-prefix="' + prefix + '"]');
  if (splitBtn) {
    splitBtn.addEventListener('click', function () {
      var checked = Array.from(document.querySelectorAll('#' + tbodyId + ' [data-row-checkbox]:checked'));
      if (checked.length !== 1) { alert('Select exactly one transaction to split.'); return; }
      var rowId = checked[0].dataset.rowCheckbox;
      var tx = TRANSACTIONS.find(function (t) { return (t.source + '|' + t.sourceKey) === rowId; });
      if (!tx) return;
      openSplitModal(tx);
    });
  }

  var mergeBtn = document.querySelector('[data-bulk-merge-prefix="' + prefix + '"]');
  if (mergeBtn) {
    mergeBtn.addEventListener('click', function () {
      var checked = Array.from(document.querySelectorAll('#' + tbodyId + ' [data-row-checkbox]:checked'));
      if (checked.length < 2) { alert('Select at least two transactions of the same type (both debits or both credits) to merge.'); return; }
      var txs = checked.map(function (cb) {
        var rowId = cb.dataset.rowCheckbox;
        return TRANSACTIONS.find(function (t) { return (t.source + '|' + t.sourceKey) === rowId; });
      }).filter(Boolean);
      openMergeModal(txs);
    });
  }
});


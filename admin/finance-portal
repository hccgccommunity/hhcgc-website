function groupInvoicesIntoDisplayItems(list) {
  const seriesMap = {};
  const items = [];
  list.forEach(function (inv) {
    if (inv.seriesId) {
      // ALWAYS one top-level row per series, whatever the billing mode.
      // Splitting monthly into a row per month made Finance show 3 rows
      // where Facility Bookings showed one series of 8 — the two portals
      // must agree. Monthly gets an extra MONTH level inside the expansion
      // instead (see renderInvoicesTable).
      if (!seriesMap[inv.seriesId]) {
        const item = { type: 'series', seriesId: inv.seriesId, groupKey: inv.seriesId, occurrences: [] };
        seriesMap[inv.seriesId] = item;
        items.push(item);
      }
      seriesMap[inv.seriesId].occurrences.push(inv);
    } else {
      items.push({ type: 'single', invoice: inv });
    }
  });
  items.forEach(function (item) {
    if (item.type !== 'series') return;
    const occ = item.occurrences.slice().sort(function (a, b) { return a.eventDate < b.eventDate ? -1 : (a.eventDate > b.eventDate ? 1 : 0); });
    item.occurrences = occ;
    const first = occ[0];
    item.renterName = first.renterName;
    item.renterEmail = first.renterEmail;
    item.eventName = first.eventName;
    item.eventDate = first.eventDate;
    item.eventDateLast = occ[occ.length - 1].eventDate;
    item.amount = occ.reduce(function (sum, o) { return sum + Number(o.amount); }, 0);
    item.paymentStatus = occ.every(function (o) { return o.paymentStatus === first.paymentStatus; }) ? first.paymentStatus : 'mixed';
    item.paidCount = occ.filter(function (o) { return o.paymentStatus === 'paid'; }).length;
    item.invoiceSentAt = occ.reduce(function (latest, o) { return (!latest || (o.invoiceSentAt && o.invoiceSentAt > latest)) ? o.invoiceSentAt : latest; }, first.invoiceSentAt);
    item.recurrenceSummary = first.recurrenceSummary || (occ.length + ' occurrences');
    // Must match the Facility Rental portal EXACTLY, or the two group the
    // same booking differently. Both take the earliest occurrence's mode.
    item.invoiceMode = first.invoiceMode || 'combined';
    // For monthly, pre-bucket the occurrences by calendar month. Each
    // bucket is one invoice.
    if (item.invoiceMode === 'monthly') {
      const buckets = {};
      occ.forEach(function (o) {
        const m = String(o.eventDate || '').slice(0, 7);
        if (!buckets[m]) buckets[m] = { month: m, occurrences: [] };
        buckets[m].occurrences.push(o);
      });
      item.months = Object.keys(buckets).sort().map(function (m) {
        const b = buckets[m];
        b.amount = b.occurrences.reduce(function (s, o) { return s + Number(o.amount); }, 0);
        b.rep = b.occurrences[0];
        b.invoiceSentAt = b.occurrences.reduce(function (l, o) { return (!l || (o.invoiceSentAt && o.invoiceSentAt > l)) ? o.invoiceSentAt : l; }, null);
        b.receiptSentAt = b.occurrences.reduce(function (l, o) { return (!l || (o.receiptSentAt && o.receiptSentAt > l)) ? o.receiptSentAt : l; }, null);
        b.allPaid = b.occurrences.every(function (o) { return o.paymentStatus === 'paid'; });
        b.label = new Date(m + '-02T00:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
        return b;
      });
    }
    item.invoiceModeMixed = occ.some(function (o) { return (o.invoiceMode || null) !== (first.invoiceMode || null); });
  });
  return items;
}

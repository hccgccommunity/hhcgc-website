// View/Download only — facility-rental invoices are only ever generated
// and sent from the Facility Rental Portal (never here), so there's
// deliberately no Edit or Send option in this popup.
function openFinanceInvoicePopup(bookingId) {
  const inv = INVOICES.find(function (i) { return i.bookingId === bookingId; });
  if (!inv) return;
  const alreadySent = !!inv.invoiceSentAt;
  const body = document.getElementById('invoice-action-body');
  let html = '<button type="button" class="invoice-action-btn" data-fin-inv-action="view">View invoice</button>';
  html += '<button type="button" class="invoice-action-btn primary" data-fin-inv-action="send">' + (alreadySent ? 'Resend invoice' : 'Send invoice') + '</button>';
  html += '<button type="button" class="invoice-action-btn" data-fin-inv-action="download">Download invoice</button>';
  // Voiding is what unlocks editing a booking whose invoice the renter
  // already holds, so it only appears once something has actually been
  // sent — and only for admins, matching the server-side restriction.
  if (alreadySent && window.__hccgcIsAdmin) {
    html += '<button type="button" class="invoice-action-btn" data-fin-inv-action="void" style="color:var(--red);border-color:var(--red);">Void invoice</button>';
  }
  html += alreadySent
    ? '<p class="card-sub" style="margin:6px 0 0;">Sent ' + formatTimestampDate(inv.invoiceSentAt) + '.'
      + (window.__hccgcIsAdmin ? ' Void it to make the booking editable again — the customer is emailed.' : '')
      + '</p>'
    : '<p class="card-sub" style="margin:6px 0 0;">Not sent yet.</p>';
  body.innerHTML = html;
  body.dataset.bookingId = bookingId;
  document.getElementById('invoice-action-overlay').style.display = 'flex';
}
document.getElementById('invoice-action-body').addEventListener('click', async function (e) {
  const btn = e.target.closest('[data-fin-inv-action]');

let __glShowTimer = null;
function __glRequestStart() {
  __glPendingCount++;
  if (__glPendingCount === 1) {
    __glShowTimer = setTimeout(function () {
      var el = document.getElementById('global-loading-overlay');
      if (el) el.classList.add('visible');
    }, 150);
  }
}
function __glRequestEnd() {
  __glPendingCount = Math.max(0, __glPendingCount - 1);
  if (__glPendingCount === 0) {
    clearTimeout(__glShowTimer);
    var el = document.getElementById('global-loading-overlay');
    if (el) el.classList.remove('visible');
  }
}
async function authedFetch(url, options) {
  options = options || {};
  options.headers = Object.assign({}, options.headers, { 'Authorization': 'Bearer ' + await window.__hccgcFirebaseUser.getIdToken() });
  __glRequestStart();
  try {
    return await fetch(url, options);
  } finally {
    __glRequestEnd();
  }
}
function escHtml(s) {
  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function moneyRound(n) { return '$' + Math.round(Number(n)).toLocaleString('en-US'); }


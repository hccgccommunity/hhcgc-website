document.getElementById('btn-save').addEventListener('click', async function() {
  if (!validateStep(currentStep)) return;

  var btn = this;
  var orig = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner"></div> Saving…';

  function parseLines(id) { return document.getElementById(id).value.split('\n').map(l=>l.trim()).filter(Boolean); }
  function parsePiped(id, keys) {
    return parseLines(id).map(line => {
      var parts = line.split('|').map(p=>p.trim());
      var obj = {}; keys.forEach((k,i) => obj[k]=parts[i]||'');
      return obj;
    });
  }

  var isInit = document.getElementById('page-type').value === 'initiative';
  var slug = document.getElementById('page-slug').value.trim().toLowerCase().replace(/[^a-z0-9-]/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'');
  var rawFlyer = document.getElementById('page-flyer-url').value.trim();
  var rawInstructorPhoto = document.getElementById('page-instructor-photo').value.trim();

  var pageData = {
    type: isInit ? 'initiative' : 'event',
    pageEnabled: document.getElementById('page-enabled').checked,
    slug: slug,
    pageTitle: document.getElementById('page-title').value.trim(),
    tagline: document.getElementById('page-tagline').value.trim(),
    heroDescription: document.getElementById('page-hero-desc').value.trim(),
    venue: document.getElementById('page-venue').value.trim(),
    costDisplay: document.getElementById('page-cost-display').value.trim(),
    contact: {
      name: document.getElementById('page-contact-name').value.trim(),
      phone: document.getElementById('page-contact-phone').value.trim()
    },
    aboutTitle: document.getElementById('page-about-title').value.trim(),
    aboutBody: document.getElementById('page-about-body').value.trim(),
    whatToExpect: parseLines('page-what-to-expect'),
    whoShouldAttend: parseLines('page-who-should-attend'),
    // Only one registration method is stored, so switching modes can't
    // leave a stale Zeffy embed rendering next to a form.
    formId: ((document.querySelector('input[name="page-reg-mode"]:checked') || {}).value === 'form')
      ? (document.getElementById('page-form-id').value || '') : '',
    zeffyUrl: ((document.querySelector('input[name="page-reg-mode"]:checked') || {}).value === 'zeffy')
      ? document.getElementById('page-zeffy-url').value.trim() : '',
    registrationNote: document.getElementById('page-registration-note').value.trim(),
    flyerImageUrl: convertDriveUrl(rawFlyer),
    driveUrl: rawFlyer,
    metaDescription: document.getElementById('page-meta-desc').value.trim()
  };

  if (!isInit) {
    pageData.date = document.getElementById('page-date').value;
    pageData.fromTime = document.getElementById('page-from-time').value.trim();
    pageData.toTime = document.getElementById('page-to-time').value.trim();
    pageData.category = document.getElementById('page-category').value;
    pageData.performers = parsePiped('page-performers', ['name','role','location']);
    pageData.scheduleItems = parsePiped('page-schedule-items', ['time','label','duration']);
  } else {
    pageData.startDate = document.getElementById('page-start-date').value;
    pageData.endDate = document.getElementById('page-end-date').value;
    pageData.scheduleText = document.getElementById('page-schedule-text').value.trim();
    pageData.instructor = {
      name: document.getElementById('page-instructor-name').value.trim(),
      role: document.getElementById('page-instructor-role').value.trim(),
      photoUrl: convertDriveUrl(rawInstructorPhoto),
      driveUrl: rawInstructorPhoto,
      bio: document.getElementById('page-instructor-bio').value.trim()
    };
    pageData.curriculumTitle = document.getElementById('page-curriculum-title').value.trim();
    pageData.curriculum = parsePiped('page-curriculum', ['weekLabel','title','description']);
  }

  var fb = window.__hccgcMP;
  if (!fb) {
    btn.disabled = false; btn.innerHTML = orig;
    showStatusMP('Not ready yet — please wait a moment and try again.', 'error');
    return;
  }
  try {
    var pageId = document.getElementById('edit-page-id').value;
    if (pageId) {
      await fb.setDoc(fb.doc(fb.db, fb.PAGES_COLLECTION, pageId), pageData, { merge: true });
    } else {
      pageData.createdAt = fb.serverTimestamp();
      var ref = await fb.addDoc(fb.collection(fb.db, fb.PAGES_COLLECTION), pageData);
      pageId = ref.id;
      document.getElementById('edit-page-id').value = pageId;
    }

    // Optionally sync to Manage Events
    if (document.getElementById('sync-to-events').checked) {
      var desc = document.getElementById('sync-description').value.trim();
      var eventRecord = {
        type: isInit ? 'initiative' : 'event',
        name: pageData.pageTitle,
        description: desc,
        date: isInit ? pageData.startDate : pageData.date,
        category: pageData.category || '',
        cost: pageData.costDisplay || '',
        rsvpUrl: pageData.zeffyUrl || '',
        createdByName: '',
        createdByEmail: '',
        createdAt: fb.serverTimestamp(),
        pageSlug: slug
      };
      if (!isInit) { eventRecord.fromTime = pageData.fromTime; eventRecord.toTime = pageData.toTime; }
      else { eventRecord.endDate = pageData.endDate; eventRecord.schedule = pageData.scheduleText; }
      await fb.addDoc(fb.collection(fb.db, fb.EVENTS_COLLECTION), eventRecord);
    }

    btn.disabled = false; btn.innerHTML = orig;
    closeModalMP();
    showStatusMP('Page saved!' + (pageData.pageEnabled && slug ? ' Live at hccgc.org/' + slug : ' Page is hidden.'), 'success');
    loadPages();
  } catch(err) {
    btn.disabled = false; btn.innerHTML = orig;
    showStatusMP('Error: ' + (err.message || 'unknown error'), 'error');
  }
});


/* ===================== FORMS TAB ===================== */
const FORMS_API_BASE = 'https://facility-rental-api-217911937447.us-central1.run.app';
const FORM_QUESTION_TYPES = [
  { value: 'text',     label: 'Short answer' },
  { value: 'textarea', label: 'Paragraph' },
  { value: 'dropdown', label: 'Dropdown' },
  { value: 'radio',    label: 'Multiple choice (pick one)' },
  { value: 'checkbox', label: 'Checkboxes (pick many)' }
];
const TYPES_WITH_OPTIONS = ['dropdown', 'radio', 'checkbox'];

async function formsAuthedFetch(url, options) {
  options = options || {};
  var user = window.__hccgcUser;
  if (!user) throw new Error('Not signed in.');
  var token = await user.getIdToken();
  options.headers = Object.assign({}, options.headers, { 'Authorization': 'Bearer ' + token });
  return fetch(url, options);
}
function escF(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function showStatusForms(msg, kind) {
  var bar = document.getElementById('status-bar-forms');
  if (!bar) return;
  bar.className = 'status-bar ' + (kind || '') + ' show';
  bar.textContent = msg;
  setTimeout(function () { bar.className = 'status-bar'; }, 4000);
}
function formPublicUrl(formIdOrSlug) { return 'https://hccgc.org/forms/' + formIdOrSlug; }
function formLinkFor(f) { return formPublicUrl(f.slug || f.formId); }
// <input type="date"> only accepts exactly YYYY-MM-DD and silently
// blanks itself on anything else — including a full ISO timestamp. The
// backend normalizes this now, but trimming here too means a stray
// timestamp can never blank the field and get saved back as empty.
function toDateInputValue(v) {
  if (!v) return '';
  return String(v).slice(0, 10);
}
// 'HH:MM' (24h, as stored) -> '6:00 PM'
function fmt12h(hhmm) {
  if (!hhmm) return '';
  var parts = String(hhmm).split(':');
  var h = Number(parts[0]), m = parts[1] || '00';
  var suffix = h >= 12 ? 'PM' : 'AM';
  var h12 = h % 12; if (h12 === 0) h12 = 12;
  return h12 + ':' + m + ' ' + suffix;
}

/* ---- List ---- */
let FORMS_CACHE = [];
async function loadForms() {
  var list = document.getElementById('forms-list');
  list.innerHTML = '<div class="empty-state">Loading&hellip;</div>';
  try {
    var res = await formsAuthedFetch(FORMS_API_BASE + '/forms');
    var data = await res.json();
    if (!res.ok) throw new Error((data.errors || [data.error || 'Server error']).join(' '));
    FORMS_CACHE = data;
    document.getElementById('forms-count').textContent =
      data.length + ' form' + (data.length === 1 ? '' : 's');
    if (!data.length) {
      list.innerHTML = '<div class="empty-state">No forms yet. Click "New Form" to create your first one.</div>';
      return;
    }
    list.innerHTML = data.map(function (f) {
      var dOnly = toDateInputValue(f.eventDate);
      var dateStr = dOnly
        ? new Date(dOnly + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
        : 'No date';
      if (f.eventStartTime && f.eventEndTime) {
        dateStr += ', ' + fmt12h(f.eventStartTime) + '\u2013' + fmt12h(f.eventEndTime);
      }
      return '<div class="page-row">' +
        '<div class="page-row-dot' + (f.isActive ? ' live' : '') + '"></div>' +
        '<div class="page-row-info">' +
          '<h4>' + escF(f.formName) +
            ' <span class="type-pill ' + (f.isActive ? 'event' : 'initiative') + '">' +
            (f.isActive ? 'Accepting' : 'Closed') + '</span></h4>' +
          '<div class="meta">' +
            escF(f.eventName) + ' &nbsp;·&nbsp; ' + escF(dateStr) +
            ' &nbsp;·&nbsp; ' + f.responseCount + ' response' + (f.responseCount === 1 ? '' : 's') +
            ' &nbsp;·&nbsp; <a href="' + escF(formPublicUrl(f.formId)) + '" target="_blank">' +
            escF(formLinkFor(f)) + ' \u2197</a>' +
          '</div>' +
        '</div>' +
        '<div class="page-row-actions">' +
          '<button class="btn-row" data-copy-form-link="' + f.formId + '">Copy link</button>' +
          '<button class="btn-row" data-view-responses="' + f.formId + '">Responses</button>' +
          '<button class="btn-row" data-duplicate-form="' + f.formId + '">Duplicate</button>' +
          '<button class="btn-row" data-edit-form="' + f.formId + '">' +
            '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit' +
          '</button>' +
          '<button class="btn-row danger" data-delete-form="' + f.formId + '">Delete</button>' +
        '</div>' +
      '</div>';
    }).join('');
  } catch (err) {
    list.innerHTML = '<div class="empty-state">Could not load forms: ' + escF(err.message) + '</div>';
  }
}

document.getElementById('forms-list').addEventListener('click', async function (e) {
  var copyBtn = e.target.closest('[data-copy-form-link]');
  if (copyBtn) {
    var cf = FORMS_CACHE.find(function (x) { return x.formId === copyBtn.dataset.copyFormLink; });
    var url = formPublicUrl((cf && cf.slug) || copyBtn.dataset.copyFormLink);
    try {
      await navigator.clipboard.writeText(url);
      showStatusForms('Link copied: ' + url, 'success');
    } catch (err) {
      window.prompt('Copy this link:', url);
    }
    return;
  }
  var respBtn = e.target.closest('[data-view-responses]');
  if (respBtn) { openResponsesModal(respBtn.dataset.viewResponses); return; }
  var dupBtn = e.target.closest('[data-duplicate-form]');
  if (dupBtn) {
    dupBtn.disabled = true; dupBtn.textContent = 'Duplicating\u2026';
    try {
      var res = await formsAuthedFetch(FORMS_API_BASE + '/forms/' + encodeURIComponent(dupBtn.dataset.duplicateForm) + '/duplicate', { method: 'POST' });
      var data = await res.json();
      if (!res.ok) {
        showStatusForms((data.errors || [data.error]).join(' ') || 'Could not duplicate.', 'error');
        dupBtn.disabled = false; dupBtn.textContent = 'Duplicate';
        return;
      }
      showStatusForms('Draft copy created \u2014 it won\'t accept responses until you turn that on.', 'success');
      await loadForms();
      // Drop straight into the copy, since duplicating is almost always
      // the first step of editing it.
      openFormBuilder(data.formId);
    } catch (err) {
      showStatusForms('Could not reach the server: ' + err.message, 'error');
      dupBtn.disabled = false; dupBtn.textContent = 'Duplicate';
    }
    return;
  }
  var editBtn = e.target.closest('[data-edit-form]');
  if (editBtn) { openFormBuilder(editBtn.dataset.editForm); return; }
  var delBtn = e.target.closest('[data-delete-form]');
  if (delBtn) {
    var f = FORMS_CACHE.find(function (x) { return x.formId === delBtn.dataset.deleteForm; });
    var name = f ? f.formName : 'this form';
    if (!confirm('Delete "' + name + '" permanently? This can\'t be undone. If it already has responses, this will be refused \u2014 turn off "accepting responses" instead in that case.')) return;
    delBtn.disabled = true; delBtn.textContent = 'Deleting\u2026';
    try {
      var res = await formsAuthedFetch(FORMS_API_BASE + '/forms/' + encodeURIComponent(delBtn.dataset.deleteForm) + '/delete', { method: 'POST' });
      var data = await res.json();
      if (!res.ok) {
        showStatusForms((data.errors || [data.error]).join(' ') || 'Could not delete.', 'error');
        delBtn.disabled = false; delBtn.textContent = 'Delete';
        return;
      }
      showStatusForms('Form deleted.', 'success');
      loadForms();
    } catch (err) {
      showStatusForms('Could not reach the server: ' + err.message, 'error');
      delBtn.disabled = false; delBtn.textContent = 'Delete';
    }
  }
});

/* ---- Builder ---- */
let BUILDER_QUESTIONS = [];
function renderQuestionsBuilder() {
  var wrap = document.getElementById('questions-builder');
  if (!BUILDER_QUESTIONS.length) {
    wrap.innerHTML = '<div style="padding:16px;text-align:center;color:var(--muted);font-size:.84rem;border:1px dashed var(--border);border-radius:10px;">No custom questions yet \u2014 the four standard fields will still be collected.</div>';
    return;
  }
  wrap.innerHTML = BUILDER_QUESTIONS.map(function (q, i) {
    var needsOptions = TYPES_WITH_OPTIONS.indexOf(q.questionType) !== -1;
    return '<div style="border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:10px;background:#fff;">' +
      '<div style="display:flex;gap:8px;align-items:center;margin-bottom:10px;">' +
        '<span style="font-weight:700;font-size:.8rem;color:var(--muted);flex-shrink:0;">Q' + (i + 1) + '</span>' +
        '<input type="text" data-q-text="' + i + '" value="' + escF(q.questionText) + '" placeholder="Question text" style="flex:1;">' +
      '</div>' +
      '<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">' +
        '<select data-q-type="' + i + '" style="flex:1;min-width:170px;">' +
          FORM_QUESTION_TYPES.map(function (t) {
            return '<option value="' + t.value + '"' + (t.value === q.questionType ? ' selected' : '') + '>' + t.label + '</option>';
          }).join('') +
        '</select>' +
        '<label style="display:flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;white-space:nowrap;">' +
          '<input type="checkbox" data-q-required="' + i + '"' + (q.isRequired ? ' checked' : '') + '> Required' +
        '</label>' +
        '<button type="button" class="btn-secondary" data-q-up="' + i + '" style="padding:4px 9px;font-size:.78rem;"' + (i === 0 ? ' disabled' : '') + '>\u2191</button>' +
        '<button type="button" class="btn-secondary" data-q-down="' + i + '" style="padding:4px 9px;font-size:.78rem;"' + (i === BUILDER_QUESTIONS.length - 1 ? ' disabled' : '') + '>\u2193</button>' +
        '<button type="button" class="btn-secondary" data-q-remove="' + i + '" style="padding:4px 9px;font-size:.78rem;">Remove</button>' +
      '</div>' +
      // Only questions BEFORE this one can control it — a later question
      // hasn't been answered yet when this one needs to be shown or hidden.
      '<div style="margin-top:10px;padding-top:10px;border-top:1px dashed var(--border);">' +
        '<label style="font-size:.78rem;color:var(--muted);display:block;margin-bottom:4px;">Show this question only if…</label>' +
        '<div style="display:flex;gap:8px;flex-wrap:wrap;">' +
          '<select data-q-cond-idx="' + i + '" style="flex:1;min-width:180px;">' +
            '<option value="">Always show</option>' +
            BUILDER_QUESTIONS.slice(0, i).map(function (pq, pi) {
              if (TYPES_WITH_OPTIONS.indexOf(pq.questionType) === -1) return '';
              var lbl = (pq.questionText || ('Question ' + (pi + 1))).slice(0, 50);
              return '<option value="' + pi + '"' + (String(q.conditionQuestionIndex) === String(pi) ? ' selected' : '') + '>Q' + (pi + 1) + ': ' + escF(lbl) + '</option>';
            }).join('') +
          '</select>' +
          '<select data-q-cond-val="' + i + '" style="flex:1;min-width:150px;"' + (q.conditionQuestionIndex === null || q.conditionQuestionIndex === undefined ? ' disabled' : '') + '>' +
            (function () {
              var ctrl = BUILDER_QUESTIONS[q.conditionQuestionIndex];
              if (!ctrl || !ctrl.options) return '<option value="">—</option>';
              return '<option value="">— pick an answer —</option>' + ctrl.options.map(function (o) {
                return '<option value="' + escF(o) + '"' + (q.conditionValue === o ? ' selected' : '') + '>' + escF(o) + '</option>';
              }).join('');
            })() +
          '</select>' +
        '</div>' +
        (i === 0 ? '<div class="field-hint" style="margin-top:4px;">The first question can\'t be conditional — nothing comes before it.</div>' : '') +
      '</div>' +
      '<div data-q-options-wrap="' + i + '" style="margin-top:10px;' + (needsOptions ? '' : 'display:none;') + '">' +
        '<label style="font-size:.78rem;color:var(--muted);display:block;margin-bottom:4px;">Options (one per line)</label>' +
        '<textarea data-q-options="' + i + '" rows="3" placeholder="Option 1&#10;Option 2">' + escF((q.options || []).join('\n')) + '</textarea>' +
      '</div>' +
    '</div>';
  }).join('');
}
function syncQuestionsFromDom() {
  BUILDER_QUESTIONS.forEach(function (q, i) {
    var textEl = document.querySelector('[data-q-text="' + i + '"]');
    var typeEl = document.querySelector('[data-q-type="' + i + '"]');
    var reqEl = document.querySelector('[data-q-required="' + i + '"]');
    var optEl = document.querySelector('[data-q-options="' + i + '"]');
    if (textEl) q.questionText = textEl.value;
    if (typeEl) q.questionType = typeEl.value;
    if (reqEl) q.isRequired = reqEl.checked;
    if (optEl) q.options = optEl.value.split('\n').map(function (s) { return s.trim(); }).filter(Boolean);
    var condIdxEl = document.querySelector('[data-q-cond-idx="' + i + '"]');
    var condValEl = document.querySelector('[data-q-cond-val="' + i + '"]');
    if (condIdxEl) q.conditionQuestionIndex = condIdxEl.value === '' ? null : Number(condIdxEl.value);
    if (condValEl) q.conditionValue = condValEl.value || null;
    if (q.conditionQuestionIndex === null) q.conditionValue = null;
  });
}
// Only choice-type questions can drive shared visibility — free text has
// no shared value to group people by.
function populateLimitScopeOptions(qIdx, answerVal) {
  var qSel = document.getElementById('form-limit-question');
  var aSel = document.getElementById('form-limit-answer');
  qSel.innerHTML = '<option value="">Everyone who responds</option>' +
    BUILDER_QUESTIONS.map(function (q, i) {
      if (TYPES_WITH_OPTIONS.indexOf(q.questionType) === -1) return '';
      return '<option value="' + i + '"' + (String(qIdx) === String(i) ? ' selected' : '') + '>Q' + (i + 1) + ': ' + escF((q.questionText || '').slice(0, 50)) + '</option>';
    }).join('');
  qSel.value = (qIdx === null || qIdx === undefined) ? '' : String(qIdx);
  var q = BUILDER_QUESTIONS[qSel.value];
  if (qSel.value !== '' && q && q.options && q.options.length) {
    aSel.style.display = 'block';
    aSel.innerHTML = '<option value="">\u2014 pick the answer \u2014</option>' +
      q.options.map(function (o) { return '<option value="' + escF(o) + '"' + (answerVal === o ? ' selected' : '') + '>' + escF(o) + '</option>'; }).join('');
    aSel.value = answerVal || '';
  } else {
    aSel.style.display = 'none';
    aSel.innerHTML = '';
  }
}
document.getElementById('form-limit-question').addEventListener('change', function () {
  populateLimitScopeOptions(this.value === '' ? null : Number(this.value), null);
});
function populateSharedQuestionOptions(selected) {
  var sel = document.getElementById('form-shared-question');
  sel.innerHTML = '<option value="">Off — nobody sees other responses</option>' +
    BUILDER_QUESTIONS.map(function (q, i) {
      if (TYPES_WITH_OPTIONS.indexOf(q.questionType) === -1) return '';
      return '<option value="' + i + '"' + (String(selected) === String(i) ? ' selected' : '') + '>Q' + (i + 1) + ': ' + escF((q.questionText || '').slice(0, 50)) + '</option>';
    }).join('');
  sel.value = (selected === null || selected === undefined) ? '' : String(selected);
}
document.getElementById('form-conf-email-enabled').addEventListener('change', function () {
  document.getElementById('form-conf-email-fields').style.display = this.checked ? 'block' : 'none';
});
document.getElementById('btn-add-question').addEventListener('click', function () {
  syncQuestionsFromDom();
  BUILDER_QUESTIONS.push({ questionText: '', questionType: 'text', options: [], isRequired: false, conditionQuestionIndex: null, conditionValue: null });
  renderQuestionsBuilder();
  populateSharedQuestionOptions(document.getElementById('form-shared-question').value === '' ? null : Number(document.getElementById('form-shared-question').value));
  // The button now sits below the list, so bring the new question into
  // view and put the cursor in it rather than leaving the user to hunt
  // for where it landed.
  var last = document.querySelector('[data-q-text="' + (BUILDER_QUESTIONS.length - 1) + '"]');
  if (last) { last.scrollIntoView({ block: 'center', behavior: 'smooth' }); last.focus(); }
});
document.getElementById('questions-builder').addEventListener('click', function (e) {
  var up = e.target.closest('[data-q-up]');
  var down = e.target.closest('[data-q-down]');
  var rm = e.target.closest('[data-q-remove]');
  if (!up && !down && !rm) return;
  syncQuestionsFromDom();
  if (up) {
    var i = Number(up.dataset.qUp);
    var tmp = BUILDER_QUESTIONS[i - 1]; BUILDER_QUESTIONS[i - 1] = BUILDER_QUESTIONS[i]; BUILDER_QUESTIONS[i] = tmp;
  } else if (down) {
    var j = Number(down.dataset.qDown);
    var tmp2 = BUILDER_QUESTIONS[j + 1]; BUILDER_QUESTIONS[j + 1] = BUILDER_QUESTIONS[j]; BUILDER_QUESTIONS[j] = tmp2;
  } else {
    BUILDER_QUESTIONS.splice(Number(rm.dataset.qRemove), 1);
  }
  renderQuestionsBuilder();
});
// Changing the type only needs the options block shown or hidden for
// that one question. Re-rendering the whole list here would throw away
// every input mid-edit and scroll the user back to the top, which reads
// as the form losing their work.
document.getElementById('questions-builder').addEventListener('change', function (e) {
  // Changing which question controls this one changes the list of valid
  // answers, so that dropdown has to be rebuilt.
  if (e.target.closest('[data-q-cond-idx]')) {
    syncQuestionsFromDom();
    renderQuestionsBuilder();
    return;
  }
  var typeEl = e.target.closest('[data-q-type]');
  if (!typeEl) return;
  var i = typeEl.dataset.qType;
  var wrap = document.querySelector('[data-q-options-wrap="' + i + '"]');
  if (wrap) wrap.style.display = TYPES_WITH_OPTIONS.indexOf(typeEl.value) !== -1 ? 'block' : 'none';
});

async function openFormBuilder(formId) {
  document.getElementById('form-builder-result').className = 'status-bar';
  ['err-form-name','err-form-event-name','err-form-event-date','err-form-event-start','err-form-event-end','err-form-slug']
    .forEach(function (id) { document.getElementById(id).classList.remove('show'); });
  document.getElementById('err-form-questions').style.display = 'none';
  document.getElementById('edit-form-id').value = formId || '';
  document.getElementById('form-builder-title').textContent = formId ? 'Edit Form' : 'New Form';

  if (!formId) {
    document.getElementById('form-name').value = '';
    document.getElementById('form-event-name').value = '';
    document.getElementById('form-event-date').value = '';
    document.getElementById('form-event-start').value = '';
    document.getElementById('form-event-end').value = '';
    document.getElementById('form-slug').value = '';
    document.getElementById('form-one-per-email').checked = false;
    document.getElementById('form-confirmed-limit').value = '';
    document.getElementById('form-confirmed-label').value = '';
    document.getElementById('form-overflow-label').value = '';
    document.getElementById('form-conf-email-enabled').checked = false;
    document.getElementById('form-conf-email-fields').style.display = 'none';
    document.getElementById('form-conf-email-subject').value = '';
    document.getElementById('form-conf-email-body').value = '';
    populateSharedQuestionOptions(null);
    populateLimitScopeOptions(null, null);
    document.getElementById('form-is-active').checked = true;
    BUILDER_QUESTIONS = [];
    renderQuestionsBuilder();
    document.getElementById('modal-overlay-form').classList.add('show');
    return;
  }
  document.getElementById('modal-overlay-form').classList.add('show');
  document.getElementById('questions-builder').innerHTML = '<div class="empty-state">Loading&hellip;</div>';
  try {
    var res = await formsAuthedFetch(FORMS_API_BASE + '/forms/' + encodeURIComponent(formId));
    var f = await res.json();
    if (!res.ok) throw new Error((f.errors || [f.error || 'Server error']).join(' '));
    document.getElementById('form-name').value = f.formName || '';
    document.getElementById('form-event-name').value = f.eventName || '';
    document.getElementById('form-event-date').value = toDateInputValue(f.eventDate);
    document.getElementById('form-event-start').value = f.eventStartTime || '';
    document.getElementById('form-event-end').value = f.eventEndTime || '';
    document.getElementById('form-slug').value = f.slug || '';
    document.getElementById('form-one-per-email').checked = !!f.oneResponsePerEmail;
    document.getElementById('form-confirmed-limit').value = (f.confirmedLimit === null || f.confirmedLimit === undefined) ? '' : f.confirmedLimit;
    document.getElementById('form-confirmed-label').value = f.confirmedLabel || '';
    document.getElementById('form-overflow-label').value = f.overflowLabel || '';
    document.getElementById('form-conf-email-enabled').checked = !!f.confirmationEmailEnabled;
    document.getElementById('form-conf-email-fields').style.display = f.confirmationEmailEnabled ? 'block' : 'none';
    document.getElementById('form-conf-email-subject').value = f.confirmationEmailSubject || '';
    document.getElementById('form-conf-email-body').value = f.confirmationEmailBody || '';
    document.getElementById('form-is-active').checked = f.isActive !== false;
    BUILDER_QUESTIONS = (f.questions || []).map(function (q) {
      return { questionText: q.questionText, questionType: q.questionType, options: q.options || [], isRequired: q.isRequired, conditionQuestionIndex: (q.conditionQuestionIndex === undefined ? null : q.conditionQuestionIndex), conditionValue: q.conditionValue || null };
    });
    renderQuestionsBuilder();
    populateSharedQuestionOptions(f.sharedViewQuestionIndex);
    populateLimitScopeOptions(f.limitQuestionIndex, f.limitAnswerValue);
  } catch (err) {
    document.getElementById('questions-builder').innerHTML =
      '<div class="empty-state">Could not load: ' + escF(err.message) + '</div>';
  }
}
function closeFormBuilder() { document.getElementById('modal-overlay-form').classList.remove('show'); }
document.getElementById('btn-new-form').addEventListener('click', function () { openFormBuilder(null); });
document.getElementById('form-builder-close').addEventListener('click', closeFormBuilder);
document.getElementById('form-builder-cancel').addEventListener('click', closeFormBuilder);
// Only treat this as a backdrop dismiss when the press AND the release
// both happened on the backdrop itself. Checking the click target alone
// is a well-known trap: drag-selecting text inside a textarea and
// releasing past the edge of the card makes the browser fire `click` on
// the nearest common ancestor — the overlay — so the form would vanish
// mid-edit with everything typed into it lost.
var formOverlayPressedOnBackdrop = false;
document.getElementById('modal-overlay-form').addEventListener('mousedown', function (e) {
  formOverlayPressedOnBackdrop = (e.target === this);
});
document.getElementById('modal-overlay-form').addEventListener('click', function (e) {
  if (e.target === this && formOverlayPressedOnBackdrop) closeFormBuilder();
  formOverlayPressedOnBackdrop = false;
});

document.getElementById('btn-save-form').addEventListener('click', async function () {
  var btn = this;
  syncQuestionsFromDom();
  var formName = document.getElementById('form-name').value.trim();
  var eventName = document.getElementById('form-event-name').value.trim();
  var eventDate = document.getElementById('form-event-date').value || '';
  var eventStartTime = document.getElementById('form-event-start').value || '';
  var eventEndTime = document.getElementById('form-event-end').value || '';
  var isActive = document.getElementById('form-is-active').checked;
  var slug = document.getElementById('form-slug').value.trim().toLowerCase();
  var slugBad = !!slug && !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug);
  document.getElementById('err-form-slug').classList.toggle('show', slugBad);
  var formId = document.getElementById('edit-form-id').value;

  var badEnd = !eventEndTime || (eventStartTime && eventEndTime <= eventStartTime);
  document.getElementById('err-form-name').classList.toggle('show', !formName);
  document.getElementById('err-form-event-name').classList.toggle('show', !eventName);
  document.getElementById('err-form-event-date').classList.toggle('show', !eventDate);
  document.getElementById('err-form-event-start').classList.toggle('show', !eventStartTime);
  document.getElementById('err-form-event-end').classList.toggle('show', badEnd);
  var qErrors = [];
  BUILDER_QUESTIONS.forEach(function (q, i) {
    if (!q.questionText.trim()) qErrors.push('Question ' + (i + 1) + ' needs text.');
    if (TYPES_WITH_OPTIONS.indexOf(q.questionType) !== -1 && !(q.options || []).length) {
      qErrors.push('Question ' + (i + 1) + ' needs at least one option.');
    }
  });
  var qErrEl = document.getElementById('err-form-questions');
  if (qErrors.length) { qErrEl.textContent = qErrors.join(' '); qErrEl.style.display = 'block'; }
  else { qErrEl.style.display = 'none'; }
  if (!formName || !eventName || !eventDate || !eventStartTime || badEnd || slugBad || qErrors.length) return;

  var orig = btn.textContent;
  btn.disabled = true; btn.textContent = 'Saving\u2026';
  var resultBox = document.getElementById('form-builder-result');
  try {
    var payload = {
      formName: formName, eventName: eventName, eventDate: eventDate,
      eventStartTime: eventStartTime, eventEndTime: eventEndTime,
      slug: slug, isActive: isActive,
      oneResponsePerEmail: document.getElementById('form-one-per-email').checked,
      confirmedLimit: document.getElementById('form-confirmed-limit').value || null,
      confirmedLabel: document.getElementById('form-confirmed-label').value.trim() || 'Confirmed',
      overflowLabel: document.getElementById('form-overflow-label').value.trim() || 'Waitlist',
      confirmationEmailEnabled: document.getElementById('form-conf-email-enabled').checked,
      confirmationEmailSubject: document.getElementById('form-conf-email-subject').value.trim(),
      confirmationEmailBody: document.getElementById('form-conf-email-body').value,
      sharedViewQuestionIndex: document.getElementById('form-shared-question').value === '' ? null : Number(document.getElementById('form-shared-question').value),
      limitQuestionIndex: document.getElementById('form-limit-question').value === '' ? null : Number(document.getElementById('form-limit-question').value),
      limitAnswerValue: document.getElementById('form-limit-answer').value || null,
      questions: BUILDER_QUESTIONS
    };
    var url = formId ? FORMS_API_BASE + '/forms/' + encodeURIComponent(formId) : FORMS_API_BASE + '/forms';
    var res = await formsAuthedFetch(url, {
      method: formId ? 'PATCH' : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    var data = await res.json();
    if (!res.ok) {
      resultBox.className = 'status-bar error show';
      resultBox.textContent = (data.errors || [data.error || 'Could not save.']).join(' ');
      return;
    }
    closeFormBuilder();
    showStatusForms(formId ? 'Form updated.' : 'Form created \u2014 share it at ' + formPublicUrl(slug || data.formId), 'success');
    loadForms();
  } catch (err) {
    resultBox.className = 'status-bar error show';
    resultBox.textContent = 'Could not reach the server: ' + err.message;
  } finally {
    btn.disabled = false; btn.textContent = orig;
  }
});

/* ---- Responses ---- */
let CURRENT_RESPONSES = null;
let CURRENT_RESPONSES_FORM = null;
let CURRENT_RESPONSES_FORM_ID = null;
async function openResponsesModal(formId) {
  var form = FORMS_CACHE.find(function (f) { return f.formId === formId; });
  document.getElementById('responses-title').textContent =
    'Responses' + (form ? ' \u2014 ' + form.formName : '');
  document.getElementById('modal-overlay-responses').classList.add('show');
  var body = document.getElementById('responses-body');
  body.innerHTML = '<div class="empty-state">Loading&hellip;</div>';
  CURRENT_RESPONSES = null;
  try {
    var defRes = await formsAuthedFetch(FORMS_API_BASE + '/forms/' + encodeURIComponent(formId));
    var def = await defRes.json();
    if (!defRes.ok) throw new Error((def.errors || [def.error || 'Server error']).join(' '));
    var res = await formsAuthedFetch(FORMS_API_BASE + '/forms/' + encodeURIComponent(formId) + '/responses');
    var rows = await res.json();
    if (!res.ok) throw new Error((rows.errors || [rows.error || 'Server error']).join(' '));
    CURRENT_RESPONSES = rows;
    CURRENT_RESPONSES_FORM = def;
    CURRENT_RESPONSES_FORM_ID = formId;
    if (!rows.length) { body.innerHTML = '<div class="empty-state">No responses yet.</div>'; return; }
    var headers = ['First name', 'Last name', 'Email', 'Phone', 'Status']
      .concat(def.questions.map(function (q) { return q.questionText; }))
      .concat(['Submitted', '']);
    var headHtml = headers.map(function (h) {
      return '<th style="text-align:left;padding:8px 10px;border-bottom:2px solid var(--border);white-space:nowrap;">' + escF(h) + '</th>';
    }).join('');
    var bodyHtml = rows.map(function (r) {
      var cells = [r.firstName, r.lastName, r.email, r.phone].map(function (v) {
        return '<td style="padding:8px 10px;border-bottom:1px solid var(--border);">' + escF(v) + '</td>';
      });
      cells.push('<td style="padding:8px 10px;border-bottom:1px solid var(--border);white-space:nowrap;">' +
        (r.statusFlag ? '<span class="type-pill ' + (r.statusFlag === (def.confirmedLabel || 'Confirmed') ? 'event' : 'initiative') + '">' + escF(r.statusFlag) + '</span>' : '\u2014') +
        '</td>');
      def.questions.forEach(function (q, qi) {
        var a = answerFor(r, def, q, qi);
        if (Array.isArray(a)) a = a.join(', ');
        cells.push('<td style="padding:8px 10px;border-bottom:1px solid var(--border);">' + escF(a) + '</td>');
      });
      cells.push('<td style="padding:8px 10px;border-bottom:1px solid var(--border);white-space:nowrap;">' +
        escF(new Date(r.submittedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })) + '</td>');
      cells.push('<td style="padding:8px 10px;border-bottom:1px solid var(--border);">' +
        '<button type="button" class="btn-row danger" data-delete-response="' + r.responseId + '" data-response-name="' + escF(r.firstName + ' ' + r.lastName) + '">Delete</button></td>');
      return '<tr>' + cells.join('') + '</tr>';
    }).join('');
    body.innerHTML =
      '<div style="font-size:.82rem;color:var(--muted);margin-bottom:10px;">' + rows.length + ' response' + (rows.length === 1 ? '' : 's') + '</div>' +
      '<div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;font-size:.84rem;">' +
      '<thead><tr>' + headHtml + '</tr></thead><tbody>' + bodyHtml + '</tbody></table></div>';
  } catch (err) {
    body.innerHTML = '<div class="empty-state">Could not load: ' + escF(err.message) + '</div>';
  }
}
document.getElementById('responses-body').addEventListener('click', async function (e) {
  var btn = e.target.closest('[data-delete-response]');
  if (!btn) return;
  if (!confirm('Delete the response from ' + btn.dataset.responseName + '? This can\'t be undone.\n\nNote: this does NOT move anyone up from the waitlist \u2014 flags are fixed at submission time so nobody already told they are confirmed loses that.')) return;
  btn.disabled = true; btn.textContent = 'Deleting\u2026';
  try {
    var res = await formsAuthedFetch(FORMS_API_BASE + '/forms/' + encodeURIComponent(CURRENT_RESPONSES_FORM_ID) + '/responses/' + encodeURIComponent(btn.dataset.deleteResponse) + '/delete', { method: 'POST' });
    var data = await res.json();
    if (!res.ok) { alert((data.errors || [data.error]).join(' ') || 'Could not delete.'); btn.disabled = false; btn.textContent = 'Delete'; return; }
    await openResponsesModal(CURRENT_RESPONSES_FORM_ID);
    loadForms();
  } catch (err) {
    alert('Could not reach the server: ' + err.message);
    btn.disabled = false; btn.textContent = 'Delete';
  }
});
// Answers are keyed by question_id. Before question ids were preserved
// across edits, editing a form minted new ids and orphaned every answer
// already collected. Fall back to matching by position so those older
// responses still display instead of appearing blank.
function answerFor(response, def, q, index) {
  var a = response.answers ? response.answers[q.questionId] : undefined;
  if (a !== undefined && a !== null && a !== '') return a;
  var keys = response.answers ? Object.keys(response.answers) : [];
  // Only fall back when the stored keys match none of the current
  // questions — otherwise a genuinely blank answer would pick up a
  // neighbour's value.
  var anyMatch = def.questions.some(function (dq) { return keys.indexOf(dq.questionId) !== -1; });
  if (!anyMatch && keys.length > index) return response.answers[keys[index]];
  return a === undefined ? '' : a;
}
function closeResponsesModal() { document.getElementById('modal-overlay-responses').classList.remove('show'); }
document.getElementById('responses-close').addEventListener('click', closeResponsesModal);
document.getElementById('responses-close-2').addEventListener('click', closeResponsesModal);
var respOverlayPressedOnBackdrop = false;
document.getElementById('modal-overlay-responses').addEventListener('mousedown', function (e) {
  respOverlayPressedOnBackdrop = (e.target === this);
});
document.getElementById('modal-overlay-responses').addEventListener('click', function (e) {
  if (e.target === this && respOverlayPressedOnBackdrop) closeResponsesModal();
  respOverlayPressedOnBackdrop = false;
});
document.getElementById('btn-download-responses').addEventListener('click', function () {
  if (!CURRENT_RESPONSES || !CURRENT_RESPONSES.length || !CURRENT_RESPONSES_FORM) {
    showStatusForms('Nothing to download yet.', 'error');
    return;
  }
  var def = CURRENT_RESPONSES_FORM;
  function csvCell(v) {
    if (Array.isArray(v)) v = v.join(', ');
    v = String(v == null ? '' : v);
    return '"' + v.replace(/"/g, '""') + '"';
  }
  var header = ['First name', 'Last name', 'Email', 'Phone', 'Status']
    .concat(def.questions.map(function (q) { return q.questionText; }))
    .concat(['Submitted']).map(csvCell).join(',');
  var lines = CURRENT_RESPONSES.map(function (r) {
    var cells = [r.firstName, r.lastName, r.email, r.phone, r.statusFlag || ''];
    def.questions.forEach(function (q, qi) { cells.push(answerFor(r, def, q, qi)); });
    cells.push(r.submittedAt);
    return cells.map(csvCell).join(',');
  });
  var csv = [header].concat(lines).join('\n');
  var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = (def.formName || 'form').replace(/[^a-z0-9]+/gi, '-').toLowerCase() + '-responses.csv';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(a.href);
});

/* ---- Manage Pages integration ---- */
// Fills the "Attached Registration Form" dropdown in the Manage Pages
// wizard. Falls back to fetching if the Forms tab hasn't been opened yet
// this session, since the wizard can be opened without ever visiting it.
async function populatePageFormOptions(selectedFormId) {
  var sel = document.getElementById('page-form-id');
  if (!sel) return;
  function paint(forms) {
    sel.innerHTML = '<option value="">None — no form attached</option>' +
      forms.map(function (f) {
        return '<option value="' + f.formId + '">' + escF(f.formName) +
          (f.isActive ? '' : ' (not accepting responses)') + '</option>';
      }).join('');
    // If the page points at a form that no longer exists, keep the
    // reference visible rather than silently resetting it to "None" —
    // otherwise saving the page would quietly drop the attachment.
    if (selectedFormId && !forms.some(function (f) { return f.formId === selectedFormId; })) {
      sel.insertAdjacentHTML('beforeend',
        '<option value="' + escF(selectedFormId) + '">(previously attached form — no longer available)</option>');
    }
    sel.value = selectedFormId || '';
  }
  if (FORMS_CACHE.length) { paint(FORMS_CACHE); return; }
  try {
    var res = await formsAuthedFetch(FORMS_API_BASE + '/forms');
    var data = await res.json();
    if (res.ok) { FORMS_CACHE = data; paint(data); }
    else paint([]);
  } catch (err) {
    paint([]);
  }
}

/* Load once the user is known, and again whenever the Forms tab opens. */
let FORMS_LOADED = false;
function initFormsTabIfReady() {
  if (FORMS_LOADED || !window.__hccgcUser) return;
  FORMS_LOADED = true;
  loadForms();
}
window.addEventListener('hccgc-signed-in', initFormsTabIfReady);
if (window.__hccgcUser) initFormsTabIfReady();
document.querySelectorAll('[data-wm-tab="forms"]').forEach(function (btn) {
  btn.addEventListener('click', function () {
    if (window.__hccgcUser) { if (!FORMS_LOADED) { FORMS_LOADED = true; } loadForms(); }
  });
});


function closeDocumentViewer() {
  document.getElementById('document-viewer-overlay').style.display = 'none';
  document.getElementById('document-viewer-frame').src = 'about:blank';
  if (documentViewerContext) { URL.revokeObjectURL(documentViewerContext.url); documentViewerContext = null; }
}

    '</div><div class="gauge-marker" style="left:' + minPct + '%;"></div></div>' +
    '<div class="gauge-labels"><span>$0</span><span>Sustainability threshold: ' + moneyRound(min) + (data.monthsOfRunway ? ' (\u2248' + data.monthsOfRunway + ' months of avg. expenses)' : '') + '</span></div>' +
    '<div class="gauge-stats">' +
      '<div class="gauge-stat"><div class="label">Current cash</div><div class="value">' + moneyRound(cash) + '</div></div>' +

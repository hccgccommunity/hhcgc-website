async function loadAllocationCandidates(search) {
  if (!invoicePickerContext) return;
  const list = document.getElementById('invoice-picker-list');
  const suggestedEl = document.getElementById('alloc-suggested-match');
  list.innerHTML = '<div class="empty-state">Loading…</div>';
  suggestedEl.innerHTML = '';
  suggestedEl.style.display = 'none';
  try {
    const res = await authedFetch(API_BASE + '/finance/invoice-candidates?amount=' + invoicePickerContext.remaining + '&search=' + encodeURIComponent(search || ''));
    const candidates = await res.json();
    if (!candidates.length) { list.innerHTML = '<div class="empty-state">No open invoices found.</div>'; return; }

    // A clear best match — the top candidate's remaining balance equals
    // what's left of the transaction almost exactly. Surfaced prominently
    // so the obvious case doesn't require scrolling through a search list,
    // but it's still just a suggestion: nothing links until "Link this
    // amount" is actually clicked, same review step as any other candidate.
    var top = candidates[0];
    var isStrongMatch = !search && invoicePickerContext.remaining > 0 && Math.abs(top.remaining - invoicePickerContext.remaining) < 0.01;
    var rest = isStrongMatch ? candidates.slice(1) : candidates;

    if (isStrongMatch) {
      suggestedEl.style.display = 'block';
      suggestedEl.innerHTML = '<div style="font-size:0.78rem;font-weight:700;color:var(--saffron-dark);margin-bottom:6px;">\u2728 Suggested match \u2014 remaining balance matches exactly</div>' + renderCandidateCard(top, true);
    }
    list.innerHTML = rest.length ? rest.map(function (c) { return renderCandidateCard(c, false); }).join('') : (isStrongMatch ? '' : '<div class="empty-state">No open invoices found.</div>');
  } catch (err) {
    list.innerHTML = '<div class="empty-state">Could not load: ' + escHtml(err.message) + '</div>';
  }
}
function renderCandidateCard(c, isSuggested) {
  const suggested = Math.min(c.remaining, invoicePickerContext.remaining || c.remaining);
  return '<div class="exp-line-item" data-candidate-booking="' + c.bookingId + '" data-candidate-remaining="' + c.remaining + '"' + (isSuggested ? ' style="border-color:var(--saffron-dark);border-width:2px;background:var(--surface-soft);"' : '') + '>' +
    '<div class="exp-top-row"><span>' + escHtml(c.renterName) + (c.eventName ? ' — ' + escHtml(c.eventName) : '') + '</span><span>' + money(c.remaining) + ' owed</span></div>' +
    '<div class="exp-date">' + formatDate(c.eventDate) + ' \u00b7 ' + escHtml(c.paymentStatus) + (c.allocated > 0 ? ' \u00b7 ' + money(c.allocated) + ' already linked' : '') + '</div>' +
    '<div style="display:flex;gap:8px;align-items:center;margin-top:6px;">' +
    '<input type="number" step="0.01" min="0.01" max="' + c.remaining + '" value="' + suggested.toFixed(2) + '" class="alloc-amount-input" style="width:100px;font-family:inherit;font-size:0.84rem;padding:5px 8px;border:1.5px solid var(--border);border-radius:6px;">' +
    '<button type="button" class="btn-primary" style="padding:6px 14px;margin-top:0;font-size:0.82rem;" data-allocate-booking="' + c.bookingId + '">Link this amount</button>' +
    '</div>' +
  '</div>';
}

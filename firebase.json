{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/hccgc_rental_conditions",
        "destination": "/rental-terms-conditions",
        "type": 301
      },
      {
        "source": "/hccgc_rental_conditions.html",
        "destination": "/rental-terms-conditions",
        "type": 301
      },
      {
        "source": "/sahyog-milan-participation-form.html",
        "destination": "/sahayog-milan",
        "type": 301
      },
      {
        "source": "/sahyog-milan-participation-form",
        "destination": "/sahayog-milan",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/forms/**",
        "destination": "/forms-page"
      },
      {
        "source": "**",
        "destination": "/event-page.html"
      }
    ]
  }
}

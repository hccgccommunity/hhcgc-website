<script>
const API_BASE = 'https://facility-rental-api-217911937447.us-central1.run.app';

// Global loading indicator — every authedFetch call (which is to say,
// every database read or write this app makes) shows a spinner + dimmed
// background automatically, since users had no way to tell whether an
// action was in progress or had silently failed. Delay-gated so a fast
// request (<150ms) doesn't cause a flash; anything slower than that
// shows the overlay until every in-flight request completes (a counter,
// not a boolean, since multiple requests can overlap).
let __glPendingCount = 0;
let __glShowTimer = null;
function __glRequestStart() {
  __glPendingCount++;
  if (__glPendingCount === 1) {
    __glShowTimer = setTimeout(function () {
      var el = document.getElementById('global-loading-overlay');
      if (el) el.classList.add('visible');
    }, 150);
  }
}
function __glRequestEnd() {
  __glPendingCount = Math.max(0, __glPendingCount - 1);
  if (__glPendingCount === 0) {
    clearTimeout(__glShowTimer);
    var el = document.getElementById('global-loading-overlay');
    if (el) el.classList.remove('visible');
  }
}
async function authedFetch(url, options) {
  options = options || {};
  var user = window.__hccgcFirebaseUser;
  if (!user) throw new Error('Not signed in.');
  var token = await user.getIdToken();
  options.headers = Object.assign({}, options.headers, { 'Authorization': 'Bearer ' + token });
  __glRequestStart();
  try {
    return await fetch(url, options);
  } finally {
    __glRequestEnd();
  }
}
function escHtml(str) { return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
function formatDate(d) { if (!d) return '—'; return new Date(d + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
function formatTimestampDate(d) { if (!d) return '—'; return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
function money(n) { return '$' + Number(n).toFixed(2); }
function moneyRound(n) { return '$' + Math.round(Number(n)).toLocaleString('en-US'); }
function capitalizeStatus(s) { s = String(s || ''); return s.charAt(0).toUpperCase() + s.slice(1); }

// Shared CSV export — every statement download uses this so the format
// (statement name, org name, date range, then line items) stays consistent.
function csvCell(v) {
  const s = String(v === undefined || v === null ? '' : v);
  return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
}
function downloadCsv(filename, rows) {
  const csv = rows.map(function (row) { return row.map(csvCell).join(','); }).join('\r\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}
function statementCsvHeader(statementName, startDate, endDate) {
  return [
    ['Hindu Community Center of Greater Cincinnati'],
    [statementName],
    ['Date range', formatDate(startDate) + ' - ' + formatDate(endDate)],
    ['Generated', new Date().toLocaleString('en-US')],
    []
  ];
}


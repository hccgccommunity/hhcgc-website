// ── Manage attachments: optional invoice/receipt/reimbursement links ──
// Credit (incoming) transactions can attach a matching invoice. Debit
// (outgoing) transactions can attach either a Google Drive receipt link
// or a matching reimbursement. Entirely optional, never gates any other
// action — this modal is the one place to see and manage it, no
// secondary windows.
let attachmentContext = null; // { source, sourceKey, amount, payerEmail }
async function openManageAttachmentsModal(source, sourceKey, amount, description) {
  // Best-effort email extraction from whatever description text is
  // available — covers a real Zeffy donor email showing up in the
  // description, and a test payment's embedded email (see
  // testPaymentDescription on the backend) the same way.
  const emailMatch = String(description || '').match(/[\w.+-]+@[\w-]+\.[\w.-]+/);
  attachmentContext = { source: source, sourceKey: sourceKey, amount: amount, payerEmail: emailMatch ? emailMatch[0] : null };
  document.getElementById('attachment-result').style.display = 'none';
  document.getElementById('manage-attachments-overlay').style.display = 'flex';
  await refreshAttachmentModal();
}
async function refreshAttachmentModal() {
  if (!attachmentContext) return;
  const existingList = document.getElementById('attachment-existing-list');
  // Reuse the already-loaded TRANSACTIONS list (populated by loadTransactions)
  // rather than re-fetching — it's refreshed after every attach/detach below.
  const match = (TRANSACTIONS || []).find(function (t) { return t.source === attachmentContext.source && t.sourceKey === attachmentContext.sourceKey; });
  renderExistingAttachments(match ? (match.attachments || []) : []);
  renderAttachmentAddSection();
}

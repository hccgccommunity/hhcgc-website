<style>
:root {
  --bg: #fff9f1; --surface: #ffffff; --surface-soft: #fff6ea; --border: rgba(121,62,17,0.14);
  --text: #2c1b10; --muted: #6a5141; --saffron: #b55a18; --saffron-dark: #8d3e0d; --maroon: #7f2e16;
  --green: #2e7d4f; --green-bg: #e8f5ec; --red: #b3382c; --red-bg: #fbe9e7;
  --radius: 22px; --shadow: 0 18px 45px rgba(93,43,14,0.10);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Arial, Helvetica, sans-serif; background: radial-gradient(circle at top left, rgba(217,138,30,0.12), transparent 22%), radial-gradient(circle at top right, rgba(127,46,22,0.05), transparent 20%), var(--bg); color: var(--text); min-height: 100vh; }
.container { width: min(calc(100% - 32px), 1300px); margin: 0 auto; }
.site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,249,241,0.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
.nav { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 92px; padding: 12px 0; }
.site-header a.brand, .site-header a.brand:link, .site-header a.brand:visited { text-decoration: none; color: inherit; }
.brand { display: flex; align-items: center; gap: 16px; min-width: 0; }
.brand-logo-wrap { background: #fff; border: 1px solid var(--border); border-radius: 18px; padding: 8px; box-shadow: var(--shadow); flex-shrink: 0; }
.brand-logo { width: 88px; height: auto; border-radius: 12px; object-fit: contain; }
.brand-text h1 { margin: 0; font-size: 1.2rem; line-height: 1.15; color: var(--maroon); }
.site-header nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 18px; margin: 0; padding: 0; align-items: center; justify-content: flex-end; }
.site-header nav a, .site-header nav a:link, .site-header nav a:visited { font-weight: 700; color: var(--text); font-size: 0.96rem; text-decoration: none; }
.site-header nav a:hover { color: var(--saffron-dark); }
.menu-toggle { display: none; border: 0; background: transparent; padding: 6px 0; cursor: pointer; color: #2c1b10; align-self: flex-end; }
.menu-toggle .bar { display: block; width: 26px; height: 2px; margin: 5px 0; background: currentColor; }
@media (max-width: 768px) {
  .nav { flex-direction: column; align-items: stretch; gap: 8px; } .menu-toggle { display: inline-block; }
  .site-header nav { display: none; width: 100%; background: rgba(255,249,241,0.95); padding: 10px 0; }
  .site-header nav.is-open { display: block; } .site-header nav ul { flex-direction: column; gap: 14px; }
}
.page-hero { padding: 28px 0 22px; background: linear-gradient(135deg, var(--maroon) 0%, #4e1a09 100%); color: #fff; }
.page-hero h1 { font-family: Georgia, "Times New Roman", serif; font-size: 1.9rem; color: #fff; margin-bottom: 6px; }
.page-hero p { color: #ffffff; opacity: 0.9; font-size: 0.92rem; max-width: 620px; }
.back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 700; color: rgba(255,255,255,0.85); text-decoration: none; margin-bottom: 14px; }
.back-link:hover { color: #fff; text-decoration: underline; }

.tab-nav { background: var(--surface); border-bottom: 1px solid var(--border); }
.tab-nav ul { list-style: none; display: flex; gap: 4px; padding: 10px 0; flex-wrap: wrap; }
.tab-nav button { display: inline-block; padding: 8px 16px; border-radius: 999px; font-size: 0.86rem; font-weight: 700; color: var(--muted); background: none; border: none; cursor: pointer; transition: background 0.15s, color 0.15s; font-family: inherit; }
.tab-nav button.active { background: var(--surface-soft); color: var(--saffron-dark); }
.tab-nav button:not(.active):hover { background: var(--surface-soft); }

.tab-panel { display: none; padding: 24px 0 60px; }
.accounting-layout { display: flex; gap: 24px; align-items: flex-start; }
.accounting-sidenav { display: flex; flex-direction: column; gap: 2px; width: 210px; flex-shrink: 0; position: sticky; top: 16px; }
.acct-subtab-btn { display: block; width: 100%; text-align: left; font-family: inherit; padding: 10px 14px; border-radius: 10px; font-size: 0.88rem; font-weight: 700; color: var(--muted); background: none; border: none; cursor: pointer; transition: background 0.15s, color 0.15s; }
.acct-subtab-btn.active { background: var(--surface-soft); color: var(--saffron-dark); }
.acct-subtab-btn:not(.active):hover { background: var(--surface-soft); }
.accounting-content { flex: 1; min-width: 0; }
.acct-subtab-panel { display: none; }
.acct-subtab-panel.active { display: block; }
@media (max-width: 720px) {
  .accounting-layout { flex-direction: column; }
  .accounting-sidenav { flex-direction: row; overflow-x: auto; width: 100%; position: static; gap: 6px; }
}
.tab-panel.active { display: block; }

.sub-tab-nav { display: flex; gap: 8px; margin-bottom: 20px; border-bottom: 1px solid var(--border); padding-bottom: 14px; }
.sub-tab-btn { padding: 8px 16px; border-radius: 999px; font-size: 0.84rem; font-weight: 700; color: var(--muted); background: #fff; border: 1.5px solid var(--border); cursor: pointer; font-family: inherit; }
.et-tb-btn { min-width: 30px; padding: 5px 9px; font-size: 0.86rem; font-family: inherit; color: var(--ink, #2c1b10); background: #fff; border: 1.5px solid var(--border); border-radius: 6px; cursor: pointer; }
.et-tb-btn:hover { background: var(--surface-soft); }
.et-tb-btn.active { background: var(--saffron-dark); color: #fff; border-color: var(--saffron-dark); }
.nav-badge { display: inline-block; background: #b3382c; color: #fff; font-size: 0.68rem; font-weight: 700; padding: 1px 6px; border-radius: 999px; margin-left: 4px; vertical-align: middle; }
#et-body-editor:focus { outline: 2px solid var(--saffron-dark); outline-offset: -1px; }
#et-body-editor:empty:before { content: attr(data-placeholder); color: var(--muted); }
.sub-tab-btn.active { background: var(--saffron-dark); color: #fff; border-color: var(--saffron-dark); }
.sub-tab-panel { display: none; }
.sub-tab-panel.active { display: block; }

.toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-bottom: 16px; }
#global-loading-overlay { position: fixed; inset: 0; background: rgba(44,27,16,0.15); backdrop-filter: blur(1px); z-index: 999; display: none; align-items: center; justify-content: center; }
.payment-method-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.payment-method-card {
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  font-family: inherit; padding: 16px 8px; border: 1.5px solid var(--border); border-radius: 12px;
  background: #fff; cursor: pointer; transition: border-color 0.15s, background 0.15s, transform 0.1s;
}
.payment-method-card:hover { border-color: var(--saffron); background: var(--surface-soft); transform: translateY(-1px); }
.payment-method-card:active { transform: translateY(0); }
.payment-method-icon { font-size: 1.6rem; line-height: 1; }
.payment-method-label { font-size: 0.86rem; font-weight: 700; color: var(--text); }
#global-loading-overlay.visible { display: flex; }
#global-loading-overlay .spinner { width: 44px; height: 44px; border: 4px solid rgba(255,255,255,0.5); border-top-color: var(--saffron-dark); border-radius: 50%; animation: gl-spin 0.7s linear infinite; }
@keyframes gl-spin { to { transform: rotate(360deg); } }
.pagination-bar { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 20px 0 50px; }
.pagination-bar button { font-family: inherit; font-size: 0.84rem; padding: 7px 14px; border: 1.5px solid var(--border); border-radius: 8px; background: #fff; cursor: pointer; }
.pagination-bar button:hover:not(:disabled) { background: var(--surface-soft); }
.pagination-bar button:disabled { opacity: 0.4; cursor: default; }
.pagination-bar .page-indicator { font-size: 0.84rem; color: var(--muted); }
.contact-filter-wrap { position: relative; }
.contact-filter-panel { position: absolute; top: calc(100% + 4px); left: 0; z-index: 40; background: #fff; border: 1.5px solid var(--border); border-radius: 12px; box-shadow: var(--shadow); padding: 10px; width: 260px; max-height: 320px; overflow-y: auto; }
.contact-filter-actions { display: flex; gap: 8px; margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
.contact-filter-actions button { font-family: inherit; font-size: 0.76rem; font-weight: 700; color: var(--saffron-dark); background: none; border: none; cursor: pointer; padding: 2px 4px; }
.contact-filter-row { display: flex; align-items: center; gap: 8px; padding: 5px 4px; font-size: 0.86rem; }
.contact-filter-row input { flex-shrink: 0; }
.contact-filter-row label { cursor: pointer; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.gauge-track { background: var(--surface-soft); border-radius: 999px; height: 28px; overflow: hidden; position: relative; margin-bottom: 10px; }
.gauge-fill { height: 100%; border-radius: 999px; transition: width 0.3s ease; display: flex; align-items: center; justify-content: flex-end; padding-right: 10px; }
.gauge-fill.positive { background: linear-gradient(90deg, var(--green), #4caf7d); }
.gauge-fill.negative { background: linear-gradient(90deg, var(--red), #d9564a); }
.gauge-marker { position: absolute; top: -4px; bottom: -4px; width: 2px; background: var(--maroon); }
.gauge-labels { display: flex; justify-content: space-between; font-size: 0.82rem; color: var(--muted); }
.gauge-stats { display: flex; gap: 24px; margin-top: 16px; flex-wrap: wrap; }
.gauge-stat { flex: 1; min-width: 140px; }
.gauge-stat .label { font-size: 0.76rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px; }
.gauge-stat .value { font-size: 1.4rem; font-weight: 800; }
.gauge-stat .value.positive { color: var(--green); }
.gauge-stat .value.negative { color: var(--red); }

.bar-chart-row { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
.bar-chart-label { width: 190px; flex-shrink: 0; font-size: 0.86rem; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar-chart-track { flex: 1; background: var(--surface-soft); border-radius: 8px; height: 26px; position: relative; overflow: hidden; }
.bar-chart-fill { height: 100%; border-radius: 8px; background: linear-gradient(90deg, var(--saffron-dark), var(--saffron)); }
.bar-chart-value { width: 110px; flex-shrink: 0; text-align: right; font-weight: 700; font-size: 0.88rem; }

.pie-chart-wrap { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 8px 0; }
.pie-chart-wrap svg { flex-shrink: 0; width: 100%; max-width: 260px; height: auto; }
.pie-legend { width: 100%; max-width: 340px; }
.pie-legend-row { display: flex; align-items: center; gap: 8px; padding: 6px 0; font-size: 0.84rem; }
.pie-legend-dot { width: 11px; height: 11px; border-radius: 50%; flex-shrink: 0; }
.pie-legend-name { flex: 1; }
.pie-legend-value { font-weight: 700; white-space: nowrap; }

.stat-card-big { text-align: center; padding: 20px; }
.stat-card-big .value { font-size: 2.2rem; font-weight: 800; color: var(--maroon); }
.stat-card-big .sub { font-size: 0.86rem; color: var(--muted); margin-top: 6px; }

.trend-chart { display: flex; align-items: flex-end; gap: 14px; height: 200px; padding: 10px 4px 0; overflow-x: auto; }
.trend-month { display: flex; flex-direction: column; align-items: center; min-width: 64px; flex-shrink: 0; }
.trend-bars { display: flex; align-items: flex-end; gap: 4px; height: 150px; }
.trend-bar { width: 20px; border-radius: 4px 4px 0 0; position: relative; }
.trend-bar.income-bar { background: linear-gradient(180deg, #4caf7d, var(--green)); }
.trend-bar.expense-bar { background: linear-gradient(180deg, #d9564a, var(--red)); }
.trend-month-label { font-size: 0.72rem; color: var(--muted); margin-top: 8px; white-space: nowrap; }
.trend-legend { display: flex; gap: 18px; margin-bottom: 8px; font-size: 0.8rem; }
.trend-legend span { display: flex; align-items: center; gap: 6px; }
.trend-legend .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
.trend-legend .dot.income { background: var(--green); }
.trend-legend .dot.expense { background: var(--red); }

.contributor-row { display: flex; justify-content: space-between; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--border); font-size: 0.86rem; }
.contributor-row:last-child { border-bottom: none; }
.contributor-row .rank { width: 22px; color: var(--muted); font-weight: 700; }
.contributor-row .name { flex: 1; }
.contributor-row .meta { color: var(--muted); font-size: 0.76rem; }
.contributor-row .amount { font-weight: 700; }

.spinner {
  display: inline-block; width: 18px; height: 18px; border: 2.5px solid var(--border);
  border-top-color: var(--saffron-dark); border-radius: 50%; animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
#dash-content.is-loading { opacity: 0.4; pointer-events: none; filter: grayscale(0.4); transition: opacity 0.15s ease; }

.annual-trend-chart { display: flex; align-items: flex-end; gap: 8px; height: 180px; padding: 10px 4px 0; position: relative; }
.annual-trend-bar-wrap { display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 0; }
.annual-trend-bars { display: flex; align-items: flex-end; height: 140px; width: 100%; justify-content: center; }
.annual-trend-bar { width: 60%; border-radius: 4px 4px 0 0; }
.annual-trend-bar.above { background: linear-gradient(180deg, #4caf7d, var(--green)); }
.annual-trend-bar.below { background: linear-gradient(180deg, #d9564a, var(--red)); }
.annual-trend-month-label { font-size: 0.68rem; color: var(--muted); margin-top: 8px; white-space: nowrap; }
.annual-trend-threshold-line { position: absolute; left: 0; right: 0; border-top: 2px dashed var(--maroon); }
.annual-trend-threshold-label { position: absolute; left: 4px; top: -18px; font-size: 0.7rem; color: var(--maroon); font-weight: 700; background: var(--surface); padding: 0 4px; }
.toolbar input, .toolbar select {
  font-family: Arial, Helvetica, sans-serif; font-size: 0.88rem; padding: 9px 14px;
  border: 1.5px solid var(--border); border-radius: 10px; background: var(--surface); color: var(--text);
}
.toolbar .count { margin-left: auto; font-size: 0.82rem; color: var(--muted); }
.btn-primary {
  font-family: Arial, Helvetica, sans-serif; font-size: 0.88rem; font-weight: 700; color: #fff;
  background: linear-gradient(135deg, var(--saffron-dark), var(--maroon)); border: none; border-radius: 10px;
  padding: 10px 16px; cursor: pointer;
}
.btn-secondary {
  font-family: Arial, Helvetica, sans-serif; font-size: 0.86rem; font-weight: 700; color: var(--text);
  background: #fff; border: 1.5px solid var(--border); border-radius: 10px; padding: 9px 14px; cursor: pointer;
}

.table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow-x: auto; box-shadow: var(--shadow); }
table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
thead th { text-align: left; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); background: var(--surface-soft); padding: 10px 12px; border-bottom: 1px solid var(--border); white-space: nowrap; }
tbody td { padding: 10px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }
tbody tr:last-child td { border-bottom: none; }
tbody tr:hover { background: rgba(217,138,30,0.04); }
.amount { font-weight: 700; }
.amount.income { color: var(--green); }
.amount.expense { color: var(--red); }
.source-tag { display: inline-block; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; background: var(--surface-soft); color: var(--saffron-dark); }
tr.sub-row td { background: var(--surface-soft); }
tr.sub-row td:first-child { padding-left: 22px; border-left: 3px solid var(--saffron-dark); }
tr.cancelled-row { background: #fdf1ef; }
tr.cancelled-row td { color: var(--muted); }
tr.cancelled-row .renter-name, tr.cancelled-row .amount { text-decoration: line-through; text-decoration-color: var(--red); }
.method-tag { font-size: 0.72rem; color: var(--muted); display: block; margin-top: 2px; }
.discount-chip { display: inline-block; font-size: 0.68rem; font-weight: 700; color: var(--saffron-dark); background: var(--surface-soft); border-radius: 999px; padding: 2px 8px; }
tr.series-row:hover td { background: var(--surface-soft); }
.sortable-th { cursor: pointer; user-select: none; }
.sortable-th:hover { color: var(--saffron-dark); }
.sort-arrow { font-size: 0.7rem; opacity: 0.5; }
.sort-arrow.active { opacity: 1; color: var(--saffron-dark); }
.cat-select { font-family: inherit; font-size: 0.82rem; padding: 6px 10px; border: 1.5px solid var(--border); border-radius: 8px; background: #fff; }
.cat-select:disabled { background: var(--surface-soft); color: var(--muted); cursor: not-allowed; opacity: 0.85; }
.confirm-paid-select { font-family: inherit; font-size: 0.8rem; padding: 6px 8px; border: 1.5px solid var(--saffron-dark); border-radius: 8px; background: #fff; color: var(--saffron-dark); font-weight: 700; }
.cat-select.uncategorized { border-color: var(--red); background: var(--red-bg); }
.tx-row-checkbox { width: 16px; height: 16px; cursor: pointer; }
.tx-reviewed-circle { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--border); background: #fff; cursor: pointer; font-size: 0.72rem; font-weight: 900; color: #fff; vertical-align: middle; line-height: 1; padding: 0; }
.tx-reviewed-circle.is-reviewed { background: #1f6b3f; border-color: #1f6b3f; }
.tx-reviewed-circle:hover:not(.is-reviewed) { border-color: var(--saffron-dark); }
.tx-bulk-bar { display: flex; align-items: center; gap: 10px; font-size: 0.82rem; color: var(--muted); padding: 8px 4px; }
.tx-loading-overlay { position: relative; }
.tx-loading-overlay.is-loading::after { content: ''; position: absolute; inset: 0; background: rgba(255,255,255,0.6); backdrop-filter: blur(1px); z-index: 5; }
.tx-spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid var(--border); border-top-color: var(--saffron-dark); border-radius: 50%; animation: tx-spin 0.7s linear infinite; vertical-align: middle; margin-right: 6px; }
@keyframes tx-spin { to { transform: rotate(360deg); } }
.btn-note { border: 1px solid var(--border); background: #fff; border-radius: 6px; width: 24px; height: 24px; cursor: pointer; font-size: 0.76rem; vertical-align: middle; }
.btn-note.has-content { background: #bdedcf; border: 2px solid #1f6b3f; }
.invoice-action-btn { width: 100%; padding: 12px 16px; border-radius: 10px; border: 1.5px solid var(--border); background: #fff; font-family: inherit; font-size: 0.9rem; font-weight: 700; cursor: pointer; text-align: left; }
.invoice-action-btn:hover { background: var(--surface-soft); }
.invoice-action-btn.primary { background: linear-gradient(135deg, var(--saffron-dark), var(--maroon)); color: #fff; border: none; }
.btn-invoice { display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid var(--border); background: #fff; border-radius: 50%; width: 27px; height: 27px; cursor: pointer; font-size: 0.78rem; vertical-align: middle; line-height: 1; transition: transform 0.1s; }
.btn-attach-link { border: 1.5px dashed var(--border); background: #fff; border-radius: 8px; padding: 3px 8px; cursor: pointer; font-size: 0.72rem; color: var(--muted); }
.btn-attach-link:hover { border-color: var(--saffron); color: var(--saffron-dark); }
.btn-attach-link.has-attachments { border: 1.5px solid var(--saffron-dark); background: var(--surface-soft); padding: 3px 6px; }
.attachment-chip { font-size: 0.9rem; margin-right: 2px; }
.attachment-detail-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 10px; margin-bottom: 6px; font-size: 0.86rem; }
.attachment-detail-row .btn-remove-attachment { font-family: inherit; font-size: 0.72rem; color: var(--red); background: none; border: none; cursor: pointer; }
.btn-invoice.greyed { background: #f2efe9; border-color: #ddd6c8; opacity: 0.55; }
.btn-invoice.attached { background: #fff4d9; border-color: #dda520; box-shadow: 0 1px 4px rgba(221,165,32,0.35); }
.btn-invoice.sent { background: #e2f6e9; border-color: #2e9e5b; box-shadow: 0 1px 4px rgba(46,158,91,0.35); }
.btn-invoice:hover:not(.sent) { transform: scale(1.08); }
.btn-receipt { display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid var(--border); background: #fff; border-radius: 50%; width: 27px; height: 27px; cursor: pointer; font-size: 0.78rem; vertical-align: middle; line-height: 1; transition: transform 0.1s; }
.btn-receipt.greyed { background: #f2efe9; border-color: #ddd6c8; opacity: 0.55; }
.btn-receipt.attached { background: #fff4d9; border-color: #dda520; box-shadow: 0 1px 4px rgba(221,165,32,0.35); }
.btn-receipt.sent { background: #e2f6e9; border-color: #2e9e5b; box-shadow: 0 1px 4px rgba(46,158,91,0.35); }
.btn-receipt:disabled { cursor: default; }
.btn-receipt:hover:not(:disabled):not(.sent) { transform: scale(1.08); }
.btn-note:hover { background: var(--surface-soft); }
.collapsible-header { display: flex; align-items: center; justify-content: space-between; cursor: pointer; padding: 12px 0; }
.collapsible-header .toggle-arrow { transition: transform 0.15s ease; }
.collapsible-header.is-open .toggle-arrow { transform: rotate(90deg); }
.collapsible-body { display: none; }
.collapsible-body.is-open { display: block; }
.empty-state { text-align: center; padding: 60px 20px; color: var(--muted); }

.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 26px; box-shadow: var(--shadow); margin-bottom: 20px; }
.stmt-section-title { font-family: Georgia, "Times New Roman", serif; color: var(--maroon); font-size: 1.1rem; margin: 18px 0 8px; }
.stmt-row { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid var(--border); font-size: 0.92rem; }
.stmt-row .count { color: var(--muted); font-size: 0.78rem; margin-left: 6px; }
.stmt-total { display: flex; justify-content: space-between; padding: 12px 0; font-weight: 800; font-size: 1rem; border-top: 2px solid var(--border); margin-top: 6px; }
.stmt-net { display: flex; justify-content: space-between; padding: 16px 20px; border-radius: 14px; font-weight: 800; font-size: 1.2rem; margin-top: 16px; }
.stmt-net.positive { background: var(--green-bg); color: var(--green); }
.stmt-net.negative { background: var(--red-bg); color: var(--red); }

.recon-week-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 18px 20px; margin-bottom: 12px; }
.recon-week-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.recon-week-header .week-label { font-weight: 700; font-size: 0.94rem; }
.recon-week-header .expected { color: var(--muted); font-size: 0.84rem; }
.recon-candidate { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; border-radius: 10px; font-size: 0.86rem; margin-bottom: 6px; }
.recon-candidate.match { background: var(--green-bg); }
.recon-candidate.mismatch { background: var(--red-bg); }
.recon-none { color: var(--muted); font-size: 0.84rem; font-style: italic; }
.recon-week-card.recon-match-yes { border: 1.5px solid rgba(46,125,79,0.4); background: rgba(232,245,236,0.4); }
.recon-week-card.recon-match-no { border: 1.5px solid rgba(179,56,44,0.4); background: rgba(251,233,231,0.4); }
.recon-total-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; margin-top: 6px; border-top: 1px solid var(--border); font-weight: 700; font-size: 0.88rem; }
.recon-match-badge { font-size: 0.82rem; }
.recon-match-yes .recon-match-badge { color: var(--green); }
.recon-match-no .recon-match-badge { color: var(--red); }

.category-pill { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1.5px solid var(--border); border-radius: 999px; font-size: 0.86rem; }
.category-pill.inactive { opacity: 0.5; }
.category-pill .type-dot { width: 8px; height: 8px; border-radius: 50%; }
.category-pill .type-dot.income { background: var(--green); }
.category-pill .type-dot.expense { background: var(--red); }
.category-pill button { border: none; background: none; cursor: pointer; font-size: 0.76rem; font-weight: 700; color: var(--saffron-dark); padding: 0; margin-left: 4px; }
.category-list { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }

#gate{padding:60px 16px;display:flex;justify-content:center;}
.gate-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:2.5rem 2rem;max-width:420px;width:100%;text-align:center;box-shadow:var(--shadow);}
.gate-card h3{font-family:Georgia,serif;font-size:1.3rem;color:var(--maroon);margin-bottom:.5rem;}
.gate-card p{color:var(--muted);font-size:.88rem;line-height:1.6;}
.gate-card a{color:var(--saffron-dark);}
</style>
</head>

async function loadTransactions() {
  const start = document.getElementById('tx-start-date').value;
  const end = document.getElementById('tx-end-date').value;
  const status = document.getElementById('tx-status-filter').value;
  const params = new URLSearchParams({ startDate: start, endDate: end });
  if (status) params.set('status', status);

  ['tx-rental', 'tx-fundraising', 'tx-donations', 'tx-zeffy-refunds', 'tx-zelle', 'tx-other'].forEach(function (id) {
    document.getElementById(id + '-tbody').innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:24px;">Loading…</td></tr>';
  });
  setTabLoading('tab-transactions', true);
  try {
    const res = await authedFetch(API_BASE + '/finance/transactions?' + params.toString());
    const data = await res.json();
    if (!res.ok) throw new Error((data.errors || [data.error || ('Server returned ' + res.status)]).join(' '));
    TRANSACTIONS = [].concat(data.facilityRental, data.donations, data.fundraising, data.zelle, data.zeffyRefunds, data.other);
    const totalCount = TRANSACTIONS.length;
    document.getElementById('tx-count').textContent = totalCount + ' entries';

    const linkedFilter = document.getElementById('tx-linked-filter').value;
    const applyLinkedFilter = function (list) {
      if (!linkedFilter) return list;
      return list.filter(function (t) {
        const hasLink = t.attachments && t.attachments.length > 0;
        return linkedFilter === 'linked' ? hasLink : !hasLink;
      });
    };
    const filteredRental = applyLinkedFilter(data.facilityRental);
    const filteredZelle = applyLinkedFilter(data.zelle);
    const filteredOther = applyLinkedFilter(data.other);

    renderGroup('tx-rental', filteredRental, renderRentalLineRow, 'No Facility Rental activity in this range.');
    document.getElementById('rental-count').textContent = filteredRental.length ? '(' + filteredRental.length + ')' : '(none)';
    renderGroup('tx-fundraising', data.fundraising, renderZeffyCampaignRow, 'No Fundraising activity in this range.');
    document.getElementById('fundraising-count').textContent = data.fundraising.length ? '(' + data.fundraising.length + ')' : '(none)';
    renderGroup('tx-donations', data.donations, renderZeffyCampaignRow, 'No donation activity in this range.');
    document.getElementById('donations-count').textContent = data.donations.length ? '(' + data.donations.length + ')' : '(none)';
    renderGroup('tx-zeffy-refunds', data.zeffyRefunds, function (t) { return renderTxRow(t, false); }, 'No Zeffy refunds in this range.');
    document.getElementById('zeffy-refunds-count').textContent = data.zeffyRefunds.length ? '(' + data.zeffyRefunds.length + ')' : '(none)';
    renderGroup('tx-zelle', filteredZelle, function (t) { return renderTxRow(t, false); }, 'No Zelle transactions in this range.');
    renderGroup('tx-other', filteredOther, function (t) { return renderTxRow(t, false, true); }, 'No other transactions in this range.');
    populateCategorySelects();
  } catch (err) {
    ['tx-rental', 'tx-fundraising', 'tx-donations', 'tx-zeffy-refunds', 'tx-zelle', 'tx-other'].forEach(function (id) {
      document.getElementById(id + '-tbody').innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--red);padding:24px;">Could not load: ' + escHtml(err.message) + '</td></tr>';
    });
  } finally {
    setTabLoading('tab-transactions', false);
  }
}

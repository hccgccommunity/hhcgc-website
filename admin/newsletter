async function doSend(testOnly) {
  var subject = document.getElementById('send-subject').value.trim();
  var bodyHtml = document.getElementById('send-body').innerHTML.trim();
  var filename = (document.getElementById('send-filename').value.trim() || pdfName());
  if (!/\.pdf$/i.test(filename)) filename += '.pdf';
  if (!subject) { sendSay('Add a subject.', 'error'); return; }
  if (!bodyHtml) { sendSay('The email body is empty.', 'error'); return; }
  if (!testOnly && !window.confirm(
    'Send this to the FULL list?\n\n' + document.getElementById('send-reach').textContent +
    '\n\nThis is not a test. It cannot be undone.')) return;

  var btns = [document.getElementById('btn-send-test'), document.getElementById('btn-send-all')];
  btns.forEach(function (b) { b.disabled = true; });
  sendSay('Building the PDF…');
  try {
    if (DIRTY) { try { await saveDoc(true); } catch (e) {} }
    var pdf = await buildPdf();
    var base64 = pdf.output('datauristring').split(',')[1];
    sendSay(testOnly ? 'Sending test…' : 'Sending…');
    var r = await authedFetch(API_BASE + '/newsletter/send', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        newsletterId: DOC.id, newsletterTitle: DOC.title,
        subject: subject, bodyHtml: bodyHtml,
        segment: currentSegment(), testOnly: !!testOnly,
        pdfBase64: base64, filename: filename
      })
    });
    if (r.status === 404) {
      sendSay('The /newsletter/send endpoint is not deployed yet. The PDF and everything else here works — sending switches on once the API is updated.', 'error');
      return;
    }
    var d = await r.json().catch(function () { return {}; });
    if (!r.ok) { sendSay((d.errors || [d.error] || ['Server returned ' + r.status]).join(' '), 'error'); return; }
    sendSay(d.test
      ? 'Test sent to you only (' + (d.sent || 1) + ' of 1). Nobody else received it.'
      : 'Sent to ' + d.sent + ' of ' + d.recipientCount + (d.failed ? ' · ' + d.failed + ' failed' : '') + '.', 'success');
    if (!d.test) { loadHistory(); loadLibrary(); }
  } catch (err) {
    sendSay('Could not send: ' + err.message, 'error');
  } finally {
    btns.forEach(function (b) { b.disabled = false; });
  }
}
document.getElementById('btn-send-test').addEventListener('click', function () { doSend(true); });
document.getElementById('btn-send-all').addEventListener('click', function () { doSend(false); });


      const data = await res.json();
      if (!res.ok) { alert('Could not send invoice: ' + ((data.errors || [data.error]).join(' ') || 'unknown error')); return; }
      await loadInvoices();
    } catch (err) {
      alert('Could not reach the server: ' + err.message);
    }
  }
});

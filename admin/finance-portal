async function loadExpenseSubmissions() {
  const status = document.getElementById('exp-status-filter').value;
  const monthFilter = document.getElementById('exp-month-filter').value; // 'YYYY-MM' or ''
  const list = document.getElementById('expenses-submission-list');
  const totalEl = document.getElementById('exp-month-total');
  list.innerHTML = '<div class="empty-state">Loading…</div>';
  totalEl.textContent = '';
  setTabLoading('tab-expenses', true);
  try {
    const res = await authedFetch(API_BASE + '/finance/expense-submissions' + (status ? '?status=' + status : ''));
    EXPENSE_SUBMISSIONS = await res.json();
    // Attribute each expense to the month it was actually incurred (its
    // own expense_date), not when it was submitted, approved, or paid -
    // a submission made in one month can easily include expenses from an
    // earlier one, and those should count toward that earlier month.
    const bySubmission = EXPENSE_SUBMISSIONS.map(function (s) {
      const matchingItems = monthFilter ? s.items.filter(function (i) { return (i.expense_date || '').slice(0, 7) === monthFilter; }) : s.items;
      return { submission: s, matchingItems: matchingItems };
    }).filter(function (x) { return x.matchingItems.length > 0; });
    if (!bySubmission.length) { list.innerHTML = '<div class="empty-state">Nothing here.</div>'; return; }
    if (monthFilter) {
      const monthTotal = bySubmission.reduce(function (sum, x) { return sum + x.matchingItems.reduce(function (s2, i) { return s2 + i.amount; }, 0); }, 0);
      totalEl.textContent = 'Total for ' + monthFilter + ': ' + money(monthTotal);
    }
    list.innerHTML = bySubmission.map(function (x) {
      const s = x.submission;
      const total = x.matchingItems.reduce(function (sum, i) { return sum + i.amount; }, 0);
      const countLabel = monthFilter && x.matchingItems.length !== s.items.length
        ? x.matchingItems.length + ' of ' + s.items.length + ' expense(s) in this month'
        : s.items.length + ' expense(s)';
      return '<div class="exp-submission-card">' +
        '<div class="exp-sub-info"><strong>' + escHtml(s.firstName) + ' ' + escHtml(s.lastName) + '</strong> — ' + countLabel + '<br>' +
        '<span style="color:var(--muted);font-size:0.82rem;">' + escHtml(s.email) + ' · Zelle: ' + escHtml(s.zelleId || '—') + '</span></div>' +
        '<div style="display:flex;align-items:center;gap:16px;"><span class="exp-sub-total">' + money(total) + '</span>' +
        '<button type="button" class="btn-secondary" data-review-submission="' + s.submissionId + '">Review</button></div>' +
      '</div>';
    }).join('');
  } catch (err) {
    list.innerHTML = '<div class="empty-state">Could not load: ' + escHtml(err.message) + '</div>';
  } finally {
    setTabLoading('tab-expenses', false);
  }
}

<style>
:root {
  --bg: #fff9f1;
  --surface: #ffffff;
  --surface-soft: #fff6ea;
  --border: rgba(121,62,17,0.14);
  --text: #2c1b10;
  --muted: #6a5141;
  --saffron: #b55a18;
  --saffron-dark: #8d3e0d;
  --maroon: #7f2e16;
  --radius: 22px;
  --shadow: 0 18px 45px rgba(93,43,14,0.10);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at top left, rgba(217,138,30,0.12), transparent 22%),
    radial-gradient(circle at top right, rgba(127,46,22,0.05), transparent 20%),
    var(--bg);
  color: var(--text);
  min-height: 100vh;
}

.container { width: min(calc(100% - 32px), 1000px); margin: 0 auto; }

/* Header partial styling — required by header.html's markup. */
.site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 249, 241, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
}
.nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 92px;
    padding: 12px 0;
}
.site-header a.brand,
.site-header a.brand:link,
.site-header a.brand:visited {
  text-decoration: none;
  color: inherit;
}
.brand { display: flex; align-items: center; gap: 16px; min-width: 0; }
.brand-logo-wrap {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 8px;
    box-shadow: var(--shadow);
    flex-shrink: 0;
}
.brand-logo { width: 88px; height: auto; border-radius: 12px; object-fit: contain; }
.brand-text h1 { margin: 0; font-size: 1.2rem; line-height: 1.15; color: var(--maroon); }
.site-header nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: flex-end;
}
.site-header nav a,
.site-header nav a:link,
.site-header nav a:visited { font-weight: 700; color: var(--text); font-size: 0.96rem; text-decoration: none; }
.site-header nav a:hover { color: var(--saffron-dark); }
.menu-toggle {
    display: none;
    border: 0;
    background: transparent;
    padding: 6px 0;
    cursor: pointer;
    color: #2c1b10;
    align-self: flex-end;
}
.menu-toggle .bar { display: block; width: 26px; height: 2px; margin: 5px 0; background: currentColor; }
@media (max-width: 768px) {
    .nav { flex-direction: column; align-items: stretch; gap: 8px; }
    .menu-toggle { display: inline-block; }
    .site-header nav {
        display: none;
        width: 100%;
        background: rgba(255, 249, 241, 0.95);
        padding: 10px 0;
    }
    .site-header nav.is-open { display: block; }
    .site-header nav ul { flex-direction: column; gap: 14px; }
}

.back-link-row {
  padding: 16px 0 0;
  font-size: 0.82rem;
}
.back-link-row a { color: var(--saffron-dark); text-decoration: none; }
.back-link-row a:hover { text-decoration: underline; }

#gate { padding: 60px 16px; display: flex; justify-content: center; }
.gate-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 2.5rem 2rem; max-width: 420px; width: 100%; text-align: center; box-shadow: var(--shadow);
}
.gate-card h3 { font-family: Georgia, serif; font-size: 1.3rem; color: var(--maroon); margin-bottom: 0.5rem; }
.gate-card p { color: var(--muted); font-size: 0.88rem; line-height: 1.6; }
.gate-card a { color: var(--saffron-dark); }

#app { display: none; }

.page-header { padding: 40px 0 20px; }
.tab-nav { background: var(--surface); border-bottom: 1px solid var(--border); }
.tab-nav ul { list-style: none; display: flex; gap: 4px; padding: 10px 0; flex-wrap: wrap; }
.tab-nav button { display: inline-block; padding: 8px 16px; border-radius: 999px; font-size: 0.86rem; font-weight: 700; color: var(--muted); background: none; border: none; cursor: pointer; transition: background 0.15s, color 0.15s; font-family: inherit; }
.tab-nav button.active { background: var(--surface-soft); color: var(--saffron-dark); }
.tab-nav button:not(.active):hover { background: var(--surface-soft); }
.tab-panel { display: none; padding: 24px 0 60px; }
.tab-panel.active { display: block; }
.page-header h1 { font-family: Georgia, "Times New Roman", serif; font-size: 1.8rem; color: var(--maroon); margin-bottom: 8px; }
.page-header p { color: var(--muted); font-size: 0.9rem; }

.status-bar {
  display: none; align-items: center; gap: 10px;
  padding: 0.75rem 1.1rem; border-radius: 12px;
  font-size: 0.86rem; font-weight: 600; margin: 0 0 1.25rem;
}
.status-bar.show { display: flex; }
.status-bar.success { background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; }
.status-bar.error { background: #fdecea; color: #c0392b; border: 1px solid #f5c6cb; }

.btn-add {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 0.7rem 1.4rem; background: var(--maroon); color: #fff;
  border: none; border-radius: 999px; font-size: 0.9rem; font-weight: 700;
  cursor: pointer; font-family: Arial, Helvetica, sans-serif; margin-bottom: 1.5rem;
}
.btn-add:hover { background: #5a1e0a; }

.user-table { display: flex; flex-direction: column; gap: 12px; padding-bottom: 60px; }

.user-row {
  background: #fff; border: 1px solid var(--border); border-radius: 14px;
  padding: 1.1rem 1.4rem; display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
}

.user-avatar-sm {
  width: 38px; height: 38px; border-radius: 50%;
  background: var(--maroon); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 0.8rem; font-weight: 700; flex-shrink: 0;
}

.user-info { flex: 1; min-width: 180px; }
.user-info .name { font-weight: 700; font-size: 0.92rem; }
.user-info .email { font-size: 0.8rem; color: var(--muted); }

.admin-pill {
  font-size: 0.68rem; font-weight: 800; text-transform: uppercase;
  letter-spacing: 0.04em; color: var(--saffron-dark);
  background: rgba(217,138,30,0.14); padding: 2px 9px; border-radius: 999px; margin-left: 8px;
}

.app-checkboxes { display: flex; flex-wrap: wrap; gap: 10px; flex: 2; min-width: 220px; }

.app-check {
  display: flex; align-items: center; gap: 6px;
  font-size: 0.82rem; color: var(--text);
  background: var(--surface-soft); border: 1px solid var(--border);
  padding: 5px 10px; border-radius: 8px; cursor: pointer;
}
.app-check input { cursor: pointer; }

.row-actions { display: flex; align-items: center; gap: 8px; }
.admin-toggle { display: flex; align-items: center; gap: 6px; font-size: 0.78rem; color: var(--muted); cursor: pointer; }

.btn-icon {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 0.4rem 0.75rem; border: 1px solid var(--border); border-radius: 8px;
  background: #fff; font-size: 0.76rem; font-weight: 600; color: var(--muted);
  cursor: pointer; font-family: Arial, Helvetica, sans-serif;
}
.btn-icon:hover { border-color: var(--saffron); color: var(--saffron-dark); }
.btn-icon.danger:hover { border-color: #c0392b; color: #c0392b; }
.btn-icon:disabled { opacity: 0.4; cursor: not-allowed; }

.empty-state {
  text-align: center; padding: 50px 20px; color: var(--muted);
  background: #fff; border: 1px dashed var(--border); border-radius: 16px;
}

.modal-overlay {
  display: none; position: fixed; inset: 0; background: rgba(44,27,16,0.45);
  z-index: 200; align-items: center; justify-content: center; padding: 20px;
}
.modal-overlay.show { display: flex; }
.modal-card { background: #fff; border-radius: 18px; max-width: 460px; width: 100%; box-shadow: var(--shadow); }
.modal-header {
  padding: 1.4rem 1.6rem; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
}
.modal-header h3 { font-family: Georgia, serif; color: var(--maroon); font-size: 1.15rem; }
.modal-close { background: none; border: none; cursor: pointer; color: var(--muted); font-size: 1.3rem; }
.modal-body { padding: 1.5rem 1.6rem; }
.form-group { margin-bottom: 1.1rem; }
label { display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.4rem; }
input[type="text"], input[type="email"] {
  width: 100%; padding: 0.6rem 0.85rem; border: 1.5px solid var(--border);
  border-radius: 10px; font-size: 0.9rem; font-family: Arial, Helvetica, sans-serif;
}
input:focus { outline: none; border-color: var(--saffron); box-shadow: 0 0 0 3px rgba(181,90,24,0.14); }
.modal-footer {
  padding: 1.2rem 1.6rem 1.5rem; display: flex; justify-content: flex-end;
  gap: 10px; border-top: 1px solid var(--border);
}
.btn-secondary {
  padding: 0.6rem 1.2rem; border-radius: 10px; border: 1.5px solid var(--border);
  background: #fff; color: var(--muted); font-weight: 700; font-size: 0.86rem; cursor: pointer;
}
.btn-small {
  padding: 3px 10px; border-radius: 8px; border: 1.5px solid var(--border);
  background: #fff; color: var(--muted); font-weight: 700; font-size: 0.78rem; cursor: pointer;
}
.btn-save {
  padding: 0.6rem 1.4rem; border-radius: 10px; border: none;
  background: var(--maroon); color: #fff; font-weight: 700; font-size: 0.86rem; cursor: pointer;
}
.btn-save:hover { background: #5a1e0a; }
.field-hint { font-size: 0.76rem; color: var(--muted); margin-top: 4px; }

@media (max-width: 640px) {
  .user-row { flex-direction: column; align-items: stretch; }
}
</style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TPBF5VKB" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<div id="site-header"></div>

<div class="container back-link-row">
  <a href="admin-portal">&larr; Back to apps</a>
</div>

<div id="gate">
  <div class="gate-card">
    <h3>Checking access&hellip;</h3>
    <p>Please sign in from the <a href="admin-portal">main portal page</a> first.</p>
  </div>
</div>

<div id="app">
  <div class="container">
    <div class="page-header">
      <h1>Admin of Admin</h1>
      <p>User access, system settings, and admin-only data management for HCCGC staff.</p>
    </div>
  </div>

  <div class="tab-nav">
    <div class="container">
      <ul>
        <li><button class="tab-btn active" data-tab="users">User Management</button></li>
        <li><button class="tab-btn" data-tab="settings">System Settings</button></li>
        <li><button class="tab-btn" data-tab="delete-renter">Data Management</button></li>
      </ul>
    </div>
  </div>

  <div class="container">

  <div class="tab-panel active" id="tab-users">
    <div class="status-bar" id="status-bar"></div>

    <button class="btn-add" id="btn-add-user">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add User
    </button>

    <div class="user-table" id="user-table">
      <div class="empty-state">Loading users&hellip;</div>
    </div>
  </div>

  <div class="tab-panel" id="tab-settings">
    <div class="user-table" style="padding:20px;">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
        <input type="checkbox" id="setting-test-mode" style="width:18px;height:18px;">
        <label for="setting-test-mode" style="font-weight:700;">Test mode</label>
      </div>
      <div class="field-hint" style="margin:-10px 0 16px 28px;">When on, every external email from Finance Portal and the Facility Rental Portal (invoices, receipts, approvals, reminders, everything) goes to the pseudo email below instead of the real renter.</div>
      <div class="form-group">
        <label for="setting-test-email">Pseudo/test email (used only while test mode is on)</label>
        <input type="email" id="setting-test-email" placeholder="tech-admin@hccgc.org">
      </div>

      <div style="margin-top:28px;padding-top:20px;border-top:1px solid var(--border, #eee2d3);">
        <div style="font-weight:700;margin-bottom:4px;">User-based test mode</div>
        <div class="field-hint" style="margin:0 0 14px;">Different from test mode above: while checked for a user, nothing they trigger — creating a booking, editing one, cancelling one, approving/rejecting a request, sending an invoice or receipt — reaches the real external or internal recipient. It redirects to that user's own inbox instead, so they can see exactly what would have gone out. Everyone else's actions keep sending normally, unaffected.</div>
        <div id="user-test-mode-list"></div>
      </div>

      <div style="margin-top:28px;padding-top:20px;border-top:1px solid var(--border, #eee2d3);">
        <div style="font-weight:700;margin-bottom:4px;">Public test emails (Facility Rental request form)</div>
        <div class="field-hint" style="margin:0 0 14px;">When someone submits a facility request using one of these email addresses, the request still goes through every normal flow — created, still needs approval, still shows in All Bookings — but the internal "new request" alert email is skipped, and it won't count toward the pending-request notification badge. The renter-facing confirmation email still sends as usual.</div>
        <div id="public-test-emails-list" style="margin-bottom:10px;"></div>
        <div style="display:flex;gap:8px;">
          <input type="email" id="public-test-email-input" placeholder="test@example.com" style="flex:1;">
          <button type="button" class="btn-secondary" id="btn-add-public-test-email">Add</button>
        </div>
      </div>

      <button class="btn-add" id="btn-save-settings" style="margin-top:20px;">Save settings</button>
      <div class="field-hint" id="settings-save-result" style="margin-top:10px;"></div>
    </div>
  </div>

  <div class="tab-panel" id="tab-delete-renter">
    <div class="user-table" style="padding:20px;">
      <p class="field-hint" style="margin:0 0 16px;color:var(--red, #b3382c);font-weight:700;">Admin only. This permanently deletes a renter and every one of their bookings — invoices, receipts, payment history, all of it. There is no undo. Intended for cleaning up test or duplicate records, not real customer data.</p>

      <div class="form-group">
        <label for="dr-renter-select">Renter</label>
        <select id="dr-renter-select">
          <option value="">Select a renter&hellip;</option>
        </select>
      </div>

      <div id="dr-preview" style="display:none;margin-top:16px;">
        <div class="field-hint" id="dr-preview-summary" style="margin-bottom:10px;"></div>
        <div class="field-hint" style="margin-bottom:8px;">Check specific bookings to delete just those and keep the renter, or leave all checked and use "Delete renter & all bookings" below to remove everything.</div>
        <div id="dr-bookings-list" style="max-height:240px;overflow-y:auto;border:1.5px solid var(--border);border-radius:10px;padding:10px 14px;margin-bottom:16px;font-size:0.86rem;"></div>

        <div class="form-group">
          <label for="dr-confirm-name">Type the renter's name exactly to confirm: <strong id="dr-confirm-target"></strong></label>
          <input type="text" id="dr-confirm-name" placeholder="Type name here">
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <button class="btn-add" id="btn-delete-selected-bookings" style="background:var(--red, #b3382c);margin-top:8px;">Delete selected booking(s) only</button>
          <button class="btn-add" id="btn-delete-renter" style="background:var(--red, #b3382c);margin-top:8px;">Permanently delete renter &amp; all bookings</button>
        </div>
        <div class="field-hint" id="dr-delete-result" style="margin-top:10px;"></div>
      </div>
    </div>

    <div class="user-table" style="padding:20px;margin-top:28px;">
      <p class="field-hint" style="margin:0 0 16px;color:var(--red, #b3382c);font-weight:700;">Admin only. Deletes an internal HCCGC event/program — no renter is attached to these, so they're selected here separately. If the event recurs, every occurrence in the series is deleted together. There is no undo.</p>

      <div class="form-group">
        <label for="di-event-select">Internal event</label>
        <select id="di-event-select">
          <option value="">Select an internal event&hellip;</option>
        </select>
      </div>

      <div id="di-preview" style="display:none;margin-top:16px;">
        <div class="field-hint" id="di-preview-summary" style="margin-bottom:10px;"></div>
        <div id="di-bookings-list" style="max-height:240px;overflow-y:auto;border:1.5px solid var(--border);border-radius:10px;padding:10px 14px;margin-bottom:16px;font-size:0.86rem;"></div>

        <div class="form-group">
          <label for="di-confirm-name">Type the event's name exactly to confirm: <strong id="di-confirm-target"></strong></label>
          <input type="text" id="di-confirm-name" placeholder="Type name here">
        </div>
        <button class="btn-add" id="btn-delete-internal" style="background:var(--red, #b3382c);margin-top:8px;">Permanently delete this internal event</button>
        <div class="field-hint" id="di-delete-result" style="margin-top:10px;"></div>
      </div>
    </div>

    <div class="user-table" style="padding:20px;margin-top:28px;border:2px solid var(--red, #b3382c);">
      <h2 style="font-size:1.1rem;margin:0 0 10px;color:var(--red, #b3382c);">Delete All Data</h2>
      <p class="field-hint" style="margin:0 0 16px;color:var(--red, #b3382c);font-weight:700;">Admin only. Wipes every renter and every booking in the entire system — not one record, all of them. There is no undo, no backup taken here. Only use this if you intend to fully reload from a Picktime export immediately after.</p>
      <div class="field-hint" id="da-counts" style="margin-bottom:12px;">Loading current counts&hellip;</div>
      <div class="form-group">
        <label for="da-confirm-phrase">Type <strong>DELETE ALL DATA</strong> exactly to confirm</label>
        <input type="text" id="da-confirm-phrase" placeholder="DELETE ALL DATA">
      </div>
      <button class="btn-add" id="btn-delete-all-data" style="background:var(--red, #b3382c);margin-top:8px;">Permanently delete all renters &amp; bookings</button>
      <div class="field-hint" id="da-result" style="margin-top:10px;"></div>
    </div>

    <div class="user-table" style="padding:20px;margin-top:28px;">
      <h2 style="font-size:1.1rem;margin:0 0 10px;">Picktime Import</h2>
      <p class="field-hint" style="margin:0 0 16px;">Upload a Picktime export (CSV). Nothing is written to the database until you review the preview below and separately confirm — column matching is a best guess (Picktime's exact export format hasn't been verified against a real file), so check the preview carefully before importing, especially the first time.</p>
      <div class="form-group">
        <label for="pi-file-input">Picktime export file (CSV)</label>
        <input type="file" id="pi-file-input" accept=".csv">
      </div>
      <button class="btn-add" id="btn-parse-picktime" style="margin-top:8px;">Parse &amp; preview</button>
      <div class="field-hint" id="pi-parse-result" style="margin-top:10px;"></div>

      <div id="pi-preview" style="display:none;margin-top:20px;">
        <div class="field-hint" id="pi-preview-summary" style="margin-bottom:10px;font-weight:700;"></div>
        <div id="pi-warnings" style="margin-bottom:12px;"></div>
        <div id="pi-rows-table" style="max-height:320px;overflow-y:auto;border:1.5px solid var(--border);border-radius:10px;padding:10px 14px;margin-bottom:16px;font-size:0.82rem;"></div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
          <input type="checkbox" id="pi-skip-duplicates" checked style="width:18px;height:18px;">
          <label for="pi-skip-duplicates" style="font-weight:700;">Skip rows already imported (incremental load)</label>
        </div>
        <p class="field-hint" style="margin:0 0 14px;">Uncheck this only right after Delete All Data, when there's nothing to skip — otherwise duplicates will be created.</p>
        <button class="btn-add" id="btn-commit-picktime" style="margin-top:0;">Import these bookings</button>
        <div class="field-hint" id="pi-commit-result" style="margin-top:10px;"></div>
      </div>
    </div>

    <div class="user-table" style="padding:20px;margin-top:28px;">
      <h2 style="font-size:1.1rem;margin:0 0 10px;">Test Payments</h2>
      <p class="field-hint" style="margin:0 0 16px;">Creates a fake bank transaction (marked clearly as a test) so you can test payment matching, reconciliation, and invoice linking without waiting for a real payment. Edit or delete any test payment below at any time.</p>

      <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;margin-bottom:20px;">
        <div class="form-group" style="margin-bottom:0;">
          <label for="tp-date">Date</label>
          <input type="date" id="tp-date">
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label for="tp-amount">Amount</label>
          <input type="number" id="tp-amount" step="0.01" min="0" placeholder="0.00">
        </div>

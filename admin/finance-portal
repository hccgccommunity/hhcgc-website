document.getElementById('btn-save-template').addEventListener('click', async function () {
  const resultEl = document.getElementById('et-result');
  resultEl.style.display = 'none';
  const payload = {
    type: currentTemplateType,
    subject: document.getElementById('et-subject').value,
    body: document.getElementById('et-body-editor').innerHTML
  };
  if (currentTemplateType === 'receipt') {
    payload.attachmentEnabled = document.getElementById('et-attachment-enabled').checked;
    payload.attachmentFilename = document.getElementById('et-attachment-filename').value;
    const fileInput = document.getElementById('et-attachment-file');
    if (fileInput.files && fileInput.files[0]) {
      payload.attachmentBase64 = await new Promise(function (resolve, reject) {
        const reader = new FileReader();
        reader.onload = function () { resolve(reader.result.split(',')[1]); };
        reader.onerror = reject;
        reader.readAsDataURL(fileInput.files[0]);
      });
    }
  }
  if (currentTemplateType === 'reminder') {
    payload.reminderHoursBefore = Number(document.getElementById('et-reminder-hours').value);
  }
  try {
    const res = await authedFetch(API_BASE + '/admin/email-templates', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (!res.ok) { resultEl.className = 'result-box error'; resultEl.style.display = 'block'; resultEl.textContent = (data.errors || [data.error]).join(' ') || 'Could not save.'; return; }
    resultEl.className = 'result-box success'; resultEl.style.display = 'block'; resultEl.textContent = 'Saved.';
    await loadEmailTemplates();
  } catch (err) {
    resultEl.className = 'result-box error'; resultEl.style.display = 'block'; resultEl.textContent = 'Could not reach the server: ' + err.message;
  }
});


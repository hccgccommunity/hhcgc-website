/* ── PDF ─────────────────────────────────────────────────────────────
   html2canvas taints on a cross-origin image, so every picture is turned
   into a data URL first. A direct fetch is tried before the API proxy so a
   correctly CORS-configured bucket costs nothing extra.                  */
var IMG_CACHE = {};
async function toDataUrl(url) {
  if (IMG_CACHE[url]) return IMG_CACHE[url];
  var blob = null;
  try {
    var r = await fetch(url, { mode: 'cors', cache: 'force-cache' });
    if (r.ok) blob = await r.blob();
  } catch (e) { /* fall through to the proxy */ }
  if (!blob) {
    try {
      var pr = await authedFetch(API_BASE + '/newsletter/image-proxy?url=' + encodeURIComponent(url));
      if (pr.ok) {
        var pd = await pr.json();
        if (pd.dataUrl) { IMG_CACHE[url] = pd.dataUrl; return pd.dataUrl; }
      }
    } catch (e) { /* give up quietly — the page still renders without it */ }
    return null;
  }
  var dataUrl = await new Promise(function (res) {
    var fr = new FileReader();
    fr.onload = function () { res(String(fr.result)); };
    fr.onerror = function () { res(null); };
    fr.readAsDataURL(blob);
  });
  if (dataUrl) IMG_CACHE[url] = dataUrl;
  return dataUrl;
}
async function inlineImages() {
  var imgs = Array.prototype.slice.call(canvasEl.querySelectorAll('img'));
  var originals = [];
  for (var i = 0; i < imgs.length; i++) {
    var src = imgs[i].getAttribute('src') || '';
    if (!src || src.indexOf('data:') === 0) continue;
    var d = await toDataUrl(src);
    if (d) { originals.push([imgs[i], src]); imgs[i].setAttribute('src', d); }
  }
  await Promise.all(imgs.map(function (im) {
    if (im.complete) return Promise.resolve();
    return new Promise(function (res) { im.onload = im.onerror = res; });
  }));
  return originals;
}

async function buildPdf() {
  syncFromDom();
  var prevZoom = ZOOM;
  ZOOM = '1'; applyZoom();
  canvasEl.classList.remove('nl-editing');
  canvasEl.classList.add('nl-printing');
  canvasEl.querySelectorAll('.nl-page').forEach(function (p) { p.classList.remove('focused'); });
  var restored = [];
  try {
    restored = await inlineImages();
    var jsPDFCtor = (window.jspdf && window.jspdf.jsPDF) || window.jsPDF;
    var pdf = new jsPDFCtor({ unit: 'pt', format: 'letter', orientation: 'portrait' });
    var pages = canvasEl.querySelectorAll('.nl-page');
    for (var i = 0; i < pages.length; i++) {
      var c = await html2canvas(pages[i], {
        scale: 2, useCORS: true, backgroundColor: '#ffffff',
        width: 816, height: 1056, windowWidth: 816, scrollX: 0, scrollY: 0
      });
      var img = c.toDataURL('image/jpeg', 0.92);
      if (i > 0) pdf.addPage('letter', 'portrait');
      pdf.addImage(img, 'JPEG', 0, 0, 612, 792, undefined, 'FAST');
    }
    return pdf;
  } finally {
    restored.forEach(function (pair) { pair[0].setAttribute('src', pair[1]); });
    canvasEl.classList.remove('nl-printing');
    canvasEl.classList.add('nl-editing');
    ZOOM = prevZoom; applyZoom();
    canvasEl.querySelectorAll('.nl-page').forEach(function (p) { p.classList.toggle('focused', Number(p.dataset.i) === PAGE_I); });
  }
}

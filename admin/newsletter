<style>
:root {
  --bg: #fff9f1; --surface: #ffffff; --surface-soft: #fff6ea; --border: rgba(121,62,17,0.14);
  --text: #2c1b10; --muted: #6a5141; --saffron: #b55a18; --saffron-dark: #8d3e0d; --maroon: #7f2e16;
  --green: #2e7d4f; --green-bg: #e8f5ec; --red: #b3382c; --red-bg: #fbe9e7;
  --radius: 22px; --shadow: 0 18px 45px rgba(93,43,14,0.10);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Arial, Helvetica, sans-serif; background: radial-gradient(circle at top left, rgba(217,138,30,0.12), transparent 22%), radial-gradient(circle at top right, rgba(127,46,22,0.05), transparent 20%), var(--bg); color: var(--text); min-height: 100vh; }
.container { width: min(calc(100% - 32px), 1500px); margin: 0 auto; }
.site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,249,241,0.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
.nav { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 92px; padding: 12px 0; }
.site-header a.brand, .site-header a.brand:link, .site-header a.brand:visited { text-decoration: none; color: inherit; }
.brand { display: flex; align-items: center; gap: 16px; min-width: 0; }
.brand-logo-wrap { background: #fff; border: 1px solid var(--border); border-radius: 18px; padding: 8px; box-shadow: var(--shadow); flex-shrink: 0; }
.brand-logo { width: 88px; height: auto; border-radius: 12px; object-fit: contain; }
.brand-text h1 { margin: 0; font-size: 1.2rem; line-height: 1.15; color: var(--maroon); }
.site-header nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 18px; margin: 0; padding: 0; align-items: center; justify-content: flex-end; }
.site-header nav a, .site-header nav a:link, .site-header nav a:visited { font-weight: 700; color: var(--text); font-size: 0.96rem; text-decoration: none; }
.site-header nav a:hover { color: var(--saffron-dark); }
.menu-toggle { display: none; border: 0; background: transparent; padding: 6px 0; cursor: pointer; color: #2c1b10; align-self: flex-end; }
.menu-toggle .bar { display: block; width: 26px; height: 2px; margin: 5px 0; background: currentColor; }
@media (max-width: 768px) {
  .nav { flex-direction: column; align-items: stretch; gap: 8px; } .menu-toggle { display: inline-block; }
  .site-header nav { display: none; width: 100%; background: rgba(255,249,241,0.95); padding: 10px 0; }
  .site-header nav.is-open { display: block; } .site-header nav ul { flex-direction: column; gap: 14px; }
}
.page-hero { padding: 28px 0 22px; background: linear-gradient(135deg, var(--maroon) 0%, #4e1a09 100%); color: #fff; }
.page-hero h1 { font-family: Georgia, "Times New Roman", serif; font-size: 1.9rem; color: #fff; margin-bottom: 6px; }
.page-hero p { color: #ffffff; opacity: 0.9; font-size: 0.92rem; max-width: 620px; }
.back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 700; color: rgba(255,255,255,0.85); text-decoration: none; margin-bottom: 14px; }
.back-link:hover { color: #fff; text-decoration: underline; }

.tab-nav { background: var(--surface); border-bottom: 1px solid var(--border); }
.tab-nav ul { list-style: none; display: flex; gap: 4px; padding: 10px 0; flex-wrap: wrap; }
.tab-nav button { display: inline-block; padding: 8px 16px; border-radius: 999px; font-size: 0.86rem; font-weight: 700; color: var(--muted); background: none; border: none; cursor: pointer; transition: background 0.15s, color 0.15s; font-family: inherit; }
.tab-nav button.active { background: var(--surface-soft); color: var(--saffron-dark); }
.tab-nav button:not(.active):hover { background: var(--surface-soft); }
.tab-panel { display: none; padding: 24px 0 60px; }
.tab-panel.active { display: block; }

#global-loading-overlay { position: fixed; inset: 0; background: rgba(44,27,16,0.15); backdrop-filter: blur(1px); z-index: 999; display: none; align-items: center; justify-content: center; }
#global-loading-overlay.visible { display: flex; }
#global-loading-overlay .spinner { width: 44px; height: 44px; border: 4px solid rgba(255,255,255,0.5); border-top-color: var(--saffron-dark); border-radius: 50%; animation: gl-spin 0.7s linear infinite; }
@keyframes gl-spin { to { transform: rotate(360deg); } }

.btn-primary { font-family: Arial, Helvetica, sans-serif; font-size: 0.88rem; font-weight: 700; color: #fff; background: linear-gradient(135deg, var(--saffron-dark), var(--maroon)); border: none; border-radius: 10px; padding: 10px 16px; cursor: pointer; }
.btn-primary:disabled { opacity: 0.5; cursor: default; }
.btn-secondary { font-family: Arial, Helvetica, sans-serif; font-size: 0.86rem; font-weight: 700; color: var(--text); background: #fff; border: 1.5px solid var(--border); border-radius: 10px; padding: 9px 14px; cursor: pointer; }
.btn-secondary:disabled { opacity: 0.5; cursor: default; }
.btn-danger { font-family: inherit; font-size: 0.84rem; font-weight: 700; color: var(--red); background: #fff; border: 1.5px solid rgba(179,56,44,0.3); border-radius: 10px; padding: 9px 14px; cursor: pointer; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 26px; box-shadow: var(--shadow); margin-bottom: 20px; }
.card h2 { font-family: Georgia, "Times New Roman", serif; font-size: 1.15rem; color: var(--maroon); margin-bottom: 4px; }
.card-sub { font-size: 0.82rem; color: var(--muted); }
.empty-state { text-align: center; padding: 60px 20px; color: var(--muted); }
.result-box { padding: 12px 16px; border-radius: 12px; font-size: 0.86rem; background: var(--surface-soft); }
.result-box.success { background: var(--green-bg); color: var(--green); border: 1px solid rgba(46,125,79,0.25); }
.result-box.error { background: var(--red-bg); color: var(--red); border: 1px solid rgba(179,56,44,0.25); }
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.field label { font-size: 0.78rem; font-weight: 700; color: var(--muted); }
.field input[type="text"], .field input[type="email"], .field input[type="number"], .field select, .field textarea {
  font-family: Arial, Helvetica, sans-serif; font-size: 0.88rem; padding: 9px 12px; border: 1.5px solid var(--border); border-radius: 10px; background: #fff; color: var(--text); width: 100%; }
.field textarea { resize: vertical; min-height: 56px; }
.modal-overlay { position: fixed; inset: 0; background: rgba(44,27,16,0.5); z-index: 100; display: flex; align-items: flex-start; justify-content: center; padding: 40px 16px; overflow-y: auto; }
.modal-panel { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); width: 100%; }
.modal-header { display: flex; align-items: center; justify-content: space-between; padding: 22px 26px; border-bottom: 1px solid var(--border); }
.modal-header h2 { font-family: Georgia, "Times New Roman", serif; font-size: 1.15rem; color: var(--maroon); }
.modal-close { background: none; border: none; font-size: 1.4rem; color: var(--muted); cursor: pointer; line-height: 1; }
.modal-body { padding: 22px 26px; }
.modal-footer { display: flex; justify-content: flex-end; gap: 10px; padding: 18px 26px; border-top: 1px solid var(--border); flex-wrap: wrap; }
#gate { padding: 60px 16px; display: flex; justify-content: center; }
.gate-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 2.5rem 2rem; max-width: 420px; width: 100%; text-align: center; box-shadow: var(--shadow); }
.gate-card h3 { font-family: Georgia, serif; font-size: 1.3rem; color: var(--maroon); margin-bottom: .5rem; }
.gate-card p { color: var(--muted); font-size: .88rem; line-height: 1.6; }
.gate-card a { color: var(--saffron-dark); }
</style>
<style>
/* ── Library ─────────────────────────────────────────────────────── */
.nl-lib-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; }
.nl-lib-card { background: var(--surface); border: 1.5px solid var(--border); border-radius: 16px; overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column; }
.nl-lib-cover { height: 132px; background: linear-gradient(135deg, var(--maroon), #4e1a09); color: #fff; padding: 16px; display: flex; flex-direction: column; justify-content: flex-end; position: relative; background-size: cover; background-position: center; }
.nl-lib-cover::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.05), rgba(0,0,0,0.55)); }
.nl-lib-cover span { position: relative; z-index: 1; font-family: Georgia, serif; font-size: 1rem; line-height: 1.25; text-shadow: 0 1px 4px rgba(0,0,0,0.5); }
.nl-lib-meta { padding: 12px 14px; font-size: 0.78rem; color: var(--muted); flex: 1; }
.nl-lib-actions { display: flex; gap: 6px; padding: 0 14px 14px; flex-wrap: wrap; }
.nl-lib-actions button { font-family: inherit; font-size: 0.78rem; font-weight: 700; padding: 6px 12px; border-radius: 8px; border: 1.5px solid var(--border); background: #fff; cursor: pointer; }
.nl-lib-actions button.primary { background: var(--saffron-dark); color: #fff; border-color: var(--saffron-dark); }
.nl-badge { display: inline-block; font-size: 0.66rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; padding: 2px 8px; border-radius: 999px; }
.nl-badge.draft { background: var(--surface-soft); color: var(--saffron-dark); }
.nl-badge.sent { background: var(--green-bg); color: var(--green); }

/* ── Editor shell ────────────────────────────────────────────────── */
.nl-shell { display: grid; grid-template-columns: 138px minmax(0,1fr) 306px; gap: 16px; align-items: start; }
@media (max-width: 1240px) { .nl-shell { grid-template-columns: 1fr; } .nl-rail, .nl-side { position: static !important; max-height: none !important; } }

.nl-rail { position: sticky; top: 104px; max-height: calc(100vh - 130px); overflow-y: auto; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 10px; }
.nl-rail h4 { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 8px; }
.nl-thumb { border: 2px solid var(--border); border-radius: 9px; background: #fff; margin-bottom: 9px; cursor: pointer; overflow: hidden; position: relative; }
.nl-thumb.active { border-color: var(--saffron-dark); box-shadow: 0 0 0 3px rgba(141,62,13,0.12); }
.nl-thumb .sk { height: 128px; padding: 8px; display: flex; flex-direction: column; gap: 4px; }
.nl-thumb .sk i { display: block; background: rgba(121,62,17,0.16); border-radius: 2px; height: 5px; }
.nl-thumb .sk i.t { height: 11px; background: rgba(121,62,17,0.4); }
.nl-thumb .sk i.img { flex: 1; background: rgba(181,90,24,0.22); border-radius: 4px; height: auto; min-height: 26px; }
.nl-thumb .sk .row { display: flex; gap: 4px; flex: 1; }
.nl-thumb .sk .row > div { flex: 1; display: flex; flex-direction: column; gap: 4px; }
.nl-thumb .cap { font-size: 0.66rem; font-weight: 700; color: var(--muted); padding: 4px 6px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; }
.nl-rail-add { width: 100%; font-family: inherit; font-size: 0.78rem; font-weight: 700; padding: 8px; border-radius: 9px; border: 1.5px dashed var(--border); background: var(--surface-soft); color: var(--saffron-dark); cursor: pointer; }

.nl-stage { min-width: 0; }
.nl-toolbar { position: sticky; top: 96px; z-index: 30; display: flex; flex-wrap: wrap; gap: 4px; align-items: center; padding: 8px; border: 1.5px solid var(--border); border-radius: 12px; background: var(--surface-soft); margin-bottom: 16px; box-shadow: 0 4px 14px rgba(93,43,14,0.06); }
.nl-toolbar button { font-family: inherit; font-size: 0.8rem; padding: 5px 10px; border: 1px solid var(--border); background: #fff; border-radius: 7px; cursor: pointer; color: var(--text); line-height: 1.1; }
.nl-toolbar button:hover { border-color: var(--saffron); }
.nl-toolbar select { font-family: inherit; font-size: 0.78rem; padding: 5px 6px; border: 1px solid var(--border); border-radius: 7px; background: #fff; }
.nl-sep { width: 1px; height: 18px; background: var(--border); margin: 0 3px; }
.nl-color { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 28px; border: 1px solid var(--border); border-radius: 7px; background: #fff; cursor: pointer; font-size: 0.82rem; font-weight: 700; }
.nl-color input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }

.nl-canvas { display: flex; flex-direction: column; align-items: center; gap: 26px; padding-bottom: 20px; }
.nl-page-wrap { position: relative; }
.nl-page-num { position: absolute; left: -30px; top: 0; font-size: 0.72rem; font-weight: 800; color: var(--muted); }
.nl-page-wrap { scroll-margin-top: 150px; }
.nl-page {
  width: 816px; height: 1056px; background: #fff; position: relative; overflow: hidden;
  box-shadow: 0 12px 34px rgba(93,43,14,0.18); transform-origin: top left;
  color: #241a13; font-family: var(--bf); line-height: 1.55;
}
.nl-page.focused { outline: 3px solid rgba(181,90,24,0.45); outline-offset: 2px; }

/* Themes */
.nl-t-saffron { --a: #b55a18; --d: #7f2e16; --soft: #fdf1e3; --ink: #241a13; --hf: Georgia, "Times New Roman", serif; --bf: Arial, Helvetica, sans-serif; }
.nl-t-indigo  { --a: #4a4a9c; --d: #262657; --soft: #eeeef8; --ink: #1d1d2b; --hf: Georgia, "Times New Roman", serif; --bf: Arial, Helvetica, sans-serif; }
.nl-t-forest  { --a: #2e7d4f; --d: #1b4b30; --soft: #eaf5ee; --ink: #16241c; --hf: Georgia, "Times New Roman", serif; --bf: Arial, Helvetica, sans-serif; }
.nl-t-slate   { --a: #4b5563; --d: #1f2937; --soft: #f1f3f5; --ink: #1f2530; --hf: "Helvetica Neue", Arial, sans-serif; --bf: Arial, Helvetica, sans-serif; }

.nl-pad { padding: 62px 66px; }
.nl-page h1, .nl-page h2, .nl-page h3 { font-family: var(--hf); color: var(--d); line-height: 1.18; }
.nl-page a { color: var(--a); }
.nl-page ul, .nl-page ol { padding-left: 22px; margin: 8px 0; }
.nl-page p { margin: 0 0 10px; }

[data-slot] { outline: none; }
.nl-editing [data-slot]:hover { background: rgba(181,90,24,0.06); border-radius: 4px; }
.nl-editing [data-slot]:focus { background: rgba(181,90,24,0.09); box-shadow: 0 0 0 2px rgba(181,90,24,0.25); border-radius: 4px; }

/* Image slots */
.nl-imgslot { position: relative; background: var(--soft); overflow: hidden; display: flex; align-items: center; justify-content: center; }
.nl-imgslot img { width: 100%; height: 100%; object-fit: cover; display: block; }
.nl-imgph { font-size: 0.82rem; font-weight: 700; color: var(--a); text-align: center; padding: 10px; font-family: Arial, Helvetica, sans-serif; }
.nl-editing .nl-imgslot { cursor: pointer; }
.nl-editing .nl-imgslot:hover { box-shadow: inset 0 0 0 3px var(--a); }
.nl-printing .nl-imgph { display: none; }

/* Cover */
.nl-cover { height: 1056px; display: flex; flex-direction: column; }
.nl-cover-top { height: 560px; position: relative; }
.nl-cover-top .nl-imgslot { position: absolute; inset: 0; }
.nl-cover-scrim { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.05) 45%, rgba(0,0,0,0.42) 100%); }
.nl-cover-badge { position: absolute; top: 40px; left: 66px; z-index: 2; background: var(--d); color: #fff; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; padding: 9px 18px; border-radius: 999px; font-family: Arial, Helvetica, sans-serif; }
.nl-cover-bottom { flex: 1; padding: 46px 66px 56px; display: flex; flex-direction: column; }
.nl-cover-rule { height: 7px; background: linear-gradient(90deg, var(--a), var(--d)); }
.nl-cover-bottom h1 { font-size: 3.1rem; margin-bottom: 16px; }
.nl-cover-sub { font-size: 1.12rem; color: #4b3a2d; line-height: 1.5; max-width: 600px; }
.nl-cover-foot { margin-top: auto; display: flex; justify-content: space-between; align-items: flex-end; font-size: 0.92rem; color: var(--a); font-weight: 700; gap: 20px; }

/* Section header used on inner pages */
.nl-eyebrow { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--a); margin-bottom: 10px; font-family: Arial, Helvetica, sans-serif; }
.nl-h { font-size: 2rem; margin-bottom: 8px; }
.nl-underline { width: 74px; height: 4px; background: var(--a); border-radius: 2px; margin-bottom: 24px; }
.nl-text { font-size: 1rem; color: #3a2c22; }

/* Structural regions. A page is a flex column: the heading takes what it needs
   and the body region gets the rest, so a column or band actually fills the
   sheet instead of collapsing to the height of its text. */
.nl-pad.nl-flex { display: flex; flex-direction: column; }
.nl-cols { display: flex; gap: 30px; flex: 1; align-items: stretch; min-height: 0; }
.nl-colcell { display: flex; flex-direction: column; min-width: 0; }
.nl-colcell.ruled { border-left: 2px solid var(--soft); padding-left: 26px; }
.nl-rows { display: flex; flex-direction: column; gap: 22px; flex: 1; min-height: 0; }
.nl-rowcell { display: flex; flex-direction: column; min-width: 0; }
.nl-rowcell + .nl-rowcell { border-top: 2px solid var(--soft); padding-top: 20px; }
.nl-subh { font-size: 1.3rem; margin-bottom: 6px; }
.nl-flow { column-gap: 34px; font-size: 1rem; color: #3a2c22; flex: 1; }
.nl-flow p:first-child { margin-top: 0; }

/* Layout: image beside text */
.nl-split { display: flex; gap: 30px; align-items: flex-start; flex: 1; }
.nl-split.rev { flex-direction: row-reverse; }
.nl-split .nl-imgslot { width: 316px; height: 420px; border-radius: 10px; flex-shrink: 0; }
.nl-split .nl-splitbody { flex: 1; min-width: 0; }

/* Layout: banner + full page image */
.nl-banner .nl-imgslot { width: 100%; height: 340px; }
.nl-full { position: absolute; inset: 0; }
.nl-full > .nl-imgslot { position: absolute; inset: 0; }
.nl-full-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 44px 66px; color: #fff;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.66) 100%); font-family: var(--hf); font-size: 1.5rem; line-height: 1.35; }

/* Layout: photo grid */
.nl-grid { display: grid; gap: 20px; flex: 1; min-height: 0; }
.nl-grid-cell { display: flex; flex-direction: column; min-height: 0; }
.nl-grid-cell .nl-imgslot { width: 100%; flex: 1; min-height: 120px; border-radius: 10px; }

/* Layout: stacked cards */
.nl-hl { display: flex; flex-direction: column; gap: 18px; }
.nl-hl-card { border: 2px solid var(--soft); border-left: 7px solid var(--a); border-radius: 10px; padding: 20px 24px; background: #fff; }
.nl-hl-card h3 { font-size: 1.24rem; margin-bottom: 6px; }
.nl-hl-card .nl-text { font-size: 0.96rem; }

.nl-gal-cap { font-size: 0.86rem; color: #5d4b3d; margin-top: 8px; text-align: center; font-style: italic; }

/* Layout: quote */
.nl-quote-page { display: flex; flex-direction: column; justify-content: center; height: 1056px; }
.nl-quote { font-family: var(--hf); font-size: 2.05rem; line-height: 1.42; color: var(--d); }
.nl-quote-mark { font-family: Georgia, serif; font-size: 6rem; color: var(--a); line-height: 0.6; margin-bottom: 6px; }
.nl-quote-by { margin-top: 26px; font-size: 1rem; font-weight: 700; color: var(--a); }
.nl-quote-role { font-size: 0.9rem; color: #6a5141; }

/* Layout: back page */
.nl-back { height: 1056px; display: flex; flex-direction: column; }
.nl-back-body { flex: 1; }
.nl-back-panel { background: var(--soft); border-radius: 14px; padding: 28px 30px; margin-top: 22px; }
.nl-back-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; font-size: 0.95rem; }
.nl-back-grid h3 { font-size: 1rem; margin-bottom: 4px; }
.nl-footer-bar { background: var(--d); color: #fff; padding: 22px 66px; font-size: 0.86rem; display: flex; justify-content: space-between; gap: 20px; }
.nl-footer-bar * { color: #fff !important; }

/* Sidebar */
.nl-side { position: sticky; top: 104px; max-height: calc(100vh - 130px); overflow-y: auto; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 18px; }
.nl-side h4 { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin: 16px 0 8px; }
.nl-side h4:first-child { margin-top: 0; }
.nl-theme-row { display: flex; gap: 8px; flex-wrap: wrap; }
.nl-theme-chip { width: 52px; height: 34px; border-radius: 8px; border: 2px solid var(--border); cursor: pointer; overflow: hidden; padding: 0; }
.nl-theme-chip.active { border-color: var(--text); box-shadow: 0 0 0 2px rgba(44,27,16,0.15); }
.nl-lay-list { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }

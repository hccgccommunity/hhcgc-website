function loadPartial(id, url) {
  var target = document.getElementById(id);
  if (!target) return;
  fetch(url).then(function (r) { return r.text(); }).then(function (html) {
    target.innerHTML = html;
    if (id === 'site-header') fixHeaderLinksForSubfolder(target);
  }).catch(function () {});
}
function fixHeaderLinksForSubfolder(headerEl) {
  var logo = headerEl.querySelector('.brand-logo');
  if (logo && logo.getAttribute('src') && !logo.getAttribute('src').startsWith('/') && !logo.getAttribute('src').startsWith('http')) {
    logo.setAttribute('src', '/' + logo.getAttribute('src'));
  }
  headerEl.querySelectorAll('a[href]').forEach(function (link) {
    var href = link.getAttribute('href');
    if (!href || href.startsWith('http') || href.startsWith('/') || href.startsWith('#')) return;
    link.setAttribute('href', '/' + href);
  });
}
loadPartial('site-header', '/header.html');
loadPartial('site-footer', '/footer.html');
if ('serviceWorker' in navigator) navigator.serviceWorker.register('/service-worker.js').catch(function () {});
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script>
/* ═══════════════════════════════════════════════════════════════════
   HCCGC Newsletter builder
   Documents live in Firestore ("newsletters"), so creating, editing and
   downloading a PDF work with no backend at all. Only *sending* calls the
   API, and only /newsletter/send + /newsletter/history are new endpoints —
   the audience filters reuse /blast/segment-options and /blast/reach, which
   is what keeps one unsubscribe list behind both this and Email Blast.
   ═══════════════════════════════════════════════════════════════════ */

const API_BASE = 'https://facility-rental-api-217911937447.us-central1.run.app';

let __glPending = 0, __glTimer = null;
function __glStart() {
  __glPending++;
  if (__glPending === 1) __glTimer = setTimeout(function () {
    var el = document.getElementById('global-loading-overlay'); if (el) el.classList.add('visible');
  }, 150);
}
function __glEnd() {
  __glPending = Math.max(0, __glPending - 1);
  if (__glPending === 0) { clearTimeout(__glTimer); var el = document.getElementById('global-loading-overlay'); if (el) el.classList.remove('visible'); }
}
async function authedFetch(url, options) {
  options = options || {};
  options.headers = Object.assign({}, options.headers, { 'Authorization': 'Bearer ' + await window.__hccgcFirebaseUser.getIdToken() });
  __glStart();
  try { return await fetch(url, options); } finally { __glEnd(); }
}
function escHtml(s) {
  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function fmtDate(v) {
  if (!v) return '';
  var d = v.toDate ? v.toDate() : new Date(v);
  if (isNaN(d)) return '';
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
function monthYear() {
  return new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
}

/* ── Themes ──────────────────────────────────────────────────────── */
const THEMES = [
  { key: 'saffron', name: 'Saffron', a: '#b55a18', d: '#7f2e16' },
  { key: 'indigo',  name: 'Indigo',  a: '#4a4a9c', d: '#262657' },
  { key: 'forest',  name: 'Forest',  a: '#2e7d4f', d: '#1b4b30' },
  { key: 'slate',   name: 'Slate',   a: '#4b5563', d: '#1f2937' }
];

/* ── Layouts ─────────────────────────────────────────────────────────
   A layout is a *structure*, not a subject: how the sheet is divided, and
   nothing about what goes in it. Columns split the page vertically, rows
   split it horizontally, and the image layouts do both. Every one is a pure
   function of the page's slot map, so switching layouts keeps whatever the
   new structure has room for and leaves the rest in the model — switch back
   and the text is still there. Nothing is destroyed by trying a layout.     */
const LAYOUTS = [
  { key: 'col1',     name: '1 column',        group: 'Columns',    cols: [1] },
  { key: 'col2',     name: '2 columns',       group: 'Columns',    cols: [1, 1] },
  { key: 'col3',     name: '3 columns',       group: 'Columns',    cols: [1, 1, 1] },
  { key: 'colNW',    name: 'Narrow + wide',   group: 'Columns',    cols: [1, 2] },
  { key: 'colWN',    name: 'Wide + narrow',   group: 'Columns',    cols: [2, 1] },
  { key: 'flow2',    name: 'Text flows, 2 col', group: 'Columns',  flow: 2 },
  { key: 'flow3',    name: 'Text flows, 3 col', group: 'Columns',  flow: 3 },

  { key: 'row2',     name: '2 bands',         group: 'Horizontal', rows: [1, 1] },
  { key: 'row3',     name: '3 bands',         group: 'Horizontal', rows: [1, 1, 1] },
  { key: 'rowWide',  name: 'Tall + short',    group: 'Horizontal', rows: [2, 1] },
  { key: 'rowCards', name: 'Stacked cards',   group: 'Horizontal', cards: 3 },

  { key: 'imgTop',   name: 'Image across top', group: 'Image',     img: 'top' },
  { key: 'imgLeft',  name: 'Image left',       group: 'Image',     img: 'left' },
  { key: 'imgRight', name: 'Image right',      group: 'Image',     img: 'right' },
  { key: 'imgFull',  name: 'Full-page image',  group: 'Image',     img: 'full' },
  { key: 'grid4',    name: '2 × 2 photos',     group: 'Image',     grid: [2, 2] },
  { key: 'grid6',    name: '3 × 2 photos',     group: 'Image',     grid: [3, 2] },

  { key: 'cover',    name: 'Cover',           group: 'Special' },
  { key: 'quote',    name: 'Pull quote',      group: 'Special' },
  { key: 'back',     name: 'Back page',       group: 'Special' }
];
const LAYOUT_GROUPS = ['Columns', 'Horizontal', 'Image', 'Special'];

/* The first cut of this app named layouts after what they were *for*
   ("Highlights", "Photo grid"). Documents saved then still open. */
const LEGACY_LAYOUTS = {
  single: 'col1', 'two-col': 'flow2', 'image-left': 'imgLeft',
  banner: 'imgTop', highlights: 'rowCards', gallery: 'grid4'
};
function layoutOf(key) {
  var k = LEGACY_LAYOUTS[key] || key;
  return LAYOUTS.find(function (l) { return l.key === k; }) || LAYOUTS[0];
}
function migratePages(pages) {
  (pages || []).forEach(function (p) {
    p.slots = p.slots || {};
    p.opts = p.opts || {};
    if (LEGACY_LAYOUTS[p.layout]) p.layout = LEGACY_LAYOUTS[p.layout];
  });
  return pages;
}

function imgSlot(page, name, extraClass) {
  var url = page.slots[name] || '';
  var inner = url
    ? '<img src="' + escHtml(url) + '" alt="">'
    : '<span class="nl-imgph">Click to add<br>a picture</span>';
  return '<div class="nl-imgslot ' + (extraClass || '') + '" data-imgslot="' + name + '">' + inner + '</div>';
}
function ed(page, name, fallback, tag, cls, style) {
  tag = tag || 'div';
  var html = page.slots[name];
  if (html === undefined || html === null || html === '') html = fallback;
  return '<' + tag + (cls ? ' class="' + cls + '"' : '') + (style ? ' style="' + style + '"' : '') +
    ' data-slot="' + name + '" contenteditable="true">' + html + '</' + tag + '>';
}

/* The heading is a property of the page, not of the layout — any structural
   layout can carry one or go straight into the content. */
function headBlock(page) {
  if (page.opts && page.opts.head === false) return '';
  return ed(page, 'eyebrow', 'In this issue', 'div', 'nl-eyebrow') +
    ed(page, 'title', 'Page heading', 'h2', 'nl-h') +
    '<div class="nl-underline"></div>';
}

function bodyFor(L, page) {
  if (L.cols) {
    return '<div class="nl-cols">' + L.cols.map(function (w, i) {
      return '<div class="nl-colcell' + (i && L.cols.length > 1 ? ' ruled' : '') + '" style="flex:' + w + ';">' +
        ed(page, 'c' + (i + 1), '<p>Click here and type.</p>', 'div', 'nl-text') +
      '</div>';
    }).join('') + '</div>';
  }
  if (L.flow) {
    return ed(page, 'body',
      '<p>Text poured into this layout flows from one column into the next by itself, so a long write-up fills the page evenly without you balancing it by hand.</p>' +
      '<p>Keep paragraphs short — a newsletter is skimmed more often than it is read.</p>',
      'div', 'nl-flow', 'column-count:' + L.flow + ';');
  }
  if (L.rows) {
    return '<div class="nl-rows">' + L.rows.map(function (w, i) {
      return '<div class="nl-rowcell" style="flex:' + w + ';">' +
        ed(page, 'r' + (i + 1) + 't', 'Section ' + (i + 1), 'h3', 'nl-subh') +
        ed(page, 'r' + (i + 1) + 'b', '<p>Click here and type.</p>', 'div', 'nl-text') +
      '</div>';
    }).join('') + '</div>';
  }
  if (L.cards) {
    var cards = [];
    for (var n = 1; n <= L.cards; n++) {
      cards.push('<div class="nl-hl-card">' +
        ed(page, 'h' + n + 'title', 'Card ' + n, 'h3') +
        ed(page, 'h' + n + 'body', '<p>One or two lines.</p>', 'div', 'nl-text') +
      '</div>');
    }
    return '<div class="nl-hl">' + cards.join('') + '</div>';
  }
  if (L.grid) {
    var cols = L.grid[0], rows = L.grid[1], cells = [];
    for (var i = 1; i <= cols * rows; i++) {
      cells.push('<div class="nl-grid-cell">' + imgSlot(page, 'image' + i) +
        ed(page, 'cap' + i, 'Caption', 'div', 'nl-gal-cap') + '</div>');
    }
    return '<div class="nl-grid" style="grid-template-columns:repeat(' + cols + ',1fr);grid-template-rows:repeat(' + rows + ',1fr);">' +
      cells.join('') + '</div>';
  }
  if (L.img === 'left' || L.img === 'right') {
    return '<div class="nl-split' + (L.img === 'right' ? ' rev' : '') + '">' + imgSlot(page, 'image') +
      '<div class="nl-splitbody">' + ed(page, 'c1', '<p>Click here and type.</p>', 'div', 'nl-text') + '</div>' +
    '</div>';
  }
  return ed(page, 'c1', '<p>Click here and type.</p>', 'div', 'nl-text');
}

function renderPage(page) {
  page.slots = page.slots || {};
  page.opts = page.opts || {};
  var L = layoutOf(page.layout);

  if (L.key === 'cover') {
    return '<div class="nl-cover">' +
      '<div class="nl-cover-top">' + imgSlot(page, 'image') +
        (page.slots.image ? '<div class="nl-cover-scrim"></div>' : '') +
        ed(page, 'kicker', 'HCCGC &middot; Newsletter', 'div', 'nl-cover-badge') +
      '</div>' +
      '<div class="nl-cover-rule"></div>' +
      '<div class="nl-cover-bottom">' +
        ed(page, 'title', 'A season of coming together', 'h1') +
        ed(page, 'subtitle', 'News, events and gratitude from the Hindu Community Center of Greater Cincinnati.', 'div', 'nl-cover-sub') +
        '<div class="nl-cover-foot">' +
          ed(page, 'date', monthYear(), 'div') +
          ed(page, 'edition', 'hccgc.org', 'div') +
        '</div>' +
      '</div>' +
    '</div>';
  }
  if (L.key === 'quote') {
    return '<div class="nl-pad nl-quote-page">' +
      '<div class="nl-quote-mark">&ldquo;</div>' +
      ed(page, 'quote', 'A temple is not a building. It is what a community does together, week after week.', 'div', 'nl-quote') +
      ed(page, 'by', '&mdash; Name Surname', 'div', 'nl-quote-by') +
      ed(page, 'role', 'President, HCCGC', 'div', 'nl-quote-role') +
    '</div>';
  }
  if (L.key === 'back') {
    return '<div class="nl-back">' +
      '<div class="nl-pad nl-back-body">' + headBlock(page) +
        ed(page, 'body', '<p>None of this happens without volunteers and donors. If you would like to help with an event, teach a class, or give, we would love to hear from you.</p>', 'div', 'nl-text') +
        '<div class="nl-back-panel"><div class="nl-back-grid">' +
          '<div>' + ed(page, 'c1t', 'Visit', 'h3') + ed(page, 'c1b', '<p>4920 Klatte Rd,<br>Cincinnati, OH 45244</p>', 'div') + '</div>' +
          '<div>' + ed(page, 'c2t', 'Write', 'h3') + ed(page, 'c2b', '<p>info@hccgc.org</p>', 'div') + '</div>' +
          '<div>' + ed(page, 'c3t', 'Give', 'h3') + ed(page, 'c3b', '<p>hccgc.org/donate-now</p>', 'div') + '</div>' +
          '<div>' + ed(page, 'c4t', 'Rent the hall', 'h3') + ed(page, 'c4b', '<p>hccgc.org/facility-rental</p>', 'div') + '</div>' +
        '</div></div>' +
      '</div>' +
      '<div class="nl-footer-bar">' +
        ed(page, 'footL', 'Hindu Community Center of Greater Cincinnati', 'div') +
        ed(page, 'footR', 'hccgc.org', 'div') +
      '</div>' +
    '</div>';
  }
  if (L.img === 'full') {
    return '<div class="nl-full">' + imgSlot(page, 'image') +
      '<div class="nl-full-cap">' + ed(page, 'caption', 'A photograph that speaks for itself.', 'div') + '</div>' +
    '</div>';
  }
  if (L.img === 'top') {
    return '<div class="nl-banner">' + imgSlot(page, 'image') + '</div>' +
      '<div class="nl-pad nl-flex" style="padding-top:38px;">' + headBlock(page) + bodyFor(L, page) + '</div>';
  }
  return '<div class="nl-pad nl-flex">' + headBlock(page) + bodyFor(L, page) + '</div>';
}

/* Thumbnail schematic, derived from the layout spec rather than hand-drawn —
   a scaled clone of the real page is unreadable at 110px wide. */
function thumbSkeleton(key) {
  var L = layoutOf(key);
  var bars = '<i></i><i></i><i></i>';
  var t = '<i class="t"></i>';
  if (L.key === 'cover') return '<i class="img"></i>' + t + '<i></i><i></i>';
  if (L.key === 'quote') return '<i></i>' + t + t + '<i></i><i></i>';
  if (L.key === 'back')  return t + bars + '<i class="img" style="min-height:22px;"></i>';
  if (L.cols) {
    return t + '<div class="row">' + L.cols.map(function (w) {
      return '<div style="flex:' + w + ';">' + bars + '</div>';
    }).join('') + '</div>';
  }
  if (L.flow) {
    var c = [];
    for (var i = 0; i < L.flow; i++) c.push('<div>' + bars + '</div>');
    return t + '<div class="row">' + c.join('') + '</div>';
  }
  if (L.rows) {
    return t + L.rows.map(function (w) {
      return '<div style="flex:' + w + ';display:flex;flex-direction:column;gap:3px;"><i class="t" style="height:7px;"></i><i></i><i></i></div>';
    }).join('');
  }
  if (L.cards) return t + '<i class="img" style="min-height:16px;"></i><i class="img" style="min-height:16px;"></i><i class="img" style="min-height:16px;"></i>';
  if (L.grid) {
    var rowsHtml = '';
    for (var r = 0; r < L.grid[1]; r++) {
      var cells = '';
      for (var cI = 0; cI < L.grid[0]; cI++) cells += '<div><i class="img"></i></div>';
      rowsHtml += '<div class="row">' + cells + '</div>';
    }
    return t + rowsHtml;
  }
  if (L.img === 'full') return '<i class="img" style="flex:1;"></i>';
  if (L.img === 'top')  return '<i class="img" style="max-height:32px;flex:0 0 32px;"></i>' + t + bars;
  if (L.img === 'left') return t + '<div class="row"><div><i class="img"></i></div><div>' + bars + '</div></div>';
  if (L.img === 'right') return t + '<div class="row"><div>' + bars + '</div><div><i class="img"></i></div></div>';
  return t + bars + bars;
}

/* ── State ───────────────────────────────────────────────────────── */
var DOC = null;          // { id, title, theme, pages: [ {layout, slots} ] }
var PAGE_I = 0;
var DIRTY = false;
var ZOOM = 'fit';
var IMG_TARGET = null;   // 'slot:<name>' | 'inline'
var IMG_RANGE = null;
var LIB = [];
var SEG_OPTS = { languages: [], events: [], campaigns: [] };
var REACH_TIMER = null;

var canvasEl = document.getElementById('nl-canvas');
var resultBox = document.getElementById('editor-result');

function say(msg, kind) {
  resultBox.style.display = 'block';
  resultBox.className = 'result-box' + (kind ? ' ' + kind : '');
  resultBox.textContent = msg;
  if (kind === 'success') setTimeout(function () { resultBox.style.display = 'none'; }, 4000);
}
function markDirty() { DIRTY = true; }

function blankPage(layout) { return { layout: layout || 'col1', slots: {}, opts: {} }; }

/* Build the starting page list from a count, not from a fixed template — a
   two-page flyer is as ordinary a newsletter as a twelve-page issue. */
function startingPages(count, wantCover, wantBack, innerLayout) {
  count = Math.max(1, Math.min(60, Number(count) || 1));
  var out = [];
  if (wantCover) out.push(blankPage('cover'));
  if (wantBack && count > out.length) out.push(blankPage('back'));
  var inner = count - out.length;
  for (var i = 0; i < inner; i++) out.splice(wantCover ? 1 + i : i, 0, blankPage(innerLayout));
  return out.slice(0, count);
}

/* ── Rendering ───────────────────────────────────────────────────── */
function renderCanvas() {
  if (!DOC) return;
  canvasEl.className = 'nl-canvas nl-editing';
  canvasEl.innerHTML = DOC.pages.map(function (p, i) {
    return '<div class="nl-page-wrap" data-i="' + i + '">' +
      '<div class="nl-page-num">' + (i + 1) + '</div>' +
      '<div class="nl-page nl-t-' + escHtml(DOC.theme) + (i === PAGE_I ? ' focused' : '') + '" data-i="' + i + '">' +
        renderPage(p) +
      '</div>' +
      '<div class="nl-overflow-warn">This page is fuller than one printed sheet &mdash; trim it or move some of it to a new page.</div>' +
    '</div>';
  }).join('');
  applyZoom();
  checkOverflow();
  renderThumbs();
  renderLayoutButtons();
}

function renderThumbs() {
  var wrap = document.getElementById('nl-thumbs');
  wrap.innerHTML = DOC.pages.map(function (p, i) {
    var lay = LAYOUTS.find(function (l) { return l.key === p.layout; });
    return '<div class="nl-thumb' + (i === PAGE_I ? ' active' : '') + '" data-goto="' + i + '">' +
      '<div class="sk">' + thumbSkeleton(p.layout) + '</div>' +
      '<div class="cap"><span>' + (i + 1) + '</span><span>' + escHtml(lay ? lay.name : p.layout) + '</span></div>' +
    '</div>';
  }).join('');
}

function renderLayoutButtons() {
  var page = DOC.pages[PAGE_I] || {};
  var cur = layoutOf(page.layout).key;
  document.getElementById('nl-layouts').innerHTML = LAYOUT_GROUPS.map(function (g) {
    var items = LAYOUTS.filter(function (l) { return l.group === g; });
    if (!items.length) return '';
    return '<div class="nl-lay-group">' + escHtml(g) + '</div>' + items.map(function (l) {
      return '<button class="nl-lay-btn' + (l.key === cur ? ' active' : '') + '" data-setlayout="' + l.key + '">' + escHtml(l.name) + '</button>';
    }).join('');
  }).join('');

  var L = layoutOf(page.layout);
  var wrap = document.getElementById('nl-head-toggle-wrap');
  var canHead = !(L.key === 'cover' || L.key === 'quote' || L.img === 'full');
  wrap.style.display = canHead ? 'flex' : 'none';
  document.getElementById('nl-head-toggle').checked = !(page.opts && page.opts.head === false);
}

function renderThemeChips(containerId, current, attr) {
  document.getElementById(containerId).innerHTML = THEMES.map(function (t) {
    return '<button class="nl-theme-chip' + (t.key === current ? ' active' : '') + '" ' + attr + '="' + t.key + '" title="' + t.name + '" ' +
      'style="background:linear-gradient(135deg,' + t.a + ' 0%,' + t.a + ' 50%,' + t.d + ' 50%,' + t.d + ' 100%);"></button>';
  }).join('');
}

/* Zoom. 'fit' keeps a full 816px page inside whatever the stage happens to
   be, which is what makes the editor usable on a laptop screen. The page is
   scaled, not reflowed, so what you see is the PDF. */
function applyZoom() {
  var stage = canvasEl.parentElement;
  var avail = stage ? stage.clientWidth : 816;
  var z = ZOOM === 'fit' ? Math.min(1, (avail - 8) / 816) : Number(ZOOM);
  if (!isFinite(z) || z <= 0) z = 1;
  canvasEl.querySelectorAll('.nl-page-wrap').forEach(function (w) {
    var pg = w.querySelector('.nl-page');
    pg.style.transform = 'scale(' + z + ')';
    w.style.width = (816 * z) + 'px';
    w.style.height = (1056 * z) + 'px';
  });
}
window.addEventListener('resize', function () { if (DOC) applyZoom(); });

function checkOverflow() {
  canvasEl.querySelectorAll('.nl-page-wrap').forEach(function (w) {
    var pg = w.querySelector('.nl-page');
    w.classList.toggle('over', pg.scrollHeight > 1060);
  });
}

/* ── Model <-> DOM ───────────────────────────────────────────────── */
function syncFromDom() {
  if (!DOC) return;
  canvasEl.querySelectorAll('.nl-page').forEach(function (pg) {
    var i = Number(pg.dataset.i);
    if (!DOC.pages[i]) return;
    pg.querySelectorAll('[data-slot]').forEach(function (el) {
      DOC.pages[i].slots[el.dataset.slot] = el.innerHTML;
    });
  });
}

canvasEl.addEventListener('input', function (e) {
  if (!e.target.closest('[data-slot]')) return;
  markDirty();
  clearTimeout(window.__nlOv);
  window.__nlOv = setTimeout(function () { checkOverflow(); applyZoom(); }, 400);
});
canvasEl.addEventListener('focusin', function (e) {
  var pg = e.target.closest('.nl-page');
  if (!pg) return;
  var i = Number(pg.dataset.i);
  if (i !== PAGE_I) { setActivePage(i); }
});
canvasEl.addEventListener('click', function (e) {
  var slot = e.target.closest('[data-imgslot]');
  if (slot) {
    var pg = slot.closest('.nl-page');
    setActivePage(Number(pg.dataset.i));
    IMG_TARGET = 'slot:' + slot.dataset.imgslot;
    document.getElementById('nl-file-input').click();
    return;
  }
  var pgc = e.target.closest('.nl-page');
  if (pgc) setActivePage(Number(pgc.dataset.i));
});

function setActivePage(i) {
  PAGE_I = i;
  canvasEl.querySelectorAll('.nl-page').forEach(function (p) { p.classList.toggle('focused', Number(p.dataset.i) === i); });
  renderThumbs();
  renderLayoutButtons();
}

document.getElementById('nl-thumbs').addEventListener('click', function (e) {
  var t = e.target.closest('[data-goto]');
  if (!t) return;
  var i = Number(t.dataset.goto);
  setActivePage(i);
  var w = canvasEl.querySelector('.nl-page-wrap[data-i="' + i + '"]');
  if (w) w.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

/* ── Toolbar ─────────────────────────────────────────────────────── */
document.querySelector('.nl-toolbar').addEventListener('mousedown', function (e) {
  if (e.target.closest('button, select, label')) {
    if (!e.target.closest('select, input')) e.preventDefault();
  }
});
document.querySelectorAll('.nl-toolbar [data-cmd]').forEach(function (b) {
  b.addEventListener('click', function () { exec(this.dataset.cmd); });
});
document.querySelectorAll('.nl-toolbar [data-block]').forEach(function (b) {
  b.addEventListener('click', function () { exec('formatBlock', '<' + this.dataset.block + '>'); });
});
function exec(cmd, val) {
  try { document.execCommand('styleWithCSS', false, true); } catch (e) {}
  document.execCommand(cmd, false, val || null);
  markDirty(); checkOverflow(); applyZoom();
}
document.getElementById('tb-size').addEventListener('change', function () {
  if (this.value) exec('fontSize', this.value);
  this.value = '';
});
document.getElementById('tb-color').addEventListener('input', function () { exec('foreColor', this.value); });
document.getElementById('tb-highlight').addEventListener('input', function () { exec('hiliteColor', this.value); });
document.getElementById('tb-link').addEventListener('click', function () {
  var url = window.prompt('Link to:', 'https://hccgc.org/');
  if (url) exec('createLink', url);
});
document.getElementById('tb-zoom').addEventListener('change', function () { ZOOM = this.value; applyZoom(); });
document.getElementById('tb-inline-img').addEventListener('click', function () {
  var sel = window.getSelection();
  IMG_RANGE = (sel && sel.rangeCount && canvasEl.contains(sel.anchorNode)) ? sel.getRangeAt(0).cloneRange() : null;
  IMG_TARGET = 'inline';
  document.getElementById('nl-file-input').click();
});

/* ── Image upload ────────────────────────────────────────────────── */
document.getElementById('nl-file-input').addEventListener('change', async function (e) {
  var file = e.target.files[0];
  this.value = '';
  if (!file) return;
  say('Uploading picture…');
  try {
    var base64 = await new Promise(function (res, rej) {
      var r = new FileReader();
      r.onload = function () { res(String(r.result).split(',')[1]); };
      r.onerror = rej;
      r.readAsDataURL(file);
    });
    var r = await authedFetch(API_BASE + '/pages/image-upload', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ base64: base64, filename: file.name, mimeType: file.type })
    });
    var d = await r.json().catch(function () { return {}; });
    if (!r.ok || !d.imageUrl) { say((d.errors || [d.error] || ['Upload failed.']).join(' '), 'error'); return; }

    if (IMG_TARGET === 'inline') {
      var el = canvasEl.querySelector('.nl-page[data-i="' + PAGE_I + '"]');
      if (IMG_RANGE) { var s = window.getSelection(); s.removeAllRanges(); s.addRange(IMG_RANGE); }
      else if (el) { var f = el.querySelector('[data-slot]'); if (f) f.focus(); }
      document.execCommand('insertHTML', false,
        '<img src="' + escHtml(d.imageUrl) + '" style="max-width:100%;height:auto;border-radius:8px;display:block;margin:14px auto;">');
      markDirty();
    } else if (IMG_TARGET && IMG_TARGET.indexOf('slot:') === 0) {
      var name = IMG_TARGET.slice(5);
      DOC.pages[PAGE_I].slots[name] = d.imageUrl;
      syncFromDom();
      renderCanvas();
      markDirty();
    }
    say('Picture added.', 'success');
    checkOverflow(); applyZoom();
  } catch (err) {
    say('Upload failed: ' + err.message, 'error');
  }
});

/* ── Page operations ─────────────────────────────────────────────── */
document.getElementById('nl-layouts').addEventListener('click', function (e) {
  var b = e.target.closest('[data-setlayout]');
  if (!b || !DOC) return;
  syncFromDom();
  DOC.pages[PAGE_I].layout = b.dataset.setlayout;
  markDirty();
  renderCanvas();
});
document.getElementById('btn-add-page').addEventListener('click', function () { openModal('modal-page'); });
document.getElementById('page-layouts').addEventListener('click', function (e) {
  var b = e.target.closest('[data-addlayout]');
  if (!b) return;
  syncFromDom();
  DOC.pages.splice(PAGE_I + 1, 0, blankPage(b.dataset.addlayout));
  PAGE_I = PAGE_I + 1;
  markDirty();
  closeModal('modal-page');
  renderCanvas();
  var w = canvasEl.querySelector('.nl-page-wrap[data-i="' + PAGE_I + '"]');
  if (w) w.scrollIntoView({ behavior: 'smooth', block: 'start' });
});
document.getElementById('btn-dup-page').addEventListener('click', function () {
  syncFromDom();
  DOC.pages.splice(PAGE_I + 1, 0, JSON.parse(JSON.stringify(DOC.pages[PAGE_I])));
  PAGE_I++; markDirty(); renderCanvas();
});
document.getElementById('btn-del-page').addEventListener('click', function () {
  if (DOC.pages.length === 1) { say('A newsletter needs at least one page.', 'error'); return; }
  if (!window.confirm('Delete page ' + (PAGE_I + 1) + '?')) return;
  syncFromDom();
  DOC.pages.splice(PAGE_I, 1);
  PAGE_I = Math.max(0, PAGE_I - 1);
  markDirty(); renderCanvas();
});
document.getElementById('btn-up-page').addEventListener('click', function () { movePage(-1); });
document.getElementById('btn-down-page').addEventListener('click', function () { movePage(1); });
function movePage(d) {
  var j = PAGE_I + d;
  if (j < 0 || j >= DOC.pages.length) return;
  syncFromDom();
  var p = DOC.pages.splice(PAGE_I, 1)[0];
  DOC.pages.splice(j, 0, p);
  PAGE_I = j; markDirty(); renderCanvas();
}
document.getElementById('nl-themes').addEventListener('click', function (e) {
  var b = e.target.closest('[data-theme]');
  if (!b) return;
  syncFromDom();
  DOC.theme = b.dataset.theme;
  markDirty();
  renderThemeChips('nl-themes', DOC.theme, 'data-theme');
  renderCanvas();
});
document.getElementById('nl-title').addEventListener('input', function () {
  if (DOC) { DOC.title = this.value; markDirty(); }
});
document.getElementById('nl-head-toggle').addEventListener('change', function () {
  if (!DOC) return;
  syncFromDom();
  DOC.pages[PAGE_I].opts = DOC.pages[PAGE_I].opts || {};
  DOC.pages[PAGE_I].opts.head = this.checked;
  markDirty();
  renderCanvas();
});

/* ── Modals ──────────────────────────────────────────────────────── */
function openModal(id) { document.getElementById(id).style.display = 'flex'; }
function closeModal(id) { document.getElementById(id).style.display = 'none'; }
document.addEventListener('click', function (e) {
  var c = e.target.closest('[data-close]');
  if (c) closeModal(c.dataset.close);
});

/* ── Tabs ────────────────────────────────────────────────────────── */
document.querySelectorAll('.tab-btn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.remove('active'); });
    document.querySelectorAll('.tab-panel').forEach(function (p) { p.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
    if (btn.dataset.tab === 'history') loadHistory();
    if (btn.dataset.tab === 'library') loadLibrary();
    if (btn.dataset.tab === 'editor' && DOC) applyZoom();
  });
});
function goTab(name) {
  document.querySelector('.tab-btn[data-tab="' + name + '"]').click();
}

/* ── Library (Firestore) ─────────────────────────────────────────── */
function fb() { return window.__nlFb; }

async function loadLibrary() {
  var el = document.getElementById('lib-list');
  el.innerHTML = '<div class="empty-state">Loading…</div>';
  try {
    var f = fb();
    var snap = await f.getDocs(f.query(f.collection(f.db, 'newsletters'), f.orderBy('updatedAt', 'desc')));
    LIB = [];
    snap.forEach(function (d) { LIB.push(Object.assign({ id: d.id }, d.data())); });
    if (!LIB.length) { el.innerHTML = '<div class="card"><div class="empty-state">Nothing here yet. Hit <strong>+ New newsletter</strong> to make your first one.</div></div>'; return; }
    el.innerHTML = '<div class="nl-lib-grid">' + LIB.map(function (n) {
      var cover = (n.pages && n.pages[0] && n.pages[0].slots && n.pages[0].slots.image) || '';
      var headline = (n.pages && n.pages[0] && n.pages[0].slots && n.pages[0].slots.title) || n.title || 'Untitled';
      return '<div class="nl-lib-card">' +
        '<div class="nl-lib-cover" style="' + (cover ? 'background-image:url(&quot;' + escHtml(cover) + '&quot;);' : '') + '">' +
          '<span>' + escHtml(String(headline).replace(/<[^>]*>/g, '').slice(0, 70)) + '</span></div>' +
        '<div class="nl-lib-meta">' +
          '<div style="font-weight:700;color:var(--text);margin-bottom:4px;">' + escHtml(n.title || 'Untitled') + '</div>' +
          '<span class="nl-badge ' + (n.lastSentAt ? 'sent' : 'draft') + '">' + (n.lastSentAt ? 'Sent' : 'Draft') + '</span>' +
          ' &middot; ' + (n.pages ? n.pages.length : 0) + ' page' + ((n.pages || []).length === 1 ? '' : 's') +
          '<div style="margin-top:6px;">Updated ' + escHtml(fmtDate(n.updatedAt)) + (n.updatedBy ? ' by ' + escHtml(n.updatedBy) : '') + '</div>' +
        '</div>' +
        '<div class="nl-lib-actions">' +
          '<button class="primary" data-open="' + n.id + '">Open</button>' +
          '<button data-copy="' + n.id + '">Duplicate</button>' +
          '<button data-del="' + n.id + '">Delete</button>' +
        '</div>' +
      '</div>';
